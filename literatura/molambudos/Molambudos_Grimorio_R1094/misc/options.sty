\newcommand{\hsp}{\kern 1pt}

% =============================================================================
% TIPOGRAFIA PROFISSIONAL DE ALTA MANCHETA (Master Typographer)
% =============================================================================

% --- Entrelinha de Alta Legibilidade (1.25 para 14pt EB Garamond) ---
\renewcommand{\baselinestretch}{1.25}

% --- Espaçamento entre parágrafos (livre de indentação, respiro visual) ---
\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}

% --- Tracking sutil para legibilidade (menos que 40 = mais profissional) ---
\SetTracking{encoding=*, family=ebgaramond}{25}
\SetTracking{encoding={T1,OT1}, family=rm, shape=sc}{45}

% --- Sentence spacing ---
\frenchspacing

% --- Prevenção Absoluta de Viúvas, Órfãs e Hifenizações em Quebra de Página ---
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=10000

% --- Margens ampliadas para respiro visual ---
\ifdefined\MolambudosPaperWidth
  \usepackage[
      paperheight=\MolambudosPaperHeight,
      paperwidth=\MolambudosPaperWidth,
      top=\MolambudosTopMargin,
      bottom=\MolambudosBottomMargin,
      outer=\MolambudosOuterMargin,
      inner=\MolambudosInnerMargin,
      twoside,
      headsep=6mm,
      footskip=8mm
  ]{geometry}
\else
  \usepackage[
      paperheight=9in,
      paperwidth=9in,
      top=1in,
      bottom=1in,
      outer=1in,
      inner=1in,
      twoside
  ]{geometry}
\fi

% --- Composição Mestra (Justificação Equilibrada & Hifenização Fina) ---
\tolerance=1200           % Equilíbrio ideal entre justificação fluida e ausência de sobreposição
\hbadness=1400            % Elimina alertas desnecessários sem tolerar espaçamento excessivo
\hyphenpenalty=400        % Hifenização equilibrada sem interromper o fluxo de leitura
\exhyphenpenalty=200      % Penalidade controlada para palavras compostas
\doublehyphendemerits=10000 % Proíbe rigorosamente hífens em duas linhas consecutivas
\finalhyphendemerits=5000   % Evita hífen na penúltima linha do parágrafo
\emergencystretch=1.5em   % Esticamento de emergência sutil para eliminar overfull hboxes % prefere linhas mais apertadas a mais soltas

