% =============================================================================
% options_zh.sty — OpenCode Typography System (XeLaTeX + CJK variant)
% Mirrors misc/options.sty for the Simplified Chinese edition (SPEC-935-R356).
% Differences vs options.sty:
%   - fontspec + xeCJK (XeLaTeX) instead of ebgaramond (pdflatex)
%   - microtype removed (no tracking support under XeLaTeX/fontspec)
%   - babel english (neutral language; CJK handled by xeCJK)
% =============================================================================

% --- Idioma (neutro; CJK via xeCJK) ---
\usepackage[english]{babel}

% --- Capitulares Decorativas (Lettrines) — mesmo padrão do template ---
\usepackage{lettrine}
\setcounter{DefaultLines}{3}
\setlength{\DefaultFindent}{2pt}
\setlength{\DefaultNindent}{4pt}
\renewcommand{\DefaultLhang}{0}
\renewcommand{\LettrineTextFont}{\scshape}

\usepackage{graphicx}
\usepackage{xcolor}

% --- Fontes: EB Garamond (latim) + Noto Serif CJK SC (chinês) ---
\usepackage{fontspec}
\setmainfont{EB Garamond}
\setsansfont{Noto Serif CJK SC}
\usepackage{xeCJK}
\setCJKmainfont{Noto Serif CJK SC}
\setCJKsansfont{Noto Serif CJK SC}
\setCJKmonofont{Noto Serif CJK SC}
% Símbolos não-CJK críticos (☑ ↪ ★ ● ☒ ☐) mapeados para comandos seguros
\usepackage{newunicodechar}
\newunicodechar{☑}{\ensuremath{\checkmark}}
\newunicodechar{☐}{\ensuremath{\Box}}
\newunicodechar{☒}{\texttimes}
\newunicodechar{↪}{\ensuremath{\hookrightarrow}}
\newunicodechar{★}{\ensuremath{\bigstar}}
\newunicodechar{●}{\textbullet}
\newunicodechar{○}{\ensuremath{\circ}}
\newunicodechar{→}{$\rightarrow$}
\newunicodechar{←}{$\leftarrow$}
\newunicodechar{◆}{\ensuremath{\blacklozenge}}
\newunicodechar{☆}{\ensuremath{\star}}
\newunicodechar{⟡}{\ensuremath{\blacktriangleright}}

\usepackage{tikz}
\usetikzlibrary{math,positioning,shadows.blur}
\usepackage{url}
\usepackage{pgfornament}
\usepackage{amssymb}
\usepackage[
  colorlinks=true,
  linkcolor=red!75!black,
  citecolor=red!75!black,
  urlcolor=red!75!black
]{hyperref}
\usepackage{booktabs}
\usepackage{enumitem}
% Unnumbered captions must not create a duplicate anchor in the same float.
\usepackage[hypcap=false]{caption}
\usepackage{array}
\usepackage{supertabular}

% Reflowable documentary tables with a local minimum font size.
\newenvironment{moltabletwo}{%
  \begingroup\footnotesize\setlength{\tabcolsep}{2.5pt}%
  \renewcommand{\arraystretch}{1.12}%
  \begin{supertabular}{|p{0.25\textwidth}|p{0.65\textwidth}|}%
}{\end{supertabular}\endgroup}
\newenvironment{moltablethree}{%
  \begingroup\footnotesize\setlength{\tabcolsep}{2.5pt}%
