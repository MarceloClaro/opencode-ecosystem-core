}{\end{supertabular}\endgroup}

\newcommand{\hsp}{\kern 1pt}

% =============================================================================
% TIPOGRAFIA PROFISSIONAL DE ALTA MANCHETA (Master Typographer)
% =============================================================================

% --- Entrelinha de Alta Legibilidade (1.25 para 14pt) ---
\renewcommand{\baselinestretch}{1.25}

% --- Espaçamento entre parágrafos (livre de indentação, respiro visual) ---
\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}

% --- Sentence spacing ---
\frenchspacing

% --- Prevenção Absoluta de Viúvas, Órfãs e Quebras de Página Ruins ---
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=10000

% --- Margens ampliadas para respiro visual ---
\ifdefined\MolambudosPaperWidth
  \usepackage[
      paperheight=\MolambudosPaperHeight,
      paperwidth=\MolambudosPaperWidth,
      top=\MolambudosTopMargin,
      bottom=\MolambudosBottomMargin,
      outer=\MolambudosOuterMargin,
      inner=\MolambudosInnerMargin,
      twoside,
      headsep=6mm,
      footskip=8mm
  ]{geometry}
\else
  \usepackage[
      paperheight=9in,
      paperwidth=9in,
      top=1in,
      bottom=1in,
      outer=1in,
      inner=1in,
      twoside
  ]{geometry}
\fi

% --- Composição Mestra (Justificação Equilibrada) ---
\tolerance=1200
\hbadness=1400
\hyphenpenalty=400
\exhyphenpenalty=200
\doublehyphendemerits=10000
\finalhyphendemerits=5000
\emergencystretch=1.5em

% =============================================================================
% TÍTULOS
% =============================================================================

% --- Table of contents (compactado para caber em 1 página) ---
\usepackage[titles]{tocloft}
\renewcommand{\cftchapfont}{\normalsize\bfseries}
\renewcommand{\cftchappagefont}{\normalfont}
\renewcommand{\cftpartfont}{\normalsize\scshape}
\renewcommand{\cftpartpagefont}{\normalfont}
\renewcommand{\numberline}[1]{}
\setlength{\cftchapnumwidth}{0pt}
\setlength{\cftpartnumwidth}{0pt}
\setlength{\cftbeforechapskip}{0.4em}
\setlength{\cftbeforepartskip}{0.8em}
\setlength{\cftchapindent}{0pt}
\setlength{\cftpartindent}{0pt}

% --- Chapter titles: centered ---
\usepackage[center]{titlesec}
\renewcommand{\thechapter}{\Roman{chapter}}

\titleformat{\chapter}[block]
  {\normalfont\LARGE\centering}
  {\thechapter\\}
  {0pt}
  {}
\titlespacing*{\chapter}{0pt}{0pt}{0.5em}

\makeatletter
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{20pt}
  {\parindent \z@ \centering \normalfont
    \LARGE
    \ifnum\c@chapter>0
    \thechapter \par {#1}\par\nobreak
    \vspace{0.3em}
    \pgfornament[width=4cm]{85}\par
    \vspace{1em}
    \else
      #1\par\nobreak
      \vspace{0.5em}
    \fi
  }}
\makeatother

% --- Section titles ---
\titleformat{\section}
  {\normalfont\large\bfseries\centering}
  {}
  {0pt}
  {}
\titlespacing*{\section}{0pt}{1em}{0.5em}

% --- Subsection titles ---
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {}
  {0pt}
  {}
\titlespacing*{\subsection}{0pt}{0.5em}{0.3em}

