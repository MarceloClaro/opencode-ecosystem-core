    {"id": "R02", "name": "Empilhamento de recursos", "use_when": "três recursos verificáveis", "motion": "cartões entram em sequência e ancoram", "risk": "excesso de texto e ritmo", "qa": "tempo de leitura e hierarquia", "source": "https://github.com/Vincentwei1021/video-shotcraft"},
    {"id": "R03", "name": "Antes e depois", "use_when": "transformação demonstrável", "motion": "divisão ou wipe com mesma escala", "risk": "manipular imagens ou esconder diferença", "qa": "mesmo enquadramento e fonte", "source": "https://github.com/Vincentwei1021/video-shotcraft"},
    {"id": "R04", "name": "Prova por dado", "use_when": "número com unidade e fonte", "motion": "contagem curta e eixo estável", "risk": "escala enganosa e 3D gratuito", "qa": "valor final, unidade e fonte", "source": "https://github.com/Vincentwei1021/video-shotcraft"},
    {"id": "R05", "name": "Fluxo em etapas", "use_when": "processo de 3 a 5 passos", "motion": "linha de tempo com foco sequencial", "risk": "complexidade e texto pequeno", "qa": "cada etapa legível e na ordem", "source": "https://github.com/Vincentwei1021/video-shotcraft"},
    {"id": "R06", "name": "Depoimento em cartão", "use_when": "fala curta e autorizada", "motion": "recorte com moldura e legenda", "risk": "cortar rosto ou inventar citação", "qa": "áudio, legenda e enquadramento", "source": "https://github.com/Vincentwei1021/video-shotcraft"},
