    {"id": "R08", "name": "Comparação lado a lado", "use_when": "duas opções reais", "motion": "split com rótulos fixos", "risk": "comparação injusta", "qa": "mesma métrica, escala e período", "source": "https://github.com/Vincentwei1021/video-shotcraft"},
