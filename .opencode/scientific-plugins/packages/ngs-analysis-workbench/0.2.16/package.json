{
  "name": "ngs-analysis-workbench-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:package-lock": "node scripts/check-package-lock.mjs",
    "postinstall": "npm run check:package-lock",
    "prebuild": "npm run check:package-lock",
    "build": "tsc --noEmit && vite build && vite build --config vite.inline.config.ts",
    "prebuild:storybook": "npm run check:package-lock",
    "build:storybook": "HOME=$PWD/.storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "prestorybook": "npm run check:package-lock",
    "storybook": "HOME=$PWD/.storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --no-open",
    "test:inline": "node --experimental-strip-types --test tests_js/*.test.ts",
    "check:release": "node scripts/check-release-artifacts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@modelcontextprotocol/ext-apps": "1.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "storybook": "10.3.5",
    "typescript": "6.0.2",
    "vite": "8.0.16",
    "vite-plugin-singlefile": "2.3.3"
  }
}
