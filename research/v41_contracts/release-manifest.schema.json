{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-manifest.schema.json",
  "title": "ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "version",
    "created_at",
    "core_reference_commit",
    "artifacts",
    "sbom",
    "tests",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "created_at": {
      "type": "string"
    },
    "core_reference_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "format",
        "spec_version"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "const": "CycloneDX"
        },
        "spec_version": {
          "const": "1.7"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "test_count",
        "schema_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "test_count": {
          "type": "integer",
          "minimum": 0
        },
        "schema_count": {
          "type": "integer",
          "minimum": 1
        },
        "python_versions_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externally_certified",
        "reproducible_build_verified",
        "signed_release_verified"
      ],
      "properties": {
        "externally_certified": {
          "const": false
        },
        "reproducible_build_verified": {
          "type": "boolean"
        },
        "signed_release_verified": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
