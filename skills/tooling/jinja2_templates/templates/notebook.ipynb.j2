{
 "nbformat": 4,
 "nbformat_minor": 5,
 "metadata": {
  "kernelspec": {
   "display_name": "Python 3",
   "language": "python",
   "name": "python3"
  },
  "language_info": {
   "name": "python",
   "version": "3.14.4"
  }
 },
 "cells": [
{% for celula in celulas %}
  {
   "cell_type": "{{ celula.tipo }}",
   "metadata": {},
   {% if celula.tipo == "markdown" %}
   "source": [
    "{{ celula.conteudo | replace('\n', '\\n') | replace('"', '\\"') }}"
   ]
   {% elif celula.tipo == "code" %}
   "source": [
    "{{ celula.conteudo | replace('\n', '\\n') | replace('"', '\\"') }}"
   ],
   "outputs": [],
   "execution_count": null
   {% endif %}
  }{% if not loop.last %},{% endif %}
{% endfor %}
 ]
}
