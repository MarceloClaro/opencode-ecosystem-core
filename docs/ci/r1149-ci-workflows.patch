+  lean-proofs:
+    name: Lean 4 + Mathlib proofs
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install elan
+        run: |
+          curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y
+          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
+      - name: Cache Lake packages
+        uses: actions/cache@v4
+        with:
+          path: livro-core/lean/.lake
+          key: lake-${{ runner.os }}-${{ hashFiles('livro-core/lean/lean-toolchain', 'livro-core/lean/lake-manifest.json') }}
+          restore-keys: |
+            lake-${{ runner.os }}-
+      - name: Fetch Mathlib cache
+        working-directory: livro-core/lean
+        run: |
+          set -euo pipefail
+          if ! lake exe cache get; then
+            echo "cache get failed; resolving dependencies once"
+            lake update
+            lake exe cache get
+          fi
+      - name: Compile complex proofs
+        working-directory: livro-core/lean
+        run: |
+          set -euo pipefail
+          lake env lean ../../lean/quantum-cb/ComplexProofs.lean 2>&1 | tee /tmp/complex.log
+          if grep -Eq "sorryAx|error:" /tmp/complex.log; then
+            echo "Complex proof failed"; exit 1
+          fi
+      - name: Compile correlation counterproof
+        working-directory: livro-core/lean
+        run: |
+          set -euo pipefail
+          lake env lean ../../lean/quantum-cb/CorrelationCounterproof.lean 2>&1 | tee /tmp/correlation.log
+          if grep -Eq "sorryAx|error:" /tmp/correlation.log; then
+            echo "Correlation proof failed"; exit 1
+          fi
+      - name: Compile Mathlib counterproof
+        working-directory: livro-core/lean
+        run: |
+          set -euo pipefail
+          lake env lean ../../lean/quantum-cb/MathlibCounterproof.lean
+
   package:
     name: Package Build
