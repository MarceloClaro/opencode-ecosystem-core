\chapter{Unidade 2 --- Digrafos}

\section{Lição 3: Digrafos CH, LH, NH}

\begin{boquinha}[Boquinha do Digrafo CH]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Posição da Boca}\\[0.5em]
Boca ENTREABERTA\\
Dentes próximos ao lábio (CH)\\
Som: ``CH-CH-CH''\\[1em]
Palavras: chave, chama, choque
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Sílabas}\\[0.5em]
\dig{CH}{A} \quad \dig{CH}{E} \quad \dig{CH}{I} \quad \dig{CH}{O} \quad \dig{CH}{U}
\end{minipage}
\end{boquinha}

\vspace{1em}

\begin{boquinha}[Boquinha do Digrafo NH]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Posição da Boca}\\[0.5em]
Boca ENTREABERTA\\
Língua toca o céu (nasal)\\
Som: ``NH-NH-NH''\\[1em]
Palavras: ninho, pinha, cozinha
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Exemplos}\\[0.5em]
ninho \quad pinha \quad cozinha
\end{minipage}
\end{boquinha}


\begin{boquinha}[Boquinha do Digrafo LH]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Posição da Boca}\\[0.5em]
Boca ENTREABERTA\\
Língua toca o céu pela lateral\\
Som: ``LH-LH-LH''\\[1em]
Palavras: alho, palha, coelho
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Exemplos}\\[0.5em]
A-LHO \quad PA-LHA \quad CO-E-LHO
\end{minipage}
\end{boquinha}

\section{Lição 4: Digrafos RR, SS}

\begin{boquinha}[Boquinha do Digrafo RR]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Posição da Boca}\\[0.5em]
Boca ENTREABERTA\\
Língua vibra FORTE no céu\\
Som: ``RRR-RRR'' (vibrante longa)\\[1em]
Palavras: carro, corrida, burro
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Regra}\\[0.5em]
O RR aparece ENTRE vogais, com som forte:\\[0.3em]
CAR-RO \quad COR-RI-DA \quad BUR-RO
\end{minipage}
\end{boquinha}

\begin{exercicio}[Folha de Prática 3.3 --- Dígrafos]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V3-A-03 & Silábico-Alfabético & D1 (Leitura de palavras) & EF03LP01 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Ler palavras com digrafos:
  \begin{center}
  $\rightarrow$ chave \quad ninho \quad carro \quad passo \quad alho \quad pinha
  \end{center}
  
  \item Separar palavras em sílabas:
  \begin{center}
  CHAVE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  NINHO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  CARRO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  TRABALHO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item Ler palavras:
  \begin{center}
  $\rightarrow$ chave \quad nhoque \quad carro \quad calha \quad pinha \quad ramalho
  \end{center}
  
  \item Escrever 5 palavras com digrafos:
  \begin{center}
  1. \underline{\hspace{4cm}} \quad 2. \underline{\hspace{4cm}} \quad 3. \underline{\hspace{4cm}} \quad 4. \underline{\hspace{4cm}} \quad 5. \underline{\hspace{4cm}}
  \end{center}
  
  \item Ler frase:
  \begin{center}
  $\rightarrow$ O nhoque é muito gostoso.
  \end{center}
\end{enumerate}
\end{exercicio}

