\chapter{Unidade 3 --- Ditongos}

\section{Lição 5: Ditongos Intercalares (AI, EI, OI, UI)}

\begin{boquinha}[Boquinha do Ditongo AI]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Posição da Boca}\\[0.5em]
Boca ABERTA (A) → ENTREABERTA (I)\\
Transição suave\\
Som: ``AI-AI''\\[1em]
Palavras: pais, mais, cai
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Palavras e Sílabas}\\[0.5em]
\dig{PA}{I} = pai \quad \dig{CA}{I} = cai \quad \dig{MÃ}{E} = mãe\\[0.3em]
mais \quad pais
\end{minipage}
\end{boquinha}

\section{Lição 6: Ditongos Finais (AU, EU, OU)}

\begin{boquinha}[Boquinha do Ditongo OU]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Posição da Boca}\\[0.5em]
Boca ARREDONDADA (O) → ENTREABERTA (U)\\
Transição circular\\
Som: ``OU-OU''\\[1em]
Palavras: dou, couro, roupa
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Sílabas}\\[0.5em]
\dig{C}{OU} \quad \dig{M}{OU} \quad \dig{S}{OU} \quad \dig{V}{OU} \quad \dig{N}{OU}
\end{minipage}
\end{boquinha}

\begin{exercicio}[Folha de Prática 3.4 --- Ditongos]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V3-A-04 & Silábico-Alfabético & D1 (Leitura de palavras) & EF03LP01 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Identificar ditongos nas palavras:
  \begin{center}
  \fbox{PAI}S \quad \fbox{MAI}S \quad \fbox{CAI}SA \quad \fbox{NOI}TE \quad \fbox{COU}RO
  \end{center}
  
  \item Separar palavras em sílabas:
  \begin{center}
  PAIS $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  COURO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  NOITE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item Formar palavras com ditongos:
  \begin{center}
  MA + IS = \underline{\hspace{2cm}} \quad 
  COU + RO = \underline{\hspace{2cm}} \quad 
  NOI + TE = \underline{\hspace{2cm}}
  \end{center}
  
  \item Ler palavras:
  \begin{center}
  $\rightarrow$ pais \quad mais \quad noite \quad couro \quad saudade \quad boi
  \end{center}
  
  \item Escrever 3 palavras com ditongos:
  \begin{center}
  1. \underline{\hspace{4cm}} \quad 2. \underline{\hspace{4cm}} \quad 3. \underline{\hspace{4cm}}
  \end{center}
  
  \item Ler frase:
  \begin{center}
  $\rightarrow$ O pai está em casa.
  \end{center}
\end{enumerate}
\end{exercicio}

