\chapter{Unidade 1 --- Sílabas Compostas com R}

\section{Lição 1: Sílabas com TR}

\begin{boquinha}[Boquinha das Sílabas TR]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Posição da Boca}\\[0.5em]
Língua toca atrás dos dentes (T)\\
Depois vibra no céu da boca (R)\\
Som: ``TR-TR-TR''\\[1em]
Palavras: tigre, trabalho, prato
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Sílabas}\\[0.5em]
\dig{T}{RA} \quad \dig{T}{RE} \quad \dig{T}{RI} \quad \dig{T}{RO} \quad \dig{T}{RU}
\end{minipage}
\end{boquinha}

\begin{exercicio}[Folha de Prática 3.1 --- Sílabas TR]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V3-A-01 & Silábico-Alfabético & D1 (Leitura de palavras) & EF03LP01 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Formar sílabas com TR:
  \begin{center}
  \dig{T}{RA} \quad \dig{T}{RE} \quad \dig{T}{RI} \quad \dig{T}{RO} \quad \dig{T}{RU}
  \end{center}
  
  \item Separar palavras em sílabas:
  \begin{center}
  TRABALHO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  PRATO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  TIGRE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item Formar palavras:
  \begin{center}
  TR + A + BA + LHO = \underline{\hspace{3cm}} \quad 
  P + RA + TO = \underline{\hspace{3cm}} \quad 
  TI + GRE = \underline{\hspace{3cm}}
  \end{center}
  
  \item Ler palavras:
  \begin{center}
  $\rightarrow$ trabalho \quad prato \quad tigre \quad troca \quad trecho
  \end{center}
  
  \item Escrever 3 palavras com TR:
  \begin{center}
  1. \underline{\hspace{4cm}} \quad 2. \underline{\hspace{4cm}} \quad 3. \underline{\hspace{4cm}}
  \end{center}
  
  \item Ler frase:
  \begin{center}
  $\rightarrow$ O tigre é um grande felino.
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Lição 2: Sílabas com BR, CR, DR, FR, GR, PR}

\begin{boquinha}[Boquinha das Sílabas com R]
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Grupo de Sílabas}\\[0.5em]
\dig{B}{RA} \quad \dig{C}{RA} \quad \dig{D}{RA} \\
\dig{F}{RA} \quad \dig{G}{RA} \quad \dig{P}{RA}
\end{minipage}
\hfill
\begin{minipage}{0.45\textwidth}
\centering
\textbf{Exemplos}\\[0.5em]
BRA + CO = BRAÇO \\
CRA + VO = CRAVO \\
DRA + MA = DRAMA \\
FRA + CO = FRACO \\
GRA + TO = GRATO \\
PRA + TO = PRATO
\end{minipage}
\end{boquinha}

\begin{exercicio}[Folha de Prática 3.2 --- Sílabas Compostas com R]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V3-A-02 & Silábico-Alfabético & D1 (Leitura de palavras) & EF03LP01 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Formar sílabas com R:
  \begin{center}
  \dig{B}{RA} \quad \dig{C}{RA} \quad \dig{D}{RA} \\
  \dig{F}{RA} \quad \dig{G}{RA} \quad \dig{P}{RA}
  \end{center}

  \item Formar palavras:
  \begin{center}
  BRA + CO = \underline{\hspace{2cm}} \quad 
  CRA + VO = \underline{\hspace{2cm}} \quad 
  FRA + CO = \underline{\hspace{2cm}} \\[0.5em]
  GRA + TO = \underline{\hspace{2cm}} \quad 
  DRA + MA = \underline{\hspace{2cm}} \quad 
  PRA + TO = \underline{\hspace{2cm}}
  \end{center}

  \item Ler palavras:
  \begin{center}
  $\rightarrow$ braço \quad cravo \quad fraco \quad grato \quad drama \quad prato
  \end{center}

  \item Escrever 3 palavras com BR, CR, DR, FR, GR ou PR:
  \begin{center}
  1. \underline{\hspace{4cm}} \quad 2. \underline{\hspace{4cm}} \quad 3. \underline{\hspace{4cm}}
  \end{center}
\end{enumerate}
\end{exercicio}


