\chapter{Unidade 4 --- Textos e Produção}

\section{Lição 7: Leitura de Textos Curtos}

\textbf{Exemplo de texto curto:}
\begin{center}
\begin{tikzpicture}
  \draw[thick, rounded corners, fill=bglight] (0,0) rectangle (12,4);
  \node[align=left, text width=10cm] at (6,2) {
    \textbf{O CHAVEIRO}\\[0.5em]
    O homem tinha uma chave grande.\\
    A chave abria a porta da casa.\\
    O homem abriu a porta.\\
    A chave era de ouro.\\
    O homem cuidou bem da chave.
  };
\end{tikzpicture}
\end{center}

\begin{exercicio}[Ler e Responder]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V3-C-05 & Alfabético & D3 (Leitura de textos) & EF03LP06 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item O que o homem tinha? \underline{\hspace{6cm}}
  \item O que a chave abria? \underline{\hspace{6cm}}
  \item De que era a chave? \underline{\hspace{6cm}}
  \item O que o homem fez? \underline{\hspace{6cm}}
  \item Escrever uma frase sobre o texto:
  \begin{center}
  \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Lição 8: Produção de Textos}

\textbf{Estrutura de um texto narrativo:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Início}: Apresentação do personagem
  \item \textbf{Meio}: O que acontece
  \item \textbf{Fim}: O que acontece no final
\end{enumerate}

\begin{exercicio}[Produção de Texto]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V3-C-06 & Alfabético & D4 (Produção de texto) & EF03LP02 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Escrever um texto de 3--5 frases sobre ``O Animal Favorito'':
  \begin{center}
  \begin{tikzpicture}
    \draw[thick, dashed] (0,0) rectangle (12,6);
    \node[below left] at (0.2,6) {\small Início:};
    \node[below left] at (0.2,4) {\small Meio:};
    \node[below left] at (0.2,2) {\small Fim:};
  \end{tikzpicture}
  \end{center}
  
  \item Revisar o texto:
  \begin{center}
  $\square$ Tem início, meio e fim\\
  $\square$ Tem pelo menos 3 frases\\
  $\square$ As frases começam com letra maiúscula\\
  $\square$ Tem pontuação correta
  \end{center}
\end{enumerate}
\end{exercicio}

