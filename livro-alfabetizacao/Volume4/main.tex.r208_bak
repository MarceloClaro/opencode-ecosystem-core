\appendix

\chapter{Classes Gramaticais}

\begin{table}[h]
\centering
\caption{Classes Gramaticais}
\begin{tabular}{|l|p{5cm}|p{4cm}|}
\hline
\textbf{Classe} & \textbf{Definição} & \textbf{Exemplo} \\
\hline
Substantivo & Nomeia seres, coisas & menino, casa \\
\hline
Adjetivo & Caracteriza substantivo & alto, bonito \\
\hline
Verbo & Indica ação, estado & correr, ser \\
\hline
Artigo & Antecede substantivo & o, a, um, uma \\
\hline
Pronome & Substitui substantivo & eu, tu, ele \\
\hline
Preposição & Liga termos & em, de, para \\
\hline
Conjunção & Liga orações & e, mas, ou \\
\hline
\end{tabular}
\end{table}

