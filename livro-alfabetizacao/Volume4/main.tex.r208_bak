\chapter{Unidade 1 --- Análise de Frases}

\begin{dica}
\textbf{Pausa neuroinclusiva:} A Técnica da Boquinha (Volume 3, Lição 2) continua à disposição: se algum aluno demonstrar insegurança articulatória ou confusão de sons ao ler em voz alta, retome a posição da boca e o gesto associado antes de prosseguir. Nesta fase, o foco é a compreensão de frases.
\end{dica}

\section{Lição 1: Sujeito e Predicado}

\textbf{Estrutura da frase:}
\begin{center}
\textbf{FRASE} = \textcolor{primary}{SUJEITO} + \textcolor{accent}{PREDICADO}
\end{center}

\textbf{Exemplos:}
\begin{enumerate}[leftmargin=2cm]
  \item \textcolor{primary}{O menino} + \textcolor{accent}{corre no parque.}
  \item \textcolor{primary}{A menina} + \textcolor{accent}{está estudando.}
  \item \textcolor{primary}{O gato} + \textcolor{accent}{dorme no sofá.}
\end{enumerate}

\begin{exercicio}[Identificar Sujeito e Predicado]

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V4-B-01 & Alfabético & D5 (Conhecimento gramatical) & EF04LP05 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Identificar o sujeito e o predicado:
  \begin{center}
  \begin{tabular}{|p{5cm}|p{4cm}|p{4cm}|}
  \hline
  \textbf{Frase} & \textbf{Sujeito} & \textbf{Predicado} \\
  \hline
  O gato mia. & \underline{\hspace{3cm}} & \underline{\hspace{3cm}} \\
  \hline
  A menina pula. & \underline{\hspace{3cm}} & \underline{\hspace{3cm}} \\
  \hline
  \end{tabular}
  \end{center}
  
  \item Escrever 3 frases com sujeito e predicado:
  \begin{center}
  1. \underline{\hspace{8cm}}\\
  2. \underline{\hspace{8cm}}\\
  3. \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Lição 2: Substantivos}

\textbf{O que são substantivos?}\\
Substantivos são palavras que nomeiam seres, coisas, sentimentos ou ideias.

\textbf{Classificação:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Próprios}: Maria, João, Brasil
  \item \textbf{Comuns}: menino, cidade, livro
  \item \textbf{Concretos}: mesa, cadeira, árvore
  \item \textbf{Abstratos}: amor, paz, felicidade
\end{enumerate}

\chapter{Unidade 2 --- Adjetivos e Verbos}

\section{Lição 3: Adjetivos}

Adjetivos são palavras que caracterizam o substantivo.

\textbf{Exemplos:}
\begin{center}
\begin{tabular}{cc}
\textbf{Substantivo} & \textbf{Adjetivo} \\
\hline
menino & alto, bonito \\
casa & grande, amarela \\
livro & interessante, grosso \\
\end{tabular}
\end{center}

\section{Lição 4: Verbos}

Verbos são palavras que indicam ação, estado ou fenômeno da natureza.

\textbf{Conjugação presente do indicativo:}
\begin{center}
\begin{tabular}{|l|c|c|c|c|c|}
\hline
\textbf{Verbo} & \textbf{Eu} & \textbf{Tu} & \textbf{Ele/Ela} & \textbf{Nós} & \textbf{Eles} \\
\hline
Correr & corro & corres & corre & corremos & correm \\
\hline
Estar & estou & estás & está & estamos & estão \\
\hline
\end{tabular}
\end{center}

\chapter{Unidade 3 --- Ortografia e Pontuação}

\section{Lição 5: Uso do Hífen}

\textbf{Regras do hífen:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Prefixos}: anti-, co-, des-, ex-, re-
  \begin{center}
  anti-herói \quad super-herói \quad pré-história
  \end{center}
  \item \textbf{Palavras compostas}: guarda-chuva, segunda-feira

\begin{dica}
\textbf{Pausa neuroinclusiva --- hífen:} Em ``caixa d'água'' o hífen é obrigatório (Acordo Ortográfico de 1990); ``girassol'' é aglutinação (gira + sol), sem hífen. Ao ditar, faça pausa clara e mostre o gesto de junção para cada palavra composta.
\end{dica}
\end{enumerate}

\section{Lição 6: Pontuação}

\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Ponto final (.)}: Marca o fim de uma frase declarativa
  \item \textbf{Ponto de interrogação (?)}: Marca uma pergunta
  \item \textbf{Ponto de exclamação (!)}: Marca uma exclamação
  \item \textbf{Vírgula (,)}: Separa elementos, marca pausa
  \item \textbf{Dois-pontos (:)}: Introduz uma lista ou fala
\end{enumerate}

\chapter{Unidade 4 --- Produção de Textos}

\section{Lição 7: Tipos de Texto}

\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Narrativo}: Conta uma história
  \item \textbf{Informativo}: Informa algo
  \item \textbf{Instrucional}: Ensina a fazer algo
  \item \textbf{Descritivo}: Descreve algo
\end{enumerate}

\section{Lição 8: Estrutura do Texto Narrativo}

\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Personagens}: Quem participa da história
  \item \textbf{Tempo}: Quando acontece
  \item \textbf{Lugar}: Onde acontece
  \item \textbf{Enredo}: O que acontece
\end{enumerate}

\begin{exercicio}[Produção de Texto Narrativo]

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V4-C-01 & Alfabético & D4 (Produção de texto) & EF04LP02 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

Escrever um texto de 5--8 frases sobre ``Uma Aventura no Parque'':
\begin{enumerate}
  \item Identificar personagens, tempo e lugar
  \item Escrever início, meio e fim
  \item Revisar: pontuação, ortografia, coesão
\end{enumerate}
\end{exercicio}

