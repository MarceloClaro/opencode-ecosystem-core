\chapter{Unidade 1 --- Leitura Compreensiva}

\begin{dica}
\textbf{Pausa neuroinclusiva:} A Técnica da Boquinha (Volume 3, Lição 2) continua à disposição: se algum aluno apresentar dúvida articulatória ao ler em voz alta, retome a posição da boca e o gesto associado ao som antes de prosseguir. No 5º ano, o foco é a compreensão e a argumentação, não a decodificação.
\end{dica}

\section{Lição 1: Estratégias de Leitura}

\textbf{Estratégias de leitura para o 5º ano:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Antes de ler}: Observar título, imagens, fazer previsões
  \item \textbf{Durante a leitura}: Sublinhar palavras novas, fazer inferências
  \item \textbf{Depois de ler}: Resumir, avaliar, conectar com experiências
\end{enumerate}

\section{Lição 2: Tipos de Texto}

\textbf{Gêneros textuais do 5º ano:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Narrativo}: Conto, crônica, fábula, lenda
  \item \textbf{Informativo}: Artigo, reportagem, verbete
  \item \textbf{Opinativo}: Editorial, carta argumentativa, resenha
  \item \textbf{Instrucional}: Receita, manual, bula
  \item \textbf{Descritivo}: Descrição de pessoa, lugar, objeto
\end{enumerate}

\begin{exercicio}[Leitura Compreensiva]

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V5-A-01 & Alfabético & D3 (Leitura de textos) & EF05LP01 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Ler o texto ``O Menino e o Urso'' (ver a Avaliação Final do 5º Ano, Seção 1)
  \item Responder:
  \begin{enumerate}
    \item Quem são os personagens? \underline{\hspace{6cm}}
    \item Onde acontece a história? \underline{\hspace{6cm}}
    \item Qual é o problema do menino? \underline{\hspace{6cm}}
    \item Como o problema é resolvido? \underline{\hspace{6cm}}
    \item Qual é a lição da história? \underline{\hspace{6cm}}
  \end{enumerate}
\end{enumerate}
\end{exercicio}

\chapter{Unidade 2 --- Produção de Textos}

\section{Lição 3: Estrutura do Texto Argumentativo}

\textbf{Estrutura do texto argumentativo:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Tese}: Afirmação que se quer provar
  \item \textbf{Argumentos}: Razões que sustentam a tese
  \item \textbf{Conclusão}: Síntese dos argumentos
\end{enumerate}

\section{Lição 4: Revisão e Reescrita}

\textbf{Checklist de revisão:}
\begin{center}
\begin{tabular}{|l|c|}
\hline
\textbf{Critério} & \textbf{OK} \\
\hline
O texto tem início, meio e fim & $\square$ \\
\hline
As frases começam com maiúscula & $\square$ \\
\hline
Tem pontuação correta & $\square$ \\
\hline
Não tem erros de ortografia & $\square$ \\
\hline
A concordância está correta & $\square$ \\
\hline
O texto é coeso e coerente & $\square$ \\
\hline
\end{tabular}
\end{center}

\begin{exercicio}[Produção de Texto Argumentativo]

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
\hline
V5-B-01 & Alfabético & D4 (Produção de texto) & EF05LP02 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Escrever um texto argumentativo de 8--12 frases sobre:
  \begin{center}
  ``Por que devemos proteger o meio ambiente?''
  \end{center}
  \item Estrutura:
  \begin{enumerate}
    \item Tese: \underline{\hspace{8cm}}
    \item Argumento 1: \underline{\hspace{8cm}}
    \item Argumento 2: \underline{\hspace{8cm}}
    \item Argumento 3: \underline{\hspace{8cm}}
    \item Conclusão: \underline{\hspace{8cm}}
  \end{enumerate}
  \item Revisar com o checklist
  \item Reescrever a versão final
\end{enumerate}
\end{exercicio}

\chapter{Unidade 3 --- Ortografia Avançada}

\section{Lição 5: C/QU e SS/Ç}

\textbf{Regras de uso:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{C/QU}: A letra \textbf{C} tem som de \textbf{k} antes de A, O e U (casa, coisa, cutia); antes de E e I, o som de \textbf{k} é escrito com \textbf{QU} (queijo, quilo). Não existe a grafia ``KC'' em português.
  \item \textbf{SS/Ç}: Usa-se SS ou Ç entre vogais (classe, aço); quando há duas vogais com som de \textbf{s} entre elas, escreve-se SS ou Ç (passeio, caçarola), e nunca S sozinho entre vogais para esse som.
\end{enumerate}

\section{Lição 6: S/Z e X/CH}

\textbf{Regras de uso:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{S/Z}: O som de \textbf{z} entre vogais pode ser escrito com S (casa, asa) ou com Z (zero, feliz); no início ou no fim da palavra, o som de \textbf{z} é sempre Z.
  \item \textbf{X/CH}: O som de \textbf{x} (de xícara) pode ser escrito com X (xícara, mexer) ou com CH (chave, chuva); com X também se escreve o som de \textbf{z} (exemplo) e o som de \textbf{ss} (trouxe).
\end{enumerate}

\chapter{Unidade 4 --- Revisão e Reescrita}

\section{Lição 7: Processo de Reescrita}

\textbf{Etapas da reescrita:}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Leitura crítica}: Reler o texto com atenção
  \item \textbf{Identificação de problemas}: Marcar trechos confusos
  \item \textbf{Correção}: Reescrever os trechos problemáticos
  \item \textbf{Revisão final}: Conferir ortografia, pontuação, concordância
\end{enumerate}

\section{Lição 8: Avaliação do Texto}

\textbf{Rubrica de avaliação:}
\begin{center}
\begin{tabular}{|p{3cm}|p{3cm}|p{3cm}|p{3cm}|}
\hline
\textbf{Critério} & \textbf{Iniciante} & \textbf{Em desenvolvimento} & \textbf{Domínio} \\
\hline
Estrutura & Sem início/fim & Parcial & Completa \\
\hline
Coesão & Sem conexão & Parcial & Excelente \\
\hline
Ortografia & Muitos erros & Alguns erros & Poucos erros \\
\hline
Pontuação & Sem pontuação & Parcial & Correta \\
\hline
Vocabulário & Pobre & Adequado & Rico \\
\hline
\end{tabular}
\end{center}

\section{Avaliação Final do 5º Ano}

\begin{avaliacao}

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{BNCC} \\
