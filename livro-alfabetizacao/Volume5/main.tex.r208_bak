\end{center}
\vspace{0.3em}

\textbf{AVALIAÇÃO FINAL --- 5º ANO}\\[1em]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}}\\[1em]

\textbf{SEÇÃO 1: LEITURA (20 pontos)}

\begin{enumerate}
  \item Ler o texto e responder (10 pontos):
  \begin{center}
  \begin{tikzpicture}
    \draw[thick, rounded corners, fill=bglight] (0,0) rectangle (14,5);
    \node[align=left, text width=12cm] at (7,2.5) {
      \textbf{O MENINO E O URSO}\\[0.5em]
      Era uma vez um menino que tinha medo de tudo.\\
      Um dia, ele encontrou um urso no meio da floresta.\\
      O urso não era mau. Era apenas solitário.\\
      O menino e o urso se tornaram amigos.\\
      Aprendemos que as aparências enganam.
    };
  \end{tikzpicture}
  \end{center}
  
  \begin{enumerate}
    \item Quem são os personagens? (2 pontos)
    \item Onde acontece a história? (2 pontos)
    \item Qual é o problema do menino? (3 pontos)
    \item O que o texto nos ensina? (3 pontos)
  \end{enumerate}
  
  \item Ler e classificar o gênero textual (10 pontos):
  \begin{center}
  \begin{tabular}{|p{6cm}|p{4cm}|}
  \hline
  \textbf{Texto} & \textbf{Gênero} \\
  \hline
  ``Era uma vez um rei...'' & \underline{\hspace{3cm}} \\
  \hline
  ``O Brasil é um país...'' & \underline{\hspace{3cm}} \\
  \hline
  ``Acho que devemos...'' & \underline{\hspace{3cm}} \\
  \hline
  ``Corte os ingredientes...'' & \underline{\hspace{3cm}} \\
  \hline
  \end{tabular}
  \end{center}
\end{enumerate}

\textbf{SEÇÃO 2: PRODUÇÃO (20 pontos)}

\begin{enumerate}[resume]
  \item Escrever um texto argumentativo de 8--12 frases (20 pontos):
  \begin{center}
  ``Por que a leitura é importante?''
  \end{center}
  
  \textbf{Critérios de avaliação:}
  \begin{center}
  \begin{tabular}{|l|c|}
  \hline
  \textbf{Critério} & \textbf{Pontos} \\
  \hline
  Tem tese clara & \underline{\hspace{2cm}}/4 \\
  \hline
  Tem 3 argumentos & \underline{\hspace{2cm}}/6 \\
  \hline
  Tem conclusão & \underline{\hspace{2cm}}/2 \\
  \hline
  Ortografia correta & \underline{\hspace{2cm}}/3 \\
  \hline
  Pontuação correta & \underline{\hspace{2cm}}/2 \\
  \hline
  Coesão e coerência & \underline{\hspace{2cm}}/3 \\
  \hline
  \end{tabular}
  \end{center}
\end{enumerate}

\textbf{NOTA TOTAL:} \underline{\hspace{1cm}}/40
\end{avaliacao}

