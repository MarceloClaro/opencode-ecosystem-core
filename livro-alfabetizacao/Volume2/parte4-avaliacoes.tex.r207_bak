\chapter{Avaliações Diagnósticas --- 2º Ano}

\section{Avaliação da Unidade 1 --- Letras C, D, P}

\begin{avaliacao}
\textbf{Avaliação Diagnóstica --- Unidade 1}\\[1em]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}}\\[1em]

\textbf{SEÇÃO 1: IDENTIFICAÇÃO (10 pontos)}

\begin{enumerate}
  \item Formar sílabas (1 ponto cada):
  \begin{center}
  \begin{tabular}{ccccc}
  \sil{C}{A} & \sil{C}{E} & \sil{C}{I} & \sil{C}{O} & \sil{C}{U} \\
  \sil{D}{A} & \sil{D}{E} & \sil{D}{I} & \sil{D}{O} & \sil{D}{U} \\
  \end{tabular}
  \end{center}
  
  \item Identificar a letra que falta (1 ponto cada):
  \begin{center}
  \underline{C}asa \quad \underline{D}ente \quad \underline{P}ato \quad \underline{C}opo \quad \underline{D}ado
  \end{center}
\end{enumerate}

\textbf{SEÇÃO 2: SEPARAÇÃO SILÁBICA (10 pontos)}

\begin{enumerate}[resume]
  \item Separar palavras em sílabas (2 pontos cada):
  \begin{center}
  CASA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  DENTE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  PATO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
\end{enumerate}

\textbf{SEÇÃO 3: LEITURA (10 pontos)}

\begin{enumerate}[resume]
  \item Ler palavras (1 ponto cada):
  \begin{center}
  $\rightarrow$ casa \quad dente \quad pato \quad copo \quad dado \quad pedra \quad cesto \quad bico \quad dado \quad pico
  \end{center}
\end{enumerate}

\textbf{NOTA TOTAL:} \underline{\hspace{1cm}}/30
\end{avaliacao}

\section{Avaliação Final --- 2º Ano}

\begin{avaliacao}
\textbf{AVALIAÇÃO DIAGNÓSTICA FINAL --- FIM DO 2º ANO}\\[1em]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}}\\[1em]

\textbf{SEÇÃO 1: RECONHECIMENTO (10 pontos)}

\begin{enumerate}
  \item Formar sílabas (1 ponto cada):
  \begin{center}
  \begin{tabular}{ccccc}
  \sil{C}{A} & \sil{D}{E} & \sil{P}{I} & \sil{N}{O} & \sil{B}{U} \\
  \sil{G}{A} & \sil{F}{E} & \sil{V}{I} & \sil{M}{O} & \sil{S}{U} \\
  \end{tabular}
  \end{center}
  
  \item Separar palavras em sílabas (1 ponto cada):
  \begin{center}
  CASA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  DENTE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  CABELO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
\end{enumerate}

\textbf{SEÇÃO 2: LEITURA (10 pontos)}

\begin{enumerate}[resume]
  \item Ler palavras (1 ponto cada):
  \begin{center}
  $\rightarrow$ casa \quad dente \quad pato \quad nave \quad bola \quad gato \quad fogo \quad vaso \quad boné \quad copo
  \end{center}
  
  \item Ler frases (2 pontos cada):
  \begin{center}
  $\rightarrow$ O gato mia.\\
  $\rightarrow$ A menina pula.\\
  $\rightarrow$ O menino corre.
  \end{center}
\end{enumerate}

\textbf{SEÇÃO 3: PRODUÇÃO (10 pontos)}

\begin{enumerate}[resume]
  \item Escrever 3 palavras com cada sílaba (5 pontos):
  \begin{center}
  CA: \underline{\hspace{3cm}} \underline{\hspace{3cm}} \underline{\hspace{3cm}}\\
  DE: \underline{\hspace{3cm}} \underline{\hspace{3cm}} \underline{\hspace{3cm}}\\
  PA: \underline{\hspace{3cm}} \underline{\hspace{3cm}} \underline{\hspace{3cm}}
  \end{center}
  
  \item Escrever 3 frases simples (5 pontos):
  \begin{center}
  1. \underline{\hspace{8cm}}\\
  2. \underline{\hspace{8cm}}\\
  3. \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}

\textbf{NOTA TOTAL:} \underline{\hspace{1cm}}/30
\end{avaliacao}

\section{Níveis de Alfabetização --- 2º Ano}

\begin{table}[h]
\centering
\caption{Classificação do Nível de Alfabetização --- 2º Ano}
\begin{tabular}{|c|p{3cm}|p{4cm}|p{4cm}|}
\hline
\textbf{Pontuação} & \textbf{Nível} & \textbf{Descrição} & \textbf{Ação} \\
\hline
0--10 & Silábico & Confunde sílabas, dificuldade com novas consonantes & Reforço de sílabas diretas \\
\hline
11--20 & Silábico-Alfabético & Mistura estratégias & Consolidar sílabas e introducing frases \\
\hline
21--30 & Alfabético & Domina sílabas diretas e lê frases & Avançar para sílabas indiretas \\
\hline
\end{tabular}
\end{table}
