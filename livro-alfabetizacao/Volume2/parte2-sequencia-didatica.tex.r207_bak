\chapter{Unidade 4 --- Palavras com Sílabas Diretas}

\section{Lição 10: Formando Palavras Completas}

\textbf{Fórmula de formação de palavras:}
\begin{center}
\textbf{SÍLABA + SÍLABA = PALAVRA}
\end{center}

\textbf{Exemplos:}
\begin{center}
\begin{tabular}{ccc}
\sil{CA}{SA} = CASA & \sil{DENTE}{DO} = DEDO & \sil{PA}{TO} = PATO \\[0.5em]
\sil{BO}{LA} = BOLA & \sil{GA}{TO} = GATO & \sil{FO}{GO} = FOGO \\[0.5em]
\sil{VA}{SO} = VASO & \sil{NA}{VE} = NAVE & \sil{BE}{JO} = BEIJO \\
\end{tabular}
\end{center}

\section{Lição 11: Palavras de 3 Sílabas}

\begin{exercicio}[Formando Palavras de 3 Sílabas]
\begin{enumerate}
  \item Separar em sílabas:
  \begin{center}
  CABELO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  BONÉDIA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  CADEIRA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item Formar palavras de 3 sílabas:
  \begin{center}
  CA + BE + LO = \underline{\hspace{3cm}} \quad 
  PA + TO + CA = \underline{\hspace{3cm}} \quad 
  BO + NI + TO = \underline{\hspace{3cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

