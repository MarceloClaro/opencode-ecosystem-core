\chapter{Unidade 1 --- Letras C, D, P}

\section{Lição 1: A Letra C}

\letra{C}

\boq{C}{%
  Boca ENTREABERTA\\
  Parte de trás da boca toca o céu\\
  Som: ``K'' (antes de a, o, u) ou ``S'' (antes de e, i)\\[1em]
  Palavras: casa, cesto, copo, cebola, canto
}

\begin{exercicio}[Folha de Prática 2.1 --- Letra C]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\subsection*{PARTE 1: RECONHECIMENTO}

\begin{enumerate}
  \item Circular todas as letras ``C'':
  \begin{center}
  \fbox{C}A \fbox{C}E \fbox{C}I \fbox{C}O \fbox{C}U \fbox{C}A
  \end{center}
  
  \item Formar sílabas com C:
  \begin{center}
  \sil{C}{A} \quad \sil{C}{E} \quad \sil{C}{I} \quad \sil{C}{O} \quad \sil{C}{U}
  \end{center}
  
  \item Separar palavras em sílabas:
  \begin{center}
  CASA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  CESTO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  COPO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
\end{enumerate}

\subsection*{PARTE 2: PRODUÇÃO}

\begin{enumerate}[resume]
  \item Completar com ``C'':
  \begin{center}
  \underline{C}asa \quad \underline{C}esto \quad \underline{C}opo \quad \underline{C}ebola
  \end{center}
  
  \item Escrever 3 palavras com ``C'':
  \begin{center}
  1. \underline{\hspace{4cm}} \quad 2. \underline{\hspace{4cm}} \quad 3. \underline{\hspace{4cm}}
  \end{center}
\end{enumerate}

\subsection*{PARTE 3: INTEGRAÇÃO}

\begin{enumerate}[resume]
  \item Ler para o professor:
  \begin{center}
  $\rightarrow$ CA --- CE --- CI --- CO --- CU\\
  $\rightarrow$ CASA --- CESTO --- COPO
  \end{center}
  
  \item Escrever uma frase com ``C'':
  \begin{center}
  \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Lição 2: A Letra D}

\letra{D}

\boq{D}{%
  Boca ENTREABERTA\\
  Língua toca atrás dos dentes superiores\\
  Som: ``D-D-D'' (sonora)\\[1em]
  Palavras: dente, dado, dedo, dama, doce
}

\section{Lição 3: A Letra P}

\letra{P}

\boq{P}{%
  Boca FECHADA\\
  Ar sai pela boca com força\\
  Som: ``P-P-P'' (sorda)\\[1em]
  Palavras: pato, pedra, pau, pão, peixe
}

%% ============================================================

\chapter{Unidade 2 --- Letras N, B, G}

\section{Lição 4: A Letra N}

\letra{N}

\boq{N}{%
  Boca ENTREABERTA\\
  Língua toca o céu da boca (nasal)\\
  Som: ``NNN-NNN''\\[1em]
  Palavras: navio, nota, nabo, neve, noite
}

\section{Lição 5: A Letra B}

\letra{B}

\boq{B}{%
  Boca FECHADA\\
  Ar sai pela boca (sonora)\\
  Som: ``BBB-BBB''\\[1em]
  Palavras: bola, boi, boné, baú, beijo
}

\section{Lição 6: A Letra G}

\letra{G}

\boq{G}{%
  Boca ENTREABERTA\\
  Parte de trás da boca toca o céu\\
  Som: ``G-G-G'' (antes de a, o, u) ou ``J'' (antes de e, i)\\[1em]
  Palavras: gato, gelo, gol, giz, gordo
}

%% ============================================================

\chapter{Unidade 3 --- Letras F, V e Consolidação}

\section{Lição 7: A Letra F}

\letra{F}

\boq{F}{%
  Boca ENTREABERTA\\
  Dentes superiores tocam o lábio inferior\\
  Som: ``FFF-FFF''\\[1em]
  Palavras: fogo, feta, feira, fruta, fim
}

\section{Lição 8: A Letra V}

\letra{V}

\boq{V}{%
  Boca ENTREABERTA\\
  Dentes superiores tocam o lábio inferior (sonora)\\
  Som: ``VVV-VVV''\\[1em]
  Palavras: vaso, vento, viagem, vaga, vinho
}

\section{Lição 9: Consolidação do Bloco 2}

\begin{exercicio}[Folha de Prática 2.9 --- Consolidação Bloco 2]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Data:} \underline{\hspace{2cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\subsection*{1. Formar sílabas:}

\begin{center}
\begin{tabular}{ccccc}
\sil{C}{A} & \sil{D}{A} & \sil{P}{A} & \sil{N}{A} & \sil{B}{A} \\
\sil{C}{E} & \sil{D}{E} & \sil{P}{E} & \sil{N}{E} & \sil{B}{E} \\
\sil{G}{A} & \sil{F}{A} & \sil{V}{A} & \sil{G}{E} & \sil{F}{E} \\
\end{tabular}
\end{center}

\subsection*{2. Separar palavras em sílabas:}

\begin{center}
\begin{tabular}{ccc}
CASA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} & 
DENTE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} &
PATO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \\[1em]
NAVE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} &
BOLA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} &
GATO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \\[1em]
FOGO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} &
VASO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} &
CEBO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
\end{tabular}
\end{center}

\subsection*{3. Ler palavras completas:}

\begin{center}
$\rightarrow$ casa \quad dente \quad pato \quad nave \quad bola \quad gato \quad fogo \quad vaso
\end{center}

\subsection*{4. Avaliação diagnóstica:}

\begin{center}
$\square$ Forma todas as sílabas com as novas consonantes\\
$\square$ Separa palavras em sílabas corretamente\\
$\square$ Lê palavras com fluência\\
$\square$ Identifica a diferença entre C/K e G/J
\end{center}
\end{exercicio}

