\chapter{Unidade 5 --- Primeiras Frases e Textos}

\section{Lição 12: Frases Simples}

\textbf{Estrutura de uma frase:}
\begin{center}
\textbf{SUJEITO} + \textbf{PREDICADO}
\end{center}

\textbf{Exemplos:}
\begin{enumerate}[leftmargin=2cm]
  \item \textcolor{primary}{O gato} + \textcolor{accent}{dorme.}
  \item \textcolor{primary}{A menina} + \textcolor{accent}{corre.}
  \item \textcolor{primary}{O menino} + \textcolor{accent}{estuda.}
  \item \textcolor{primary}{A cachorra} + \textcolor{accent}{late.}
\end{enumerate}

\begin{exercicio}[Formar Frases]
\begin{enumerate}
  \item Unir sujeito e predicado:
  \begin{center}
  O gato $\rightarrow$ \underline{\hspace{4cm}}\\
  A menina $\rightarrow$ \underline{\hspace{4cm}}\\
  O menino $\rightarrow$ \underline{\hspace{4cm}}
  \end{center}
  
  \item Escrever 3 frases simples:
  \begin{center}
  1. \underline{\hspace{8cm}}\\
  2. \underline{\hspace{8cm}}\\
  3. \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Lição 13: Textos Curtos}

\textbf{Exemplo de texto curto:}
\begin{center}
\begin{tikzpicture}
  \draw[thick, rounded corners, fill=bglight] (0,0) rectangle (10,3);
  \node[align=left, text width=8cm] at (5,1.5) {
    \textbf{O GATO}\\[0.5em]
    O gato dorme no sofá.\\
    O gato come peixe.\\
    O gato gosta de dormir.\\
    Gato, gato, gato!
  };
\end{tikzpicture}
\end{center}

\begin{exercicio}[Ler e Responder]
\begin{enumerate}
  \item Onde o gato dorme? \underline{\hspace{6cm}}
  \item O que o gato come? \underline{\hspace{6cm}}
  \item O que o gosta de fazer? \underline{\hspace{6cm}}
  \item Escrever uma frase sobre o gato:
  \begin{center}
  \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}
