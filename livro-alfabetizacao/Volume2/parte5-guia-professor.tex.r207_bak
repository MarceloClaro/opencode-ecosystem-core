\chapter{Organização do Tempo --- 2º Ano}

\section{Cronograma Semanal Sugerido}

\begin{table}[h]
\centering
\caption{Cronograma Semanal --- 2º Ano}
\begin{tabular}{|l|c|c|}
\hline
\textbf{Atividade} & \textbf{Frequência} & \textbf{Duração} \\
\hline
Apresentação de nova letra (Boquinha) & 2x por semana & 20 min \\
\hline
Prática Kumon (folhas) & Diária & 20 min \\
\hline
Revisão semanal & 1x por semana & 30 min \\
\hline
Avaliação diagnóstica & A cada 4 semanas & 40 min \\
\hline
Leitura de textos curtos & Diária & 15 min \\
\hline
Escrita de frases & 3x por semana & 15 min \\
\hline
Atividade lúdica (jogos) & 2x por semana & 20 min \\
\hline
\end{tabular}
\end{table}

\section{Sequência de Conteúdo por Semana}

\begin{table}[h]
\centering
\caption{Sequência de Conteúdo --- 16 Semanas}
\begin{tabular}{|c|p{8cm}|}
\hline
\textbf{Semana} & \textbf{Conteúdo} \\
\hline
1--2 & Letras C, D (Boquinhas, exercícios Kumon) \\
\hline
3--4 & Letras P, N (Boquinhas, exercícios Kumon) \\
\hline
5 & Revisão Semanal 1 (C, D, P, N) \\
\hline
6--7 & Letras B, G (Boquinhas, exercícios Kumon) \\
\hline
8--9 & Letras F, V (Boquinhas, exercícios Kumon) \\
\hline
10 & Revisão Semanal 2 (B, G, F, V) \\
\hline
11--12 & Formação de palavras (2 e 3 sílabas) \\
\hline
13 & Revisão Semanal 3 (Palavras) \\
\hline
14--15 & Frases simples e textos curtos \\
\hline
16 & Avaliação Final do 2º Ano \\
\hline
\end{tabular}
\end{table}

