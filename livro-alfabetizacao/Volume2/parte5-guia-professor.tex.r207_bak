\chapter{Materiais Necessários --- 2º Ano}

\section{Material do Professor}
\begin{enumerate}[leftmargin=2cm]
  \item Este livro didático (exemplar do professor)
  \item Caderno de planejamento
  \item Projetor multimídia (para boquinhas digitais)
  \item Quadro verde ou branco com giz/marcador
  \item Cartolinas para cartilhas de parede
  \item Flashcards de sílabas
  \item Impressões das folhas de prática Kumon
\end{enumerate}

\section{Material do Aluno}
\begin{enumerate}[leftmargin=2cm]
  \item Este livro didático (exemplar do aluno)
  \item Caderno de caligrafia (pauta larga)
  \item Lápis grafite (HB)
  \item Borracha
  \item Lápis de cor (12 cores)
  \item Folhas de prática Kumon (reproduzidas pelo professor)
  \item Caderno de registro de progresso
\end{enumerate}

%% ============================================================

\chapter{Estratégias de Diferenciação --- 2º Ano}

\section{Para Alunos que Precisam de Mais Apoio}
\begin{enumerate}[leftmargin=2cm]
  \item Retornar a exercícios de sílabas diretas do 1º ano
  \item Usar materiais concretos (letras de scrapy, magneticos)
  \item Trabalhar em grupos menores (2--3 alunos)
  \item Fornecer folhas de reforço adicionais
  \item Permitir mais tempo para cada atividade
\end{enumerate}

\section{Para Alunos Avançados}
\begin{enumerate}[leftmargin=2cm]
  \item Introduzir sílabas indiretas (AM, EM, IM, OM, UM)
  \item Propor escrita espontânea de textos curtos
  \item Desafios de leitura com palavras mais longas
  \item Incentivar a criação de histórias simples
\end{enumerate}

%% ============================================================

\chapter{Atividades Complementares --- 2º Ano}

\section{Jogos Educacionais}

\subsection{Jogo da Memória de Sílabas}
\begin{itemize}[leftmargin=2cm]
  \item Material: 30 cartões com sílabas (CA, CE, CI, CO, CU, etc.)
  \item Regra: Virar dois cartões; se formarem par de sílabas iguais, permanecem virados
  \item Objetivo: Encontrar todos os pares
\end{itemize}

\subsection{Caça-Palavras com Sílabas}
\begin{itemize}[leftmargin=2cm]
  \item Material: Grade com letras e lista de palavras
  \item Regra: Encontrar e circular palavras na grade
  \item Objetivo: Encontrar todas as palavras antes do tempo
\end{itemize}

\subsection{Bingo de Sílabas}
\begin{itemize}[leftmargin=2cm]
  \item Material: 20 cartões de bingo com sílabas
  \item Regra: Professor sorteia sílabas; aluno marca no cartão
  \item Objetivo: Completar linha, coluna ou diagonal
\end{itemize}

\section{Atividades em Sala de Aula}

\subsection{Roda de Leitura}
\begin{itemize}[leftmargin=2cm]
  \item Frequência: Diária (15 minutos)
  \item Formato: Professor lê em voz alta; alunos acompanham
  \item Material: Livros de imagens com texto simples
\end{itemize}

\subsection{Painel de Palavras}
\begin{itemize}[leftmargin=2cm]
  \item Frequência: Semanal
  \item Formato: Criar um painel com palavras novas da semana
  \item Material: Cartolinas, revistas, tesoura, cola
\end{itemize}

\subsection{Teatro de Frases}
\begin{itemize}[leftmargin=2cm]
  \item Frequência: Quinzenal
  \item Formato: Apresentar cenas com frases simples
  \item Material: Cartões com frases, cenário simples
\end{itemize}

%% ============================================================

\chapter{Orientações para Famílias --- 2º Ano}

\section{Como Ajudar em Casa}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Leia para a criança}: Todos os dias, pelo menos 15 minutos
  \item \textbf{Pratique sílabas}: Peça que a criança leia palavras em placas, embalagens
  \item \textbf{Escreva junto}: Ajude a criança a escrever nomes, frases simples
  \item \textbf{Visite bibliotecas}: Leve a criança a livrarias e bibliotecas
  \item \textbf{Valorize o esforço}: Elogie a dedicação, não apenas o resultado
  \item \textbf{Comunique-se com a escola}: Participe das reuniões e acompanhe o progresso
\end{enumerate}

\section{Atividades para Família}
\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Jogo do alfabeto}: Encontrar letras em embalagens, revistas, placas
  \item \textbf{Cozinha educativa}: Receitas com palavras que contêm letras estudadas
  \item \textbf{Passeios}: Identificar letras em placas de rua, outdoors, etc.
  \item \textbf{Leitura compartilhada}: Ler juntos e conversar sobre a história
\end{enumerate}
