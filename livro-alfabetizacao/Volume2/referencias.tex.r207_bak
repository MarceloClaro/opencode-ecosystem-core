\chapter{Glossário de Termos Técnicos}

\begin{description}[leftmargin=2cm, style=nextline]
  \item[Alfabetização] Processo de aprendizagem da leitura e da escrita.
  \item[BNCC] Base Nacional Comum Curricular.
  \item[CAEd] Centro de Avaliação Educacional.
  \item[Consciência Fonológica] Habilidade de perceber e manipular os sons da língua oral.
  \item[Decodificação] Processo de converter letras em sons para ler palavras.
  \item[Fonema] Unidade mínima de som da fala.
  \item[Grafema] Representação gráfica de um fonema (letra).
  \item[Letramento] Capacidade de usar a leitura e a escrita na vida cotidiana.
  \item[Sílaba direta] Sílaba formada por consoante + vogal (ex: MA, CE).
  \item[Sílaba indireta] Sílaba formada por vogal + consoante (ex: AM, ES).
  \item[SPAECE] Sistema Permanente de Avaliação da Educação Básica do Ceará.
\end{description}
