\chapter{As Consonantes do Bloco 2}

\section{Grupo 1 --- Consonantes Oclusivas}

\boq{C}{%
  Boca ENTREABERTA\\
  Parte de trás da boca toca o céu\\
  Som: ``K'' (antes de a, o, u) ou ``S'' (antes de e, i)\\
  Exemplos: casa, cesto, copo
}

\vspace{1em}

\boq{D}{%
  Boca ENTREABERTA\\
  Língua toca atrás dos dentes superiores\\
  Som: ``D-D-D'' (sonora)\\
  Exemplos: dente, dado, dedo
}

\vspace{1em}

\boq{P}{%
  Boca FECHADA\\
  Ar sai pela boca com força\\
  Som: ``P-P-P'' (sorda)\\
  Exemplos: pato, pedra, pau
}

\section{Grupo 2 --- Consonantes Nasais e Laterais}

\boq{N}{%
  Boca ENTREABERTA\\
  Língua toca o céu da boca (nasal)\\
  Som: ``NNN-NNN''\\
  Exemplos: navio, nota, nabo
}

\vspace{1em}

\boq{B}{%
  Boca FECHADA\\
  Ar sai pela boca (sonora)\\
  Som: ``BBB-BBB''\\
  Exemplos: bola, boi, boné
}

\vspace{1em}

\boq{G}{%
  Boca ENTREABERTA\\
  Parte de trás da boca toca o céu\\
  Som: ``G-G-G'' (antes de a, o, u) ou ``J'' (antes de e, i)\\
  Exemplos: gato, gelo, gol
}

\section{Grupo 3 --- Consonantes Fricativas}

\boq{F}{%
  Boca ENTREABERTA\\
  Dentes superiores tocam o lábio inferior\\
  Som: ``FFF-FFF''\\
  Exemplos: fogo, fogo, feira
}

\vspace{1em}

\boq{V}{%
  Boca ENTREABERTA\\
  Dentes superiores tocam o lábio inferior (sonora)\\
  Som: ``VVV-VVV''\\
  Exemplos: vaso, vento, viagem
}

