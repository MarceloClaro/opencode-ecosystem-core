\chapter{Sílabas Diretas --- Consolidação}

\section{Sistema Completo de Sílabas Diretas}

Com todas as letras dos blocos 1 e 2, o aluno agora domina:

\begin{center}
\begin{tabular}{ccccccccc}
\sil{M}{A} & \sil{S}{A} & \sil{T}{A} & \sil{R}{A} & \sil{L}{A} & \sil{C}{A} & \sil{D}{A} & \sil{P}{A} & \sil{N}{A} \\
\sil{M}{E} & \sil{S}{E} & \sil{T}{E} & \sil{R}{E} & \sil{L}{E} & \sil{C}{E} & \sil{D}{E} & \sil{P}{E} & \sil{N}{E} \\
\sil{M}{I} & \sil{S}{I} & \sil{T}{I} & \sil{R}{I} & \sil{L}{I} & \sil{C}{I} & \sil{D}{I} & \sil{P}{I} & \sil{N}{I} \\
\sil{M}{O} & \sil{S}{O} & \sil{T}{O} & \sil{R}{O} & \sil{L}{O} & \sil{C}{O} & \sil{D}{O} & \sil{P}{O} & \sil{N}{O} \\
\sil{M}{U} & \sil{S}{U} & \sil{T}{U} & \sil{R}{U} & \sil{L}{U} & \sil{C}{U} & \sil{D}{U} & \sil{P}{U} & \sil{N}{U} \\
\end{tabular}
\end{center}

\section{Regras de Separação Silábica}

\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Separar pela análise da estrutura da palavra}
  \item \textbf{Cada sílaba deve ter obrigatoriamente uma vogal}
  \item \textbf{Encontros consonantais são separados} (ex: BOLA $\rightarrow$ BO-LA)
  \item \textbf{Dígrafos ficam na mesma sílaba} (ex: CHAVE $\rightarrow$ CHA-VE)
\end{enumerate}

