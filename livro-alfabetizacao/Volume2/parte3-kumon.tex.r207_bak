V2-A-02 & Silábico & D1-D5 (Leitura de palavras, frases e textos; produção de texto; conhecimento gramatical) & EF02LP01 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item \textcolor{success}{$\bullet$} Circular todas as letras ``B'':
  \begin{center}
  \fbox{B}OLA \quad \fbox{B}OI \quad \fbox{B}ONÉ \quad \fbox{B}AÚ
  \end{center}
  
  \item \textcolor{success}{$\bullet$} Formar sílabas:
  \begin{center}
  \sil{B}{A} \quad \sil{B}{E} \quad \sil{B}{I} \quad \sil{B}{O} \quad \sil{B}{U}
  \end{center}
  
  \item \textcolor{success}{$\bullet$} Separar palavras:
  \begin{center}
  BOLA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  BAÚ $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item \textcolor{accent}{$\bullet$} Completar:
  \begin{center}
  \underline{B}ola \quad \underline{B}aú \quad \underline{B}oné
  \end{center}
  
  \item \textcolor{accent}{$\bullet$} Ler para o professor:
  \begin{center}
  $\rightarrow$ BA --- BE --- BI --- BO --- BU\\
  $\rightarrow$ BOLA --- BAÚ --- BONÉ
  \end{center}
  
  \item \textcolor{secondary}{$\bullet$} Escrever uma frase:
  \begin{center}
  \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Folha 2.7 --- Formação de Palavras}

\begin{exercicio}[Folha de Prática 2.7 --- Formação de Palavras]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{SPAECE} \\
\hline
V2-A-03 & Silábico-Alfabético & D1-D5 (Leitura de palavras, frases e textos; produção de texto; conhecimento gramatical) & EF02LP01, EF02LP02 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item \textcolor{success}{$\bullet$} Formar palavras com sílabas:
  \begin{center}
  \begin{tabular}{ccc}
  CA + SA = \underline{\hspace{2cm}} & 
  BO + LA = \underline{\hspace{2cm}} &
  GA + TO = \underline{\hspace{2cm}} \\[1em]
  DE + DO = \underline{\hspace{2cm}} & 
  PA + TO = \underline{\hspace{2cm}} &
  FO + GO = \underline{\hspace{2cm}}
  \end{tabular}
  \end{center}
  
  \item \textcolor{success}{$\bullet$} Separar palavras em sílabas:
  \begin{center}
  \begin{tabular}{ccc}
  DENTE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} & 
  NAVE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} &
  VASO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \\[1em]
  CABELO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} & 
  BONITO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} &
  CADEIRA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{tabular}
  \end{center}
  
  \item \textcolor{accent}{$\bullet$} Ler palavras:
  \begin{center}
  $\rightarrow$ casa \quad dente \quad pato \quad nave \quad bola \quad gato \quad fogo \quad vaso
  \end{center}
  
  \item \textcolor{accent}{$\bullet$} Ler frases:
  \begin{center}
  $\rightarrow$ O gato mia.\\
  $\rightarrow$ A menina pula.\\
  $\rightarrow$ O menino corre.
  \end{center}
  
  \item \textcolor{secondary}{$\bullet$} Escrever 3 frases:
  \begin{center}
  1. \underline{\hspace{8cm}}\\
  2. \underline{\hspace{8cm}}\\
  3. \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

