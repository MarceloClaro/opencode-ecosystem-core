\chapter{Revisões Semanais --- Volume 2}

\section{Revisão Semanal 1}

\begin{exercicio}[Revisão Semanal 1 --- Letras C, D, P]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{SPAECE} \\
\hline
V2-R-01 & Revisão & D1-D5 (Leitura de palavras, frases e textos; produção de texto; conhecimento gramatical) & EF02LP01, EF02LP02 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Formar sílabas:
  \begin{center}
  \begin{tabular}{ccccc}
  \sil{C}{A} & \sil{C}{E} & \sil{C}{I} & \sil{C}{O} & \sil{C}{U} \\
  \sil{D}{A} & \sil{D}{E} & \sil{D}{I} & \sil{D}{O} & \sil{D}{U} \\
  \sil{P}{A} & \sil{P}{E} & \sil{P}{I} & \sil{P}{O} & \sil{P}{U} \\
  \end{tabular}
  \end{center}
  
  \item Separar palavras:
  \begin{center}
  CASA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  DENTE $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  PATO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item Ler palavras:
  \begin{center}
  $\rightarrow$ casa \quad dente \quad pato \quad copo \quad dado \quad pedra
  \end{center}
  
  \item Ler frases:
  \begin{center}
  $\rightarrow$ O gato mia.\\
  $\rightarrow$ A menina pula.\\
  $\rightarrow$ O menino corre.
  \end{center}
  
  \item Avaliação diagnóstica:
  \begin{center}
  $\square$ Forma todas as sílabas\\
  $\square$ Separa palavras corretamente\\
  $\square$ Lê com fluência\\
  $\square$ Escreve frases simples
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Revisão Semanal 4 --- Consolidação}

\begin{exercicio}[Revisão Semanal 4 --- Consolidação Volume 2]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/10

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{SPAECE} \\
\hline
V2-R-02 & Revisão & D1-D5 (Leitura de palavras, frases e textos; produção de texto; conhecimento gramatical) & EF02LP01, EF02LP02 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item Formar sílabas com todas as consonantes:
  \begin{center}
  \begin{tabular}{ccccc}
  \sil{C}{A} & \sil{D}{A} & \sil{P}{A} & \sil{N}{A} & \sil{B}{A} \\
  \sil{G}{A} & \sil{F}{A} & \sil{V}{A} & \sil{M}{A} & \sil{S}{A} \\
  \sil{T}{A} & \sil{R}{A} & \sil{L}{A} & \sil{C}{E} & \sil{D}{E} \\
  \end{tabular}
  \end{center}
  
  \item Separar palavras de 2 e 3 sílabas:
  \begin{center}
  CASA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  CABELO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  BONITO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item Ler palavras e frases:
  \begin{center}
  $\rightarrow$ casa \quad dente \quad pato \quad nave \quad bola\\
  $\rightarrow$ O gato mia. \quad A menina pula.
  \end{center}
  
  \item Escrever 5 frases simples:
  \begin{center}
  1. \underline{\hspace{8cm}}\\
  2. \underline{\hspace{8cm}}\\
  3. \underline{\hspace{8cm}}\\
  4. \underline{\hspace{8cm}}\\
  5. \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}
