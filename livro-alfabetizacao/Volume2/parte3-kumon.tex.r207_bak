%% PARTE III — EXERCÍCIOS KUMON (Volume 2)
%% ============================================================

\chapter{Exercícios Kumon --- 2º Ano}

\section{Progressão Granular --- 2º Ano}

No 2º ano, a progressão Kumon avança para:

\begin{enumerate}[leftmargin=2cm]
  \item \textbf{Nível 1}: Sílabas diretas com novas consonantes (C, D, P, N, B, G, F, V)
  \item \textbf{Nível 2}: Formação de palavras com 2 sílabas
  \item \textbf{Nível 3}: Formação de palavras com 3 sílabas
  \item \textbf{Nível 4}: Leitura de frases simples
  \item \textbf{Nível 5}: Produção de frases simples
\end{enumerate}

%% ============================================================

\chapter{Folhas de Prática --- Volume 2}

\section{Folha 2.1 --- Letra C}

\begin{exercicio}[Folha de Prática 2.1 --- Letra C]
\noindent\textbf{Nome:} \underline{\hspace{4cm}} \quad \textbf{Nota:} \underline{\hspace{1cm}}/6

\vspace{0.3em}
\begin{center}
\small
\begin{tabular}{|l|l|l|l|}
\hline
\textbf{Código Kumon} & \textbf{Nível} & \textbf{CAEd} & \textbf{SPAECE} \\
\hline
V2-A-01 & Silábico & D1-D5 (Leitura de palavras, frases e textos; produção de texto; conhecimento gramatical) & EF02LP01 \\
\hline
\end{tabular}
\end{center}
\vspace{0.3em}

\begin{enumerate}
  \item \textcolor{success}{$\bullet$} Circular todas as letras ``C'':
  \begin{center}
  \fbox{C}A \fbox{C}E \fbox{C}I \fbox{C}O \fbox{C}U
  \end{center}
  
  \item \textcolor{success}{$\bullet$} Formar sílabas:
  \begin{center}
  \sil{C}{A} \quad \sil{C}{E} \quad \sil{C}{I} \quad \sil{C}{O} \quad \sil{C}{U}
  \end{center}
  
  \item \textcolor{success}{$\bullet$} Separar palavras:
  \begin{center}
  CASA $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}} \quad 
  CESTO $\rightarrow$ \underline{\hspace{1.5cm}} \underline{\hspace{1.5cm}}
  \end{center}
  
  \item \textcolor{accent}{$\bullet$} Completar:
  \begin{center}
  \underline{C}asa \quad \underline{C}esto \quad \underline{C}opo
  \end{center}
  
  \item \textcolor{accent}{$\bullet$} Ler para o professor:
  \begin{center}
  $\rightarrow$ CA --- CE --- CI --- CO --- CU\\
  $\rightarrow$ CASA --- CESTO --- COPO
  \end{center}
  
  \item \textcolor{secondary}{$\bullet$} Escrever uma frase:
  \begin{center}
  \underline{\hspace{8cm}}
  \end{center}
\end{enumerate}
\end{exercicio}

\section{Folha 2.4 --- Letra B}

\begin{exercicio}[Folha de Prática 2.4 --- Letra B]
