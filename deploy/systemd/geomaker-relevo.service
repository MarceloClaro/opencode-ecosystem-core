[Unit]
Description=Geomaker Relevo Node backend (porta local 8083)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=simple
User=marceloclaro
Group=marceloclaro
WorkingDirectory=/opt/geomaker/site
Environment=HOME=/home/marceloclaro
ExecStart=/usr/bin/node /opt/geomaker/site/relevo-server.cjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
TasksMax=32
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
