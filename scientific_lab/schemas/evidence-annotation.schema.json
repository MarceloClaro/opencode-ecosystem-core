{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"EvidenceAnnotation v1.0","type":"object","additionalProperties":false,
  "required":["schema_version","annotation_id","project_id","claim_id","study_id","relation","locator","excerpt_or_paraphrase","verification_status","annotator","created_at"],
  "properties":{"schema_version":{"const":"1.0"},"annotation_id":{"type":"string","pattern":"^EANN-[A-Fa-f0-9]{8,16}$"},"project_id":{"type":"string"},"claim_id":{"type":"string","pattern":"^CLAIM-[A-Za-z0-9._-]+$"},"claim_text":{"type":["string","null"]},"study_id":{"type":"string"},"relation":{"enum":["supports","contradicts","qualifies","method_for","dataset_for","replicates","fails_to_replicate"]},"locator":{"type":"string","minLength":1},"excerpt_or_paraphrase":{"type":"string","minLength":1},"verbatim":{"type":"boolean"},"source_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"verification_status":{"enum":["candidate","verified","rejected"]},"annotator":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"limitations":{"type":"array","items":{"type":"string"}}},
  "allOf":[{"if":{"properties":{"verification_status":{"const":"verified"}}},"then":{"properties":{"annotator":{"type":"string","minLength":2},"source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}]
}
