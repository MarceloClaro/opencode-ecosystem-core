{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"PrismaFlow v1.0","type":"object","additionalProperties":false,
  "required":["schema_version","flow_id","protocol_id","generated_at","identification","screening","included","reporting_standard","human_verified"],
