  "key": "fbfe6ef84f13298abe01a64eaab559e622cc71a1c7c36c0ed696f2ef0e82b11a",
  "source_sha256": "093bd6a96be62b22279c3a2c6adff50c87cecb69d620a2dac0f23350c09f06d7",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.62,
      "end": 2.08,
      "text": "Bunu getirmiştim ben sana."
    },
    {
      "start": 6.15,
      "end": 7.15,
      "text": "Ne oldu buna böyle ya?"
    },
    {
      "start": 7.25,
      "end": 10.41,
      "text": "Kuru temizlemeye götürdüm ama rengi attı sanırım kusura bakma."
    },
    {
      "start": 10.65,
      "end": 12.83,
      "text": "Yok ya onun orijinal rengidir."
    },
    {
      "start": 13.01,
      "end": 14.49,
      "text": "Pislikten koyulaşmıştır o."
    },
    {
      "start": 17.25,
      "end": 19.35,
      "text": "Neyse tam zamanında oldu iyi de oldu."
    },
    {
      "start": 19.69,
      "end": 21.03,
      "text": "Ben de banyo yapmıştım."
    },
    {
      "start": 21.39,
      "end": 21.93,
      "text": "Temiz temiz."
    },
    {
      "start": 22.15,
      "end": 24.01,
      "text": "Zahmet olmuş yormuştur seni banyo."
    },
    {
      "start": 24.13,
      "end": 24.61,
      "text": "Bak şimdi."
    },
    {
      "start": 28.83,
      "end": 29.85,
      "text": "O zaman ben..."
    },
    {
      "start": 29.85,
      "end": 31.91,
      "text": "O zaman sen gel otur abla bir çayımızı falan iç."
    },
    {
      "start": 32.17,
      "end": 33.89,
      "text": "Yok açmaz onu bu ortam."
    },
    {
      "start": 33.89,
      "end": 36.19,
      "text": "Kokar şimdi bizim ev ona."
    },
    {
      "start": 37.73,
      "end": 39.87,
      "text": "Bir zahmet camları aç daha havalandır o zaman."
    },
    {
      "start": 42.91,
      "end": 44.29,
      "text": "İçkileri kaldırın gençler."
    },
    {
      "start": 44.45,
      "end": 45.35,
      "text": "Dokunuyor kendisine."
    },
    {
      "start": 46.11,
      "end": 47.67,
      "text": "Bu arada sen şöyle mi geçsen?"
    },
    {
      "start": 49.57,
      "end": 52.59,
      "text": "Evimizin en temiz ve en yeni eşyası olur da kendisi."
    },
    {
      "start": 53.33,
      "end": 54.07,
      "text": "Çok da rahat."
    },
    {
      "start": 55.05,
      "end": 56.03,
      "text": "Senin gözüne ne oldu lan?"
    },
    {
      "start": 56.55,
      "end": 57.99,
      "text": "Çarptı ya tahtayı kafeyi."
    },
    {
      "start": 58.25,
      "end": 59.21,
      "text": "Pus koy dedim değil mi sana?"
    },
    {
      "start": 60.25,
      "end": 62.07,
      "text": "Aynen ya geçer oğlum bir şey olmasın."
    },
    {
      "start": 63.73,
      "end": 65.25,
      "text": "Neyse tanıştırayım."
    },
    {
      "start": 65.25,
      "end": 65.87,
      "text": "Umut."
    },
    {
      "start": 66.23,
      "end": 68.21,
      "text": "Memnun oldum."
    },
    {
      "start": 68.27,
      "end": 68.73,
      "text": "Asi."
    },
    {
      "start": 70.55,
      "end": 71.75,
      "text": "Bu da kesin."
    },
    {
      "start": 72.47,
      "end": 73.25,
      "text": "Memnun oldum."
    },
    {
      "start": 73.57,
      "end": 74.73,
      "text": "Ben de çok memnun oldum."
    },
    {
      "start": 76.21,
      "end": 76.55,
      "text": "Rüya."
    }
  ],
