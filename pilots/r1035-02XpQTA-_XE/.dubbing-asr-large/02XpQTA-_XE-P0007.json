  "segments": [
    {
      "start": 0.05,
      "end": 2.39,
      "text": "Tamam zaten saat de çok geç oldu."
    },
    {
      "start": 2.69,
      "end": 3.87,
      "text": "Alız'ı da al eve dönün lütfen."
    },
    {
      "start": 4.13,
      "end": 5.95,
      "text": "Tamam bak hadi yat sen lütfen tamam mı?"
    },
    {
      "start": 6.49,
      "end": 7.95,
      "text": "Bak Alas sana emanet ona göre."
    },
    {
      "start": 9.75,
      "end": 11.59,
      "text": "Tamam Alas bana emanet tamam."
    },
    {
      "start": 12.17,
      "end": 12.97,
      "text": "Hadi iyi geceler."
    },
    {
      "start": 28.72,
      "end": 30.06,
      "text": "Ne eylemesi bu saatte?"
    },
    {
      "start": 30.72,
      "end": 33.14,
      "text": "Ya şeytan diyor git şunları kollarından tut getir eve."
    },
    {
      "start": 34.04,
      "end": 35.44,
      "text": "Büyüdüler onlar kuzum."
    },
    {
      "start": 36.02,
      "end": 38.38,
      "text": "Bakarlar başlarının çaresini yapma."
    },
    {
      "start": 38.38,
      "end": 46.53,
      "text": "Ali de büyümüş müdür Feride abla?"
    },
    {
      "start": 47.05,
      "end": 52.54,
      "text": "Ali'ye sahip çıkamadım."
    },
    {
      "start": 54.96,
      "end": 56.64,
      "text": "Çağla ile Alız'ın da durumu ortada."
    },
    {
      "start": 56.64,
      "end": 61.08,
      "text": "Neden iyi anı olmuyor galiba?"
    }
  ],
