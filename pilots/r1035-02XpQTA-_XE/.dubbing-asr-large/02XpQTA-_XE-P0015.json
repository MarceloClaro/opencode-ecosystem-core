  "segments": [
    {
      "start": 0.11,
      "end": 1.63,
      "text": "Ne bekliyorsun yatırsana."
    },
    {
      "start": 6.39,
      "end": 6.87,
      "text": "Yavaş."
    },
    {
      "start": 7.29,
      "end": 7.97,
      "text": "Sağ ol ya."
    },
    {
      "start": 8.57,
      "end": 10.13,
      "text": "Yaşıyorduysa da öldü artık zaten."
    },
    {
      "start": 14.94,
      "end": 16.08,
      "text": "Neyse tamam gidebilirsin."
    },
    {
      "start": 17.86,
      "end": 18.78,
      "text": "Pardon bir dakika."
    },
    {
      "start": 19.44,
      "end": 20.56,
      "text": "Nerede bunun cüzdanı Rüya?"
    },
    {
      "start": 24.85,
      "end": 26.35,
      "text": "Anlaşıldığı hesaplar yine benden."
    },
    {
      "start": 26.61,
      "end": 27.35,
      "text": "Dur dur bende var."
    },
    {
      "start": 27.95,
      "end": 29.55,
      "text": "Yok yok tamam gerek yok ben hallederim."
    },
    {
      "start": 29.69,
      "end": 30.69,
      "text": "Tamam uzatma Çağla."
    },
    {
      "start": 30.91,
      "end": 32.29,
      "text": "Ya tamam bir dahakine senden olsun."
    },
    {
      "start": 32.65,
      "end": 33.69,
      "text": "Nasıl olsa akıllanmaz bu."
    },
    {
      "start": 34.09,
      "end": 34.87,
      "text": "Orası kesin."
    }
  ],
