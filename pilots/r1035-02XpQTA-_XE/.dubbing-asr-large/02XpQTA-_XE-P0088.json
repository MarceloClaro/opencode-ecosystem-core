  "language_probability": 1,
  "segments": [
    {
      "start": 0.34,
      "end": 2.46,
      "text": "Şaka mı yapıyorsun?"
    },
    {
      "start": 3.24,
      "end": 6.12,
      "text": "Yani senin yardımının yanında önemli mi bu gerçekten?"
    },
    {
      "start": 7.52,
      "end": 7.86,
      "text": "Yani."
    },
    {
      "start": 8.42,
      "end": 9.78,
      "text": "Hayatında hiç üşümedi sen değil."
    },
    {
      "start": 19.27,
      "end": 20.69,
      "text": "Umarım arkadaşın iyileşir."
    },
    {
      "start": 22.63,
      "end": 23.43,
      "text": "Arkadaşım değil."
    },
    {
      "start": 24.37,
      "end": 25.23,
      "text": "Ailem onlar benim."
    },
    {
      "start": 28.26,
      "end": 29.96,
      "text": "Peki ya gerçek aileleriniz?"
    },
    {
      "start": 30.44,
      "end": 31.74,
      "text": "Gerçek olan yanında olandır."
    },
    {
      "start": 32.52,
      "end": 33.3,
      "text": "Gerisi yalandı olan."
    },
    {
      "start": 34.74,
      "end": 36.36,
      "text": "Sokağa mı yakmışlar seni?"
    },
    {
      "start": 37.16,
      "end": 37.64,
      "text": "Kim bilir?"
    },
    {
      "start": 39.75,
      "end": 41.71,
      "text": "Pardon ben sadece anlamaya çalışıyorum."
    },
    {
      "start": 41.71,
      "end": 42.99,
      "text": "Aile insan çocuğunun neden?"
    },
    {
      "start": 43.21,
      "end": 46.63,
      "text": "Ben eğer olur da anlarsam sana anlatırım Gülüm."
    },
    {
      "start": 47.65,
      "end": 47.95,
      "text": "Olur mu?"
    },
    {
      "start": 50.42,
      "end": 51.04,
      "text": "İyi olur."
    },
    {
      "start": 53.93,
      "end": 56.97,
      "text": "Çünkü ben de babamın neden beni bırakıp katiyeni anlamaya çalışıyorum hala."
    }
  ],
