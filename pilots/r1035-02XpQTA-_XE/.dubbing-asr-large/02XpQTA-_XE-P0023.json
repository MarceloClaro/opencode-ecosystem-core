  "language_probability": 1,
  "segments": [
    {
      "start": 0.18,
      "end": 1.64,
      "text": "Umut ben sana ne demiştim?"
    },
    {
      "start": 2.56,
      "end": 3.26,
      "text": "Ne demiştin abi?"
    },
    {
      "start": 3.28,
      "end": 4.48,
      "text": "Ben sana ne demiştim o gün?"
    },
    {
      "start": 4.86,
      "end": 5.42,
      "text": "Hangi gün abi?"
    },
    {
      "start": 5.54,
      "end": 6.68,
      "text": "Adını koyduğumuz gün oğlum."
    },
    {
      "start": 7.06,
      "end": 7.8,
      "text": "Ne dedim ben sana?"
    },
    {
      "start": 8.86,
      "end": 10.04,
      "text": "Adın gibi ol kardeşim."
    },
    {
      "start": 10.66,
      "end": 11.86,
      "text": "Umudumu asla kaybetme."
    },
    {
      "start": 12.34,
      "end": 13.28,
      "text": "Aynen öyle."
    },
    {
      "start": 13.64,
      "end": 16.04,
      "text": "Peki Asi dolabı haberi yapıştırdığı gün ne dedim ben size?"
    },
    {
      "start": 16.06,
      "end": 16.78,
      "text": "Ya ne demiştin?"
    },
    {
      "start": 17.26,
      "end": 18.92,
      "text": "Malettin hepimizin sabah sabah be."
    },
    {
      "start": 19.52,
      "end": 20.66,
      "text": "O parayı bulacağız."
    },
    {
      "start": 20.96,
      "end": 27.24,
      "text": "Ve Umut'u ayağa kaldıracağız."
    },
    {
      "start": 27.24,
      "end": 39.21,
      "text": "Bu Umut'u."
    }
  ],
