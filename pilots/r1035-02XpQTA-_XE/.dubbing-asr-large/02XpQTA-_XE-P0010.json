    {
      "start": 0.62,
      "end": 6.36,
      "text": "Ne yapıyorsun ya sen orada?"
    },
    {
      "start": 7.02,
      "end": 8.24,
      "text": "Asıl senin ne işin var orada?"
    },
    {
      "start": 8.9,
      "end": 9.56,
      "text": "Pardon ya."
    },
    {
      "start": 10.48,
      "end": 12.76,
      "text": "Sokağı kirletmekten iyidir çöptür diye düşündüm ama."
    },
    {
      "start": 12.96,
      "end": 13.6,
      "text": "Çöp mü bu sence?"
    },
    {
      "start": 14.12,
      "end": 15.62,
      "text": "Bir bak işim bu benim."
    },
    {
      "start": 17.16,
      "end": 19.04,
      "text": "Tamam neyse parası veririz nedir yani?"
    },
    {
      "start": 19.4,
      "end": 21.48,
      "text": "Ya bir git ya gözünü seveyim."
    },
    {
      "start": 23.69,
      "end": 24.77,
      "text": "Allah'ın yabanisi."
    },
    {
      "start": 24.77,
      "end": 28.91,
      "text": "Ha bu arada erkek arkadaşına söyle."
    },
    {
      "start": 31.6,
      "end": 32.72,
      "text": "Buralarda soyunanı öperler."
    },
    {
      "start": 32.72,
