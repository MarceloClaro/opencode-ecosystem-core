      "text": "Bana bir bak."
    },
    {
      "start": 54.02,
      "end": 56.04,
      "text": "Bak bizi burada kestiler kimsenin haberi olmaz."
    },
    {
      "start": 56.5,
      "end": 58.6,
      "text": "Ne olur giyin artık eve gitmek istiyorum ya."
    },
    {
      "start": 58.6,
