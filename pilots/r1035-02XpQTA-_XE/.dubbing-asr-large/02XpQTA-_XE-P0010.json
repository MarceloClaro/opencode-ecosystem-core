      "text": "Öperler."
    },
    {
      "start": 38.04,
      "end": 41.14,
      "text": "Saçmalama saçmalama giy şunların sıra ne yapıyorsun ya?"
    },
    {
      "start": 41.3,
      "end": 42.06,
      "text": "Geçmiş olsun."
    },
    {
      "start": 42.7,
      "end": 43.9,
      "text": "Allah'ın kendine gel."
    },
    {
      "start": 43.96,
      "end": 45.04,
      "text": "Bana bir bak."
    },
    {
