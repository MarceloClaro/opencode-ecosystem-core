  "key": "451fb458aabcfe950fae1e9e79fa2069bb37bbdcd6ea8fa6dcc997054e5c6013",
  "source_sha256": "7f1acd49478029ef8cd8bbdecd4a96b0fc2d2f16a9e6d3e6ceb63c7382ee9bd8",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.18,
      "end": 2.4,
      "text": "Çocuk yürüyemiyordu Serhan ne yapsaydım?"
    },
    {
      "start": 4.53,
      "end": 5.21,
      "text": "Oldu."
    },
    {
      "start": 6.41,
      "end": 7.47,
      "text": "Böyle mi yapacağız?"
    },
    {
      "start": 7.77,
      "end": 9.91,
      "text": "Bunlar taşkınlık yaptıkça biz böyle alkışlayacağız mı?"
    },
    {
      "start": 9.97,
      "end": 10.91,
      "text": "Aferin çocuklar diyeceğiz."
    },
    {
      "start": 11.01,
      "end": 12.63,
      "text": "İstersen bir de ödüllendirelim para verelim."
    },
    {
      "start": 13.39,
      "end": 16.17,
      "text": "Al çocuğumuz zıkkımlandı daha sonra gel yine benim başıma musallat ol."
    },
    {
      "start": 16.27,
      "end": 16.75,
      "text": "Öyle mi diyelim?"
    },
    {
      "start": 18.15,
      "end": 22.95,
      "text": "Bizden aldığı parayla senin tabirinle bir şeyler zıkkımlanan o çocuklar değil."
    },
    {
      "start": 23.21,
      "end": 24.23,
      "text": "Bizim kendi oğlumuz."
    },
    {
      "start": 25.53,
      "end": 26.51,
      "text": "Bin dolar istedi benden."
    },
    {
      "start": 27.85,
      "end": 28.67,
      "text": "Ne kadar istiyorsa."
    },
    {
      "start": 28.67,
      "end": 30.45,
      "text": "Ne kadar lazımsa dedim."
    },
    {
      "start": 31.49,
      "end": 32.45,
      "text": "Bin dolar dedi."
    },
    {
      "start": 33.77,
      "end": 36.43,
      "text": "Ve o çocuk o parayla yemedi içmedi."
    },
    {
      "start": 36.79,
      "end": 40.41,
      "text": "O parayla koşa koşa bizim hastanemizde dolandırılmaya geldi."
    },
    {
      "start": 40.51,
      "end": 43.45,
      "text": "Ha dolandırılmaya geldi çok güzel bizim hastanemizde bravo."
    },
    {
      "start": 43.63,
      "end": 44.25,
      "text": "Ya ne peki?"
    },
    {
      "start": 44.77,
      "end": 47.75,
      "text": "Mucize doktormuş abrakadabra hokus pokus ne yapacaksın acaba?"
    },
    {
      "start": 48.43,
      "end": 50.73,
      "text": "Yok ya ben yaranamayacağım size ne sana ne babana."
    },
    {
      "start": 53.46,
      "end": 54.4,
      "text": "Gece gündüz buradayım ben."
    },
    {
      "start": 55.64,
      "end": 56.12,
      "text": "Çalışıyorum."
    },
    {
      "start": 57.1,
      "end": 58.3,
      "text": "Yeri geliyor uyumadan çalışıyorum."
    },
    {
      "start": 59.58,
      "end": 63.3,
      "text": "Babanın kurduğu imparatorluk nasıl hala ayakta acaba hiç düşünmüyorum."
    },
    {
      "start": 63.34,
      "end": 63.84,
      "text": "Düşündün mü?"
    },
    {
      "start": 65.22,
      "end": 69.58,
      "text": "Baba kız bitmeyen hayır işleriniz hangi paralarla yapılıyor?"
    },
    {
      "start": 72.02,
      "end": 74.58,
      "text": "Ve bu para nedense hiç bitmiyor neden acaba?"
    },
    {
      "start": 74.94,
      "end": 76.38,
      "text": "Nereden geliyor bu değil mi nesiyo?"
    },
    {
      "start": 77.02,
      "end": 77.52,
      "text": "Hiç düşündün mü?"
    },
    {
      "start": 78.86,
      "end": 81.58,
      "text": "Saçtığınız parayı yerine koyduğum için ben kötü oluyorum."
    },
    {
      "start": 81.84,
      "end": 83.34,
      "text": "Siz hayırsever oluyorsunuz öyle mi?"
    },
    {
      "start": 83.34,
      "end": 83.84,
      "text": "Hadi be."
    },
    {
      "start": 84.74,
      "end": 86.22,
      "text": "Serhan sen neyi anlamıyorsun?"
    }
  ],
