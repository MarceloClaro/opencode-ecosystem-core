  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.85,
      "end": 6.24,
      "text": "Hakaret."
    },
    {
      "start": 20.57,
      "end": 21.29,
      "text": "Bana bak."
    },
    {
      "start": 21.73,
      "end": 24.07,
      "text": "Ne yapıp ne edip beni bu durumdan kurtaracaksın duydun mu beni?"
    },
    {
      "start": 24.13,
      "end": 25.11,
      "text": "Ben kan falan vermeyeceğim."
    },
    {
      "start": 25.43,
      "end": 27.77,
      "text": "Sana ne oluyor ya sen ne saklıyorsun döküsene."
    },
    {
      "start": 29.29,
      "end": 30.05,
      "text": "Anne."
    },
    {
      "start": 30.59,
      "end": 31.23,
      "text": "Geçin arabaya."
    },
    {
      "start": 31.95,
      "end": 32.87,
      "text": "Anne bir konuşsak mı?"
    },
    {
      "start": 33.47,
      "end": 34.41,
      "text": "Dedem bakıyor."
    },
    {
      "start": 34.91,
      "end": 37.93,
      "text": "Sebebini açıklayabileceksen sabaha kadar tartışabilirim seninle."
    },
    {
      "start": 38.37,
      "end": 38.89,
      "text": "Geç arabaya."
    },
    {
      "start": 39.91,
      "end": 42.27,
      "text": "Ablacım abicim sana da günaydın."
    },
    {
      "start": 42.57,
      "end": 44.27,
      "text": "Evet yine ölmedim çok iyiyim."
    },
    {
      "start": 44.27,
      "end": 45.89,
      "text": "Gece iner misin gene tepelerdesin."
    },
    {
      "start": 46.03,
      "end": 47.41,
      "text": "İn yorma kendini diyorum."
    },
    {
      "start": 47.41,
      "end": 48.61,
      "text": "Anne kahvaltı ne ki?"
    },
    {
      "start": 48.69,
      "end": 50.09,
      "text": "İçerisinde içmiş hadi gir içeri kızım."
    },
    {
      "start": 50.15,
      "end": 52.75,
      "text": "Anne ben artık okula geri dönmek istiyorum."
    },
    {
      "start": 54.19,
      "end": 54.81,
      "text": "Şimdi değil."
    },
    {
      "start": 55.59,
      "end": 55.95,
      "text": "Sonra."
    },
    {
      "start": 56.41,
      "end": 57.99,
      "text": "Hadi geç içeri."
    },
    {
      "start": 58.57,
      "end": 59.27,
      "text": "Geç göreyim."
    }
  ],
