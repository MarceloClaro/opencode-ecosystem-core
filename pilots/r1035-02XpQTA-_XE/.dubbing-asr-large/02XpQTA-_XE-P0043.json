  "segments": [
    {
      "start": 0.34,
      "end": 1.34,
      "text": "Nasıl yani?"
    },
    {
      "start": 1.78,
      "end": 4.22,
      "text": "Hep birlikte böyle sokağa mı atmışlar sizi?"
    },
    {
      "start": 5.18,
      "end": 7.1,
      "text": "Biz kardeşlerimizi sokaktan seçeriz."
    },
    {
      "start": 7.1,
      "end": 9.24,
      "text": "Kan bağıyla değil, can bağıyla."
    },
    {
      "start": 9.24,
      "end": 10.84,
      "text": "Bilmem anlatabildim mi?"
    },
    {
      "start": 12.92,
      "end": 14.14,
      "text": "Sen de gel al şunu."
    },
    {
      "start": 14.14,
      "end": 15.94,
      "text": "Götür yatağına geri yatır."
    },
    {
      "start": 16.42,
      "end": 18.56,
      "text": "Belli ki kafası daha yerine gelmemiş."
    },
    {
      "start": 26.4,
      "end": 28.1,
      "text": "Dua et bir daha görüşmeyelim."
    },
    {
      "start": 28.74,
      "end": 31.78,
      "text": "Ayıp ediyorsun ama her zaman bekleriz."
    },
    {
      "start": 52.13,
      "end": 53.73,
      "text": "Sen de annene dua et."
    }
  ],
