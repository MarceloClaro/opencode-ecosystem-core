  "segments": [
    {
      "start": 0.0,
      "end": 3.1,
      "text": "Çağla neredesin?"
    },
    {
      "start": 4.62,
      "end": 5.86,
      "text": "Aman delirdi ya."
    },
    {
      "start": 6.02,
      "end": 7.1,
      "text": "Delirdi bir şey kullanmış."
    },
    {
      "start": 7.1,
      "end": 8.36,
      "text": "Uyuşturucu sanırım bilmiyorum."
    },
    {
      "start": 9.28,
      "end": 11.44,
      "text": "Bilmiyorum neredeyiz bilmiyorum Çağla."
    },
    {
      "start": 12.12,
      "end": 12.94,
      "text": "Çağla çok korkuyorum."
    },
    {
      "start": 12.96,
      "end": 13.72,
      "text": "Bak bana bak."
    },
    {
      "start": 16.16,
      "end": 18.04,
      "text": "Bilmiyorum Çağla bilmiyorum."
    },
    {
      "start": 23.24,
      "end": 24.18,
      "text": "Şu kilidi açar mısın?"
    },
    {
      "start": 25.24,
      "end": 26.54,
      "text": "Bunu gerçekten keserler burada."
    },
    {
      "start": 50.18,
      "end": 51.58,
      "text": "Ben araba kullanmayı bilmiyorum."
    }
  ],
