  "language_probability": 1,
  "segments": [
    {
      "start": 0.18,
      "end": 2.58,
      "text": "Bu çocuklar hiçbirimizin umurunda değil."
    },
    {
      "start": 10.7,
      "end": 11.46,
      "text": "Hiçbirimizin."
    },
    {
      "start": 11.86,
      "end": 21.04,
      "text": "Biz sadece vicdanımızı rahatlatmaya çalışıyoruz."
    },
    {
      "start": 22.26,
      "end": 25.76,
      "text": "Bu çocuklar sokakta bize bulaşmasınlar, ayağımıza dolaşmasınlar istiyoruz."
    },
    {
      "start": 26.08,
      "end": 27.52,
      "text": "Bütün bunları onun için yapıyoruz."
    },
    {
      "start": 30.31,
      "end": 31.43,
      "text": "Hepimiz iki yüzlüyüz."
    },
    {
      "start": 49.57,
      "end": 51.69,
      "text": "Neyse lafı daha fazla uzatmak istemiyorum ben."
    },
    {
      "start": 54.07,
      "end": 57.19,
      "text": "Her sene olduğu gibi vicdanımızı rahatlatacak yardımı toparlayalım."
    },
    {
      "start": 58.07,
      "end": 60.07,
      "text": "Daha sonra da bu çocuklara Allah'a emanet edelim."
    },
    {
      "start": 60.07,
      "end": 62.82,
      "text": "Hep yaptığımız gibi."
    }
  ],
