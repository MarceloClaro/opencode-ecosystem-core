  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 1.46,
      "text": "İnanılmazsın ya."
    },
    {
      "start": 3.96,
      "end": 9.65,
      "text": "Yapma böyle ya."
    },
    {
      "start": 10.33,
      "end": 12.97,
      "text": "Kızım bir gelme ortamda bir sakin ol."
    },
    {
      "start": 13.55,
      "end": 15.55,
      "text": "Yani eğlenmeyi öğrensene biraz."
    },
    {
      "start": 15.71,
      "end": 17.57,
      "text": "Beceremiyorsan da taklit et bari."
    },
    {
      "start": 19.17,
      "end": 20.47,
      "text": "Canımı acıtıyorsun."
    },
    {
      "start": 21.71,
      "end": 23.09,
      "text": "Çağla git öte dağla."
    },
    {
      "start": 23.23,
      "end": 24.67,
      "text": "Vallahi çekilmiyorsun ya."
    },
    {
      "start": 31.52,
      "end": 33.18,
      "text": "Rüya naber nasılsın?"
    },
    {
      "start": 33.46,
      "end": 34.34,
      "text": "İyiyim senden naber?"
    },
    {
      "start": 34.46,
      "end": 35.34,
      "text": "İyiyim ben de nasıl gidiyor?"
    },
    {
      "start": 35.54,
      "end": 36.66,
      "text": "Valla güzel gidiyor."
    },
    {
      "start": 37.18,
      "end": 37.82,
      "text": "Senin nasıl gidiyor?"
    },
    {
      "start": 37.96,
      "end": 38.5,
      "text": "İyiyim ne olsun."
    },
    {
      "start": 39.22,
      "end": 39.58,
      "text": "Rüya."
    },
    {
      "start": 40.5,
      "end": 41.22,
      "text": "Haydi gidelim."
    },
    {
      "start": 42.48,
      "end": 43.0,
      "text": "Sebeb."
    },
    {
      "start": 43.36,
      "end": 44.86,
      "text": "Sebeb, sebeb, sebeb."
    },
    {
      "start": 45.72,
      "end": 46.62,
      "text": "Sıkıldım hadi."
    },
    {
      "start": 49.61,
      "end": 51.37,
      "text": "Ben de senden sıkıldım arkadaşım."
    },
    {
      "start": 56.81,
      "end": 57.13,
      "text": "Alo."
    },
    {
      "start": 57.63,
      "end": 57.99,
      "text": "Çağla."
    },
    {
      "start": 58.45,
      "end": 59.51,
      "text": "Niye telefonuna bakmıyorsun?"
    },
    {
      "start": 59.67,
      "end": 60.53,
      "text": "Saatlerdir sizi arıyorum."
    },
    {
      "start": 60.61,
      "end": 61.27,
      "text": "Aklımı kaçıracağım."
    },
    {
      "start": 62.19,
      "end": 63.73,
      "text": "Yok bir şey anne her şey yolunda."
    },
    {
      "start": 64.29,
      "end": 64.61,
      "text": "Alaz?"
    },
    {
      "start": 65.47,
      "end": 67.35,
      "text": "Alaz iyi keyfi gayet yerinde."
    },
    {
      "start": 68.55,
      "end": 69.69,
      "text": "Senin sesin bir tuhaf geliyor."
    },
    {
      "start": 70.09,
      "end": 70.75,
      "text": "Bir şey mi oldu?"
    },
    {
      "start": 71.17,
      "end": 72.71,
      "text": "Anne ne olabilir ki en fazla?"
    },
    {
      "start": 72.81,
      "end": 73.99,
      "text": "Eğleniyoruz işte sadece."
    }
  ],
