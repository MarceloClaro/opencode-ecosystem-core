  "language_probability": 1,
  "segments": [
    {
      "start": 22.83,
      "end": 24.83,
      "text": "Çocuklar niye buradaydı sabah sabah?"
    },
    {
      "start": 25.53,
      "end": 26.57,
      "text": "Neslihan'a sor."
    },
    {
      "start": 26.87,
      "end": 28.21,
      "text": "Zıvanadan çıkmış yine."
    },
    {
      "start": 29.13,
      "end": 30.17,
      "text": "Ne oldu yine?"
    },
    {
      "start": 32.22,
      "end": 34.22,
      "text": "Çocuklara uyuşturucu testi yaptıracakmış."
    },
    {
      "start": 34.46,
      "end": 36.34,
      "text": "Ay yok artık, daha neler?"
    },
    {
      "start": 37.7,
      "end": 40.26,
      "text": "Sen de niye sıkıyorsun canım, canını?"
    },
    {
      "start": 40.8,
      "end": 43.1,
      "text": "Yani bırak yaptırsın, nasıl olsa bir şey çıkmayacak."
    },
    {
      "start": 46.85,
      "end": 48.17,
      "text": "Alas pozitif çıkacak."
    },
    {
      "start": 48.65,
      "end": 50.05,
      "text": "Dün gece ilk kez denemiş."
    },
    {
      "start": 50.85,
      "end": 52.01,
      "text": "Saçmalama."
    },
    {
      "start": 54.09,
      "end": 55.57,
      "text": "O zaman belki rüya da..."
    },
    {
      "start": 55.57,
      "end": 59.45,
      "text": "...zaten son zamanlarda böyle tuhaf tuhaf bir davranışlar."
    },
    {
      "start": 59.85,
      "end": 61.13,
      "text": "Dün de deli deli hareketler."
    },
    {
      "start": 61.97,
      "end": 63.17,
      "text": "Ben de mi bir test yaptırsam?"
    },
    {
      "start": 63.47,
      "end": 65.97,
      "text": "Sakın, bir Neslihan bize yeter bile seninle uğraşmayalım."
    },
    {
      "start": 66.61,
      "end": 69.63,
      "text": "Yalnız Neslihan'la kıyaslamazsan sevinirim anneliğime."
    }
  ],
