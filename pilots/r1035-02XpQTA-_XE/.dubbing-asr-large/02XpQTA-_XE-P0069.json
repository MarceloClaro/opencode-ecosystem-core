  "segments": [
    {
      "start": 0.24,
      "end": 3.98,
      "text": "Çözdük derken bir ziyaret etti diyelim."
    },
    {
      "start": 6.05,
      "end": 8.33,
      "text": "Neyse ben belimi yıkayıp geliyorum."
    },
    {
      "start": 8.69,
      "end": 22.14,
      "text": "Nasılsın sen?"
    },
    {
      "start": 23.1,
      "end": 24.1,
      "text": "İyiyim ya yok bir şey."
    },
    {
      "start": 29.76,
      "end": 31.0,
      "text": "Oğlum birine el atsın lan."
    },
    {
      "start": 32.24,
      "end": 33.22,
      "text": "Belim koptu Cesur."
    },
    {
      "start": 34.68,
      "end": 36.34,
      "text": "Kime diyorum? Alo."
    },
    {
      "start": 40.47,
      "end": 54.74,
      "text": "Oğlum kötü bir şey mi oldu söylesene."
    },
    {
      "start": 60.33,
      "end": 62.01,
      "text": "Asi ne oluyor? Cesur nerede?"
    },
    {
      "start": 63.15,
      "end": 64.59,
      "text": "Yattı o biraz içeride."
    },
    {
      "start": 66.17,
      "end": 67.21,
      "text": "Hayırdır ya bu saatte?"
    },
    {
      "start": 67.21,
      "end": 67.77,
      "text": "Dur."
    },
    {
      "start": 67.77,
      "end": 71.09,
      "text": "Dur. Yattı çocuk."
    },
    {
      "start": 71.45,
      "end": 73.71,
      "text": "Yemek hazır olsun ben uyandırırım onu dinlensin."
    },
    {
      "start": 74.13,
      "end": 74.79,
      "text": "Bir dakika bir dakika."
    },
    {
      "start": 76.05,
      "end": 78.01,
      "text": "Bu ikisi televizyon yüzünden kavga etti değil mi?"
    }
