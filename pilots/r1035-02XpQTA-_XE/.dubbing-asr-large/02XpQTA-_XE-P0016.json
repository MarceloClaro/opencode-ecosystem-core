  "language_probability": 1,
  "segments": [
    {
      "start": 1.65,
      "end": 7.97,
      "text": "Kimsin sen?"
    },
    {
      "start": 9.69,
      "end": 10.61,
      "text": "Ne işin var evimde?"
    },
    {
      "start": 15.25,
      "end": 16.07,
      "text": "Ne demek çok içti?"
    },
    {
      "start": 16.81,
      "end": 18.01,
      "text": "Ne içti de bu hale geldi?"
    },
    {
      "start": 19.43,
      "end": 19.99,
      "text": "Bilmiyorum"
    },
    {
      "start": 19.99,
      "end": 22.13,
      "text": "Peki bu çocuk kim?"
    },
    {
      "start": 23.13,
      "end": 23.81,
      "text": "Niye benim evimde?"
    },
    {
      "start": 24.69,
      "end": 26.49,
      "text": "Başka çarem yoktu yardım istedim"
    },
    {
      "start": 26.49,
      "end": 27.73,
      "text": "O getirdi bizi eve"
    },
    {
      "start": 27.73,
      "end": 29.35,
      "text": "Rüya beni niye aramıyorsun?"
    },
    {
      "start": 30.31,
      "end": 31.51,
      "text": "Arasam hemen gelirim"
    },
    {
      "start": 31.51,
      "end": 33.49,
      "text": "Sokaktan adam toplamaya gerek var mı?"
    },
    {
      "start": 33.49,
      "end": 34.77,
      "text": "Kim bilir bu adam nedir?"
    },
    {
      "start": 34.87,
      "end": 36.69,
      "text": "Psikopat mıdır? Size bir zarar verse"
    },
    {
      "start": 36.69,
      "end": 38.89,
      "text": "Mecbur kaldım diyorum Neslihan teyze"
    },
    {
      "start": 38.89,
      "end": 40.79,
      "text": "Yoksa benim ne işim olur ya bu yabaniyle?"
    },
    {
      "start": 41.25,
      "end": 46.2,
      "text": "Ben sözü kerem"
    },
    {
      "start": 46.2,
      "end": 48.6,
      "text": "Seninle sonra hesaplaşacağız"
    },
    {
      "start": 48.6,
      "end": 52.2,
      "text": "Seni aradım eğleniyoruz her şey yolunda dedin değil mi?"
    },
    {
      "start": 52.68,
      "end": 53.5,
      "text": "Hesabını vereceksin"
    }
  ],
