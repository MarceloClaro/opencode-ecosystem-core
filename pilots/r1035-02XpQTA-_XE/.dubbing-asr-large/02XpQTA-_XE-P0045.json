  "segments": [
    {
      "start": 0.14,
      "end": 0.74,
      "text": "Tamam."
    },
    {
      "start": 1.62,
      "end": 2.4,
      "text": "Elimi öpsün o zaman."
    },
    {
      "start": 3.3,
      "end": 3.8,
      "text": "Yok ya."
    },
    {
      "start": 3.94,
      "end": 5.2,
      "text": "Öp şantep lan büyüğün o senin."
    },
    {
      "start": 5.9,
      "end": 7.12,
      "text": "Ne belli lan büyüğüm olduğu?"
    },
    {
      "start": 7.26,
      "end": 8.06,
      "text": "Kafa kağıdımız mı var?"
    },
    {
      "start": 8.16,
      "end": 9.38,
      "text": "Doğum tarihimiz mi belli sanki?"
    },
    {
      "start": 9.52,
      "end": 10.42,
      "text": "Belki benim en büyüğünüz."
    },
    {
      "start": 10.48,
      "end": 12.18,
      "text": "Akıl yaşına göre hesaplıyoruz ya canım."
    },
    {
      "start": 12.3,
      "end": 12.9,
      "text": "Unuttun galiba."
    },
    {
      "start": 13.5,
      "end": 14.76,
      "text": "O zaman benden de küçük."
    },
    {
      "start": 15.32,
      "end": 15.96,
      "text": "Bacan ha."
    },
    {
      "start": 18.34,
      "end": 19.4,
      "text": "İyi bayramlar."
    },
    {
      "start": 19.44,
      "end": 20.12,
      "text": "Ne bayramı be?"
    },
    {
      "start": 20.18,
      "end": 21.12,
      "text": "Deli Ergün bayram."
    },
    {
      "start": 24.86,
      "end": 26.6,
      "text": "Gel lan buraya gel."
    },
    {
      "start": 26.76,
      "end": 28.54,
      "text": "Tabii bugün bizim bayramımız oğlum."
    },
    {
      "start": 29.06,
      "end": 30.06,
      "text": "Umut'umuzun bayramı."
    },
    {
      "start": 30.06,
      "end": 30.8,
      "text": "Umut ne yapacak?"
    },
    {
      "start": 30.96,
      "end": 31.42,
      "text": "Ne yapacak?"
    },
    {
      "start": 31.42,
      "end": 32.12,
      "text": "Ne yapacak?"
    },
    {
      "start": 32.22,
      "end": 32.86,
      "text": "Yürüyecek."
    },
    {
      "start": 33.54,
      "end": 34.68,
      "text": "O zaman."
    },
    {
      "start": 40.8,
      "end": 63.1,
      "text": "Bin dolar."
    },
    {
      "start": 64.08,
      "end": 65.76,
      "text": "Bu mu muayene ücreti bu adamın?"
    }
  ],
