  "source_sha256": "a70c1d60ed1dfda3bdb4b99e88b2904a4fcade8fa7607be07655c2b5e85d6154",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.11,
      "end": 2.63,
      "text": "Anne bu saçmalığa artık bir son verir misin lütfen?"
    },
    {
      "start": 2.83,
      "end": 4.83,
      "text": "Gerçekten bu sefer büyük saçmalıyorsun."
    },
    {
      "start": 4.99,
      "end": 5.41,
      "text": "Günaydın."
    },
    {
      "start": 5.45,
      "end": 5.93,
      "text": "Günaydın."
    },
    {
      "start": 6.41,
      "end": 8.97,
      "text": "Ya bu üstünü falan kullandın yok benim."
    },
    {
      "start": 9.49,
      "end": 10.81,
      "text": "O zaman korkacak bir şeyin de yok."
    },
    {
      "start": 11.29,
      "end": 12.43,
      "text": "Keşke beni bir salsalar."
    },
    {
      "start": 12.81,
      "end": 13.29,
      "text": "Keşke."
    },
    {
      "start": 13.73,
      "end": 15.97,
      "text": "Anne ben Allah'ından ayrı bir canlıyım farkındasın."
    },
    {
      "start": 16.09,
      "end": 16.73,
      "text": "Ben ne yersin?"
    },
    {
      "start": 16.81,
      "end": 17.91,
      "text": "Yürü Çağla'cığım yürü."
    },
    {
      "start": 35.06,
      "end": 36.14,
      "text": "Siz kantine gidip çay için."
    },
    {
      "start": 40.57,
      "end": 41.63,
      "text": "Evet ne oluyor burada?"
    },
    {
      "start": 41.87,
      "end": 43.79,
      "text": "Annemin bir düğmesi varsa basıp durdurabilir misin?"
    },
    {
      "start": 43.87,
      "end": 44.47,
      "text": "Çünkü durmuyor."
    },
    {
      "start": 44.57,
      "end": 45.59,
      "text": "Neslihan ne yapıyorsun ne artık?"
    },
    {
      "start": 45.71,
      "end": 47.03,
      "text": "Uyuşturucu testi yapacakmış."
    },
    {
      "start": 47.15,
      "end": 47.31,
      "text": "Ne?"
    },
    {
      "start": 47.79,
      "end": 48.51,
      "text": "Bir dakika sebep?"
    },
    {
      "start": 48.51,
      "end": 53.63,
      "text": "Sebep dün gece oğlumuzun çırılçıplak bir halde bir başkasının sırtında eve gelmesi."
    },
    {
      "start": 54.21,
      "end": 56.15,
      "text": "Üstelik de bu halde."
    },
    {
      "start": 57.19,
      "end": 58.53,
      "text": "Sence yeterli bir sebep mi?"
    },
    {
      "start": 61.54,
      "end": 62.64,
      "text": "Kim yaptı oğlumun sana?"
    },
    {
      "start": 63.2,
      "end": 63.92,
      "text": "Bilmiyorum ki baba."
    },
    {
      "start": 64.0,
      "end": 65.2,
      "text": "Bir sen hesabını soracağım da."
    },
    {
      "start": 65.32,
      "end": 66.38,
      "text": "Hesap mı soracaksın?"
    }
  ],
