  "source_sha256": "ad1e3548caaa9a3ded453cb3bfcb9b244f2e245a9c46fe0939602cfc4d7d2223",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.05,
      "end": 2.35,
      "text": "Ne var be Allah Allah"
    },
    {
      "start": 2.35,
      "end": 2.71,
      "text": "Hangisi?"
    },
    {
      "start": 3.13,
      "end": 3.95,
      "text": "Şu uzun olan"
    },
    {
      "start": 3.95,
      "end": 5.43,
      "text": "Oğlum aklımıza aldın ya"
    },
    {
      "start": 5.43,
      "end": 7.07,
      "text": "Ne oldu ama?"
    },
    {
      "start": 7.27,
      "end": 8.99,
      "text": "Umrumda değiller falan ne oldu?"
    },
    {
      "start": 9.51,
      "end": 10.47,
      "text": "Tamam bekleyin burada süs"
    },
    {
      "start": 10.47,
      "end": 11.37,
      "text": "Avaz Bey"
    },
    {
      "start": 11.37,
      "end": 11.93,
      "text": "Bekleyin"
    },
    {
      "start": 11.93,
      "end": 13.57,
      "text": "Allah'ız lütfen bir huzur ver ya"
    },
    {
      "start": 13.57,
      "end": 14.57,
      "text": "Ama Avaz Bey"
    },
    {
      "start": 14.57,
      "end": 16.03,
      "text": "Ya tamam bırak karışma gitsin"
    },
    {
      "start": 16.03,
      "end": 17.85,
      "text": "Yesin de yanında rahatlasın"
    },
    {
      "start": 17.85,
      "end": 19.77,
      "text": "Durma"
    },
    {
      "start": 19.77,
      "end": 21.63,
      "text": "Sen mara dümdüz bir saksın"
    },
    {
      "start": 21.63,
      "end": 22.89,
      "text": "Ya tamam ne abarttınız be"
    },
    {
      "start": 22.89,
      "end": 24.01,
      "text": "Hadi yürüyün geç kalacağız"
    },
    {
      "start": 24.01,
      "end": 26.57,
      "text": "Sohbetiniz bittiyse şu cüzdanı alayım hadi"
    },
    {
      "start": 26.57,
      "end": 35.82,
      "text": "Anladım tamam parayı yemişsiniz"
    },
    {
      "start": 35.82,
      "end": 38.28,
      "text": "Sıkıntı yok kalpler önemli zaten"
    },
    {
      "start": 38.28,
      "end": 38.76,
      "text": "Hadi"
    },
    {
      "start": 38.76,
      "end": 47.4,
      "text": "Kostüm pek yakışmamış ama"
    },
    {
      "start": 47.4,
      "end": 49.56,
      "text": "Senin olsun kalabilir"
    },
    {
      "start": 49.56,
      "end": 51.94,
      "text": "He sen olsun"
    },
    {
      "start": 51.94,
      "end": 54.18,
      "text": "Yok yok tamam tamam"
    },
    {
      "start": 54.18,
      "end": 55.78,
      "text": "Al sen kıyafetlerini ya"
    },
    {
      "start": 55.78,
      "end": 57.02,
      "text": "Hatırası vardır oğlum"
    },
    {
      "start": 57.02,
      "end": 58.8,
      "text": "Al al kıyafetlerini oğlum"
    },
    {
      "start": 58.8,
      "end": 60.6,
      "text": "Anısı vardır sende giyer giyer"
    },
    {
      "start": 60.6,
      "end": 62.14,
      "text": "Gibi kızı nasıl bıraktın"
    },
    {
      "start": 62.14,
      "end": 64.78,
      "text": "Bir adım daha atarsan seni buraya gömerim"
    },
    {
      "start": 64.78,
      "end": 67.18,
      "text": "Abi ne olur bir gönder gelsin ne olur"
    },
    {
      "start": 67.18,
      "end": 68.28,
      "text": "Abisi?"
    },
    {
      "start": 69.04,
      "end": 69.84,
      "text": "Kardeşinin kızı?"
    },
    {
      "start": 70.32,
      "end": 70.62,
      "text": "Aynen"
    },
    {
      "start": 70.62,
      "end": 100.6,
      "text": "Altyazı M.K."
    }
  ],
