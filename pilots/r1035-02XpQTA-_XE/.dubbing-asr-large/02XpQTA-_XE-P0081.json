  "source_sha256": "9adf4e949742c395b687b439bd4387cc75c30ad6cbbce47cbb36deaad57472c0",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 0.36,
      "text": "Bakalım."
    },
    {
      "start": 1.28,
      "end": 3.26,
      "text": "Ardından yoğun bir fizyoterapi süreci."
    },
    {
      "start": 3.88,
      "end": 4.16,
      "text": "Tabii."
    },
    {
      "start": 4.94,
      "end": 6.34,
      "text": "O ne kadar sürer hocam?"
    },
    {
      "start": 6.74,
      "end": 7.44,
      "text": "İki sene kadar."
    },
    {
      "start": 7.72,
      "end": 8.56,
      "text": "İki sene kadar. Güzel."
    },
    {
      "start": 9.06,
      "end": 12.66,
      "text": "Sonuç olarak ben yapılacak bir şeyler var gibi algılıyorum."
    },
    {
      "start": 12.98,
      "end": 14.86,
      "text": "Umut var yani. Öyle diyebiliriz değil mi?"
    },
    {
      "start": 14.96,
      "end": 16.22,
      "text": "Umut var tabii. Umut hep var."
    },
    {
      "start": 19.08,
      "end": 20.56,
      "text": "Umut fakirin ekmeği neslihan."
    },
    {
      "start": 28.58,
      "end": 29.5,
      "text": "Ne yaptığını sanıyorsun?"
    },
    {
      "start": 30.58,
      "end": 31.4,
      "text": "Doktor musun sen?"
    },
    {
      "start": 31.74,
      "end": 32.82,
      "text": "Konsültasyonda ne işin var?"
    },
    {
      "start": 35.42,
      "end": 37.42,
      "text": "Al bak. Benim işim bu."
    },
    {
      "start": 37.42,
      "end": 40.74,
      "text": "Senin ısrarla devam ettirdiğin bu saçmalığın..."
    },
    {
      "start": 40.74,
      "end": 41.78,
      "text": "...ortalama maliyeti..."
    },
    {
      "start": 41.78,
      "end": 43.76,
      "text": "...bize tam 170 bin dolar."
    },
    {
      "start": 44.4,
      "end": 45.92,
      "text": "Bir insanın hayatı söz konusu."
    },
    {
      "start": 46.0,
      "end": 47.3,
      "text": "Bir çocuğun hayatı söz konusu."
    },
    {
      "start": 47.54,
      "end": 49.48,
      "text": "Ve ben doktorum. Bu yaptıklarım az bile."
    },
    {
      "start": 50.56,
      "end": 51.72,
      "text": "Az bile bir şey bu."
    },
    {
      "start": 52.5,
      "end": 53.92,
      "text": "Bulmuşlar seni yumuşak karnında."
    },
    {
      "start": 53.96,
      "end": 54.98,
      "text": "Bu çocuklar daha çok..."
    },
    {
      "start": 54.98,
      "end": 57.06,
      "text": "Bu daha başlangıç. Evet doğru."
    },
    {
      "start": 57.84,
      "end": 60.12,
      "text": "Sana mesela senin paranı mı harcıyorum ben?"
    },
    {
      "start": 62.92,
      "end": 63.7,
      "text": "Ayrıca dert etme."
    },
    {
      "start": 64.44,
      "end": 65.82,
      "text": "Bir izahat yapmak gerekirse..."
    },
    {
      "start": 65.82,
      "end": 66.64,
      "text": "...babamı ben yaparım."
    },
    {
      "start": 66.64,
      "end": 72.41,
      "text": "Bu arada..."
    }
  ],
