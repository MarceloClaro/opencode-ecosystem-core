  "language_probability": 1,
  "segments": [
    {
      "start": 1.71,
      "end": 5.91,
      "text": "Çocuk beni senden korumaya çalışıyormuş da işte ben anlamamışım."
    },
    {
      "start": 18.46,
      "end": 19.62,
      "text": "O meleği evine sen mi götürdün?"
    },
    {
      "start": 19.94,
      "end": 20.68,
      "text": "Evet efendim."
    },
    {
      "start": 21.26,
      "end": 21.74,
      "text": "Bekle beni."
    },
    {
      "start": 21.86,
      "end": 22.68,
      "text": "Tamamdır efendim."
    },
    {
      "start": 31.66,
      "end": 34.48,
      "text": "Yalnız bu kadın bayağı kanatsız melek çıktı ha."
    },
    {
      "start": 35.12,
      "end": 36.42,
      "text": "Bunun oğlu kime benzedi acaba?"
    },
    {
      "start": 36.54,
      "end": 37.74,
      "text": "Babasına falansa demek ki."
    },
    {
      "start": 39.12,
      "end": 41.26,
      "text": "Aman bunun arabası varmış ya."
    },
    {
      "start": 41.54,
      "end": 42.2,
      "text": "Allah Allah."
    },
    {
      "start": 42.22,
      "end": 43.72,
      "text": "Yapacağım rampasını beklesin."
    },
    {
      "start": 52.5,
      "end": 53.84,
      "text": "Gel gel."
    },
    {
      "start": 54.46,
      "end": 55.38,
      "text": "Gel."
    },
    {
      "start": 55.48,
      "end": 56.26,
      "text": "Dur dur bir dakika."
    },
    {
      "start": 56.34,
      "end": 57.26,
      "text": "Bir dur bir dur."
    },
    {
      "start": 57.6,
      "end": 58.56,
      "text": "Buz koy gel."
    },
    {
      "start": 59.62,
      "end": 61.26,
      "text": "Bak bu da buradan bakıyor tipini."
    },
    {
      "start": 62.54,
      "end": 64.08,
      "text": "Soyguncu çıktı ya lan bu da."
    },
    {
      "start": 65.6,
      "end": 66.28,
      "text": "Salak."
    }
  ],
