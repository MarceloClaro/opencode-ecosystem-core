  "key": "04b513553bb46eee9886456b06c6565e935ca108daac1c37a51b14e652ac7b10",
  "source_sha256": "1ed9a4f45298cb51fb15f0823745f7a3a1c2626e081a4aabe95f2b22f39f6759",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.18,
      "end": 3.66,
      "text": "Yok ama yok. Ben bunu yazdım listeye. Keseceğim bir ara hesabını."
    },
    {
      "start": 3.74,
      "end": 4.54,
      "text": "O zaman..."
    },
    {
      "start": 30.18,
      "end": 32.98,
      "text": "...yazdan kutlu."
    },
    {
      "start": 33.06,
      "end": 34.5,
      "text": "Ay ay ay."
    },
    {
      "start": 34.58,
      "end": 38.58,
      "text": "Yaş geçmiş ömre yaşam deli."
    },
    {
      "start": 38.66,
      "end": 41.86,
      "text": "Yaş satmaya bir daha."
    },
    {
      "start": 41.94,
      "end": 44.1,
      "text": "Tut defteri kitabı."
    },
    {
      "start": 44.18,
      "end": 46.82,
      "text": "Sarı çizmediğim Emed'a."
    },
    {
      "start": 46.9,
      "end": 52.26,
      "text": "Bir gün öder hesabı."
    },
    {
      "start": 53.94,
      "end": 57.3,
      "text": "Oğlum, kadın almadı parayı geri."
    },
    {
      "start": 57.38,
      "end": 59.34,
      "text": "Dedi ki bu da özrümüz olsun size."
    },
    {
      "start": 59.42,
      "end": 60.14,
      "text": "Ne diyorsun oğlum?"
    },
    {
      "start": 60.22,
      "end": 61.42,
      "text": "Bu sönme para bizim mi şimdi?"
    },
    {
      "start": 61.5,
      "end": 62.62,
      "text": "Aynen öyle."
    },
    {
      "start": 62.7,
      "end": 63.86,
      "text": "Kesin."
    },
    {
      "start": 63.94,
      "end": 65.18,
      "text": "Ne yapıyoruz peki abi?"
    },
    {
      "start": 65.26,
      "end": 66.18,
      "text": "Şey mi? Ne alıyorduk?"
    },
    {
      "start": 66.26,
      "end": 67.18,
      "text": "Yatak alalım mı yatak?"
    },
    {
      "start": 67.26,
      "end": 68.06,
      "text": "Ne diyorduk ona ya?"
    },
    {
      "start": 68.14,
      "end": 69.42,
      "text": "Rahat olan da adı neydi lan?"
    },
    {
      "start": 69.5,
      "end": 70.34,
      "text": "Ortopedik miydi? Neydi?"
    },
    {
      "start": 70.42,
      "end": 71.22,
      "text": "Çamaşır makinesi alalım."
    },
    {
      "start": 71.3,
      "end": 72.7,
      "text": "Ya bir dur kızım ya."
    },
    {
      "start": 72.78,
      "end": 74.14,
      "text": "Neyimiz var da neyimizi yıkayacağız?"
    },
    {
      "start": 74.22,
      "end": 75.86,
      "text": "Ya niye bana yıkatıyorsun o zaman?"
    },
    {
      "start": 75.94,
      "end": 76.46,
      "text": "Ha."
    },
    {
      "start": 76.54,
      "end": 78.54,
      "text": "Şoför sıcak suyumuz olur hem."
    },
    {
      "start": 78.62,
      "end": 79.38,
      "text": "Oğlum korktuk."
    },
    {
      "start": 79.46,
      "end": 80.54,
      "text": "Soğuk sudan korkumuzdan ya."
    },
    {
      "start": 80.62,
      "end": 82.42,
      "text": "Ya abi kaç kere yıkanıyoruz zaten."
    },
    {
      "start": 82.5,
      "end": 83.46,
      "text": "Alalım bir tane yatak."
    },
    {
      "start": 83.54,
      "end": 85.3,
      "text": "Rahat rahat yatalım işte."
    },
    {
      "start": 85.38,
      "end": 87.74,
      "text": "Bu yatakta yatmaktan belimiz tutuldu ya."
    },
    {
      "start": 87.74,
      "end": 89.66,
      "text": "Bak çocuğum bacaklar da tutmuyor."
    }
  ],
