    },
    {
      "start": 16.36,
      "end": 17.02,
      "text": "Say kazandım."
    },
    {
      "start": 18.76,
      "end": 19.5,
      "text": "Kime be?"
    },
    {
      "start": 20.02,
      "end": 20.22,
      "text": "Be."
    },
    {
      "start": 25.2,
      "end": 25.98,
      "text": "Hadi eve."
    },
    {
      "start": 26.44,
      "end": 26.7,
      "text": "Hadi."
    },
    {
      "start": 27.22,
      "end": 27.82,
      "text": "Baba çok sıcak."
    },
    {
      "start": 28.44,
      "end": 29.34,
      "text": "Sen de ayağa kalk."
    },
    {
      "start": 29.6,
      "end": 30.62,
      "text": "Sonra geçersin bir diye."
    },
    {
      "start": 31.02,
      "end": 31.46,
      "text": "Ne var ya?"
    },
    {
      "start": 31.54,
      "end": 32.26,
      "text": "Kafanı gözüne."
    },
    {
      "start": 32.54,
      "end": 33.32,
      "text": "Ya ne var be?"
    },
    {
      "start": 33.42,
      "end": 33.8,
      "text": "Allah Allah."
    },
    {
      "start": 33.88,
      "end": 34.4,
      "text": "Bir şey mi dedik?"
    },
    {
      "start": 35.66,
      "end": 36.32,
      "text": "Hadi hadi hadi."
    },
    {
      "start": 38.32,
      "end": 39.0,
      "text": "Gel."
    },
    {
      "start": 39.1,
      "end": 40.88,
      "text": "Abi bura bir rampa lazım."
    },
    {
      "start": 41.16,
      "end": 42.46,
      "text": "Geldim geldim."
    },
    {
      "start": 50.56,
      "end": 52.74,
      "text": "Oğlumuzun gözünü gözünü dağıtmış."
    },
    {
      "start": 53.92,
      "end": 55.54,
      "text": "Üstüne bir de para vermişsin."
    },
    {
      "start": 55.62,
      "end": 56.08,
      "text": "Ödül gibi."
    },
    {
      "start": 60.78,
      "end": 61.36,
      "text": "Yetmemiş."
    },
    {
      "start": 62.34,
      "end": 63.92,
      "text": "Çocuk kalkmış hastanemizi basmış."
    },
    {
      "start": 64.04,
      "end": 64.46,
      "text": "Serseri."
    },
    {
      "start": 65.02,
      "end": 65.76,
      "text": "Sen kalkmışsın."
    },
    {
      "start": 66.36,
      "end": 67.72,
      "text": "Arkadaşını tedavi edeceğiz falan."
    },
    {
      "start": 70.47,
      "end": 71.97,
      "text": "Dünya kadar tefrik yaptırmışsın."
    },
    {
      "start": 73.77,
