  "segments": [
    {
      "start": 1.58,
      "end": 3.76,
      "text": "Adam dünyaca ünlü bir doktor baba."
    },
    {
      "start": 4.02,
      "end": 4.32,
      "text": "Ünlü?"
    },
    {
      "start": 5.66,
      "end": 8.2,
      "text": "Neyiz biz damat? Şarkıcı mıyız? Artist miyiz?"
    },
    {
      "start": 9.44,
      "end": 11.2,
      "text": "Doktorun ünlüsü olmaz."
    },
    {
      "start": 11.72,
      "end": 12.74,
      "text": "Kabiliyetlisi olur."
    },
    {
      "start": 14.38,
      "end": 16.08,
      "text": "Bu saçmalığa derhal son vereceksin."
    },
    {
      "start": 16.94,
      "end": 18.98,
      "text": "O şovmeni de geldiği yere geri göndereceksin."
    },
    {
      "start": 19.12,
      "end": 19.86,
      "text": "Hemen derhal."
    },
    {
      "start": 20.6,
      "end": 23.58,
      "text": "O şovmen sayesinde bütçemizdeki açığı kapatıyoruz."
    },
    {
      "start": 24.94,
      "end": 25.98,
      "text": "Bilmem farkında mısınız?"
    },
    {
      "start": 26.84,
      "end": 28.8,
      "text": "Hastanenizi ayakta tutmaya çalışıyorum."
    },
    {
      "start": 28.8,
      "end": 31.34,
      "text": "Her şeye rağmen."
    },
    {
      "start": 31.8,
      "end": 32.68,
      "text": "Her şeye rağmen?"
    },
    {
      "start": 34.74,
      "end": 40.43,
      "text": "Vakıf adına sokak çocuklarına verdiğimiz amme hizmeti malum."
    },
    {
      "start": 41.81,
      "end": 43.29,
      "text": "Yılda bir ücretsiz çakam."
    },
    {
      "start": 43.67,
      "end": 44.91,
      "text": "Haftada bir ücretsiz muayene."
    },
    {
      "start": 45.81,
      "end": 49.31,
      "text": "On beş yıldır binlerce sokak çocuğu bu hastanede tedavi görüntü."
    },
    {
      "start": 50.11,
      "end": 50.91,
      "text": "Ücretsiz."
    },
    {
      "start": 53.56,
      "end": 54.92,
      "text": "Buna rağmen hala ayaktayız."
    },
    {
      "start": 55.04,
      "end": 55.92,
      "text": "Buna rağmen değil."
    },
    {
      "start": 57.2,
      "end": 60.32,
      "text": "Bunun güzü suyu hürmetine ayakta duruyor bu hastane."
    },
    {
      "start": 60.32,
      "end": 61.9,
      "text": "Peki."
    },
    {
      "start": 62.58,
      "end": 70.56,
      "text": "Bütçedeki açığı nasıl dengeleyeyim istersiniz?"
    },
    {
      "start": 72.44,
      "end": 73.74,
      "text": "Var mı bir öneriniz babacığım?"
    },
    {
      "start": 73.74,
      "end": 74.74,
      "text": "Ne?"
    },
