  "key": "582304bc264877192072ee9aee1eccdc57c46cb93c4c649a708dec1691dae507",
  "source_sha256": "00b73ab9e8d1081e84e5b58ce4c4fba4c4d1c602a3f7fabc898c4682862f7a5b",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.37,
      "end": 3.09,
      "text": "Sen de rüyada hayatınız o çocuğa borçlusunuz."
    },
    {
      "start": 3.39,
      "end": 4.65,
      "text": "Sağ salim sizi eve getirdi."
    },
    {
      "start": 5.07,
      "end": 6.61,
      "text": "Teşekkür edeceğine hesap mı soracaksın?"
    },
    {
      "start": 7.03,
      "end": 8.63,
      "text": "Biraz içkiyi fazla kaçırdım."
    },
    {
      "start": 8.75,
      "end": 9.63,
      "text": "Kendimde değildim hatırlamıyorum."
    },
    {
      "start": 9.65,
      "end": 10.47,
      "text": "Konuşma artık."
    },
    {
      "start": 10.71,
      "end": 12.79,
      "text": "Eğer o çocuk olmasaydı farkına bile varmayacaktım."
    },
    {
      "start": 12.85,
      "end": 14.05,
      "text": "Ha bir de beni mi ispiyonladı sana?"
    },
    {
      "start": 14.15,
      "end": 14.97,
      "text": "Sen kullandın yani."
    },
    {
      "start": 15.09,
      "end": 16.61,
      "text": "Hayır canım lafın girişi sadece."
    },
    {
      "start": 16.63,
      "end": 17.99,
      "text": "Kalk kalk kalk oradan hadi."
    },
    {
      "start": 19.63,
      "end": 20.97,
      "text": "Otur Çağla sıra sende."
    },
    {
      "start": 21.09,
      "end": 22.79,
      "text": "Hayır ya istemiyorum diyorum."
    },
    {
      "start": 23.01,
      "end": 24.61,
      "text": "Konanın bende ne alakası var ayrıca?"
    },
    {
      "start": 24.99,
      "end": 27.37,
      "text": "Dün gece uyuşturucu kullanmış gibi bir halin var mıydı sence benim?"
    },
    {
      "start": 27.37,
      "end": 29.57,
      "text": "Tamam kullanmadıysam zaten onu anlayacağız."
    },
    {
      "start": 29.57,
      "end": 31.93,
      "text": "Ya korkuyorum ya iğneden tobin var."
    },
    {
      "start": 32.03,
      "end": 33.81,
      "text": "Çağla saçmalama yine yeni icatlar çıkarma."
    },
    {
      "start": 33.91,
      "end": 34.75,
      "text": "Geç şuraya dedim sana."
    },
    {
      "start": 35.11,
      "end": 38.36,
      "text": "Geç aç şu kolunu."
    },
    {
      "start": 39.38,
      "end": 39.68,
      "text": "Aç."
    },
    {
      "start": 40.34,
      "end": 41.48,
      "text": "Aç şu kolunu."
    },
    {
      "start": 41.9,
      "end": 43.5,
      "text": "Aç kolunu dedim aman azlandın."
    },
    {
      "start": 44.34,
      "end": 53.68,
      "text": "Bunlar ne?"
    },
    {
      "start": 54.3,
      "end": 55.34,
      "text": "Ya bir şey yok."
    },
    {
      "start": 55.56,
      "end": 56.52,
      "text": "Çıkar her yerine bakacağım."
    },
    {
      "start": 56.7,
      "end": 57.38,
      "text": "Çıkar üstüne başına."
    },
    {
      "start": 57.38,
      "end": 59.72,
      "text": "Ya anne ne yapıyorsun babamın önünde ya?"
    },
    {
      "start": 60.32,
      "end": 62.18,
      "text": "Tamam sen al hızlı alıp çıkar mısın?"
    },
    {
      "start": 62.18,
      "end": 64.08,
      "text": "Ya sen beni en son ne zaman çıplak gördün ki?"
    },
    {
      "start": 64.3,
      "end": 65.62,
      "text": "Üç yaşında balan mıydım?"
    },
    {
      "start": 66.2,
      "end": 68.5,
      "text": "Manyama bile Feride teyze yaptırıyordu hatırladığım kadarıyla."
    },
    {
      "start": 68.54,
      "end": 68.92,
      "text": "Çağla."
    },
    {
      "start": 69.62,
      "end": 71.52,
      "text": "Bir dakika sakın durmuşsun Isya."
    },
    {
      "start": 72.82,
      "end": 73.38,
      "text": "Kızım."
    }
  ],
