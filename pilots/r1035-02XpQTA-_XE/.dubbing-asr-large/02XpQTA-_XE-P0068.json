  "segments": [
    {
      "start": 44.37,
      "end": 44.75,
      "text": "Siz değil mi?"
    },
    {
      "start": 45.47,
      "end": 47.11,
      "text": "Ya ben dün gece istemeden..."
    },
    {
      "start": 47.11,
      "end": 53.33,
      "text": "...keyfini kaçırdım durduk yere."
    },
    {
      "start": 53.45,
      "end": 56.09,
      "text": "Şu an istesem de keyfimi kaçıramazsın Çağla."
    },
    {
      "start": 56.17,
      "end": 58.57,
      "text": "Var ya uzun zamandır bu kadar iyi vakit geçirmiyordum."
    },
    {
      "start": 58.73,
      "end": 59.53,
      "text": "Ya böyle..."
    },
    {
      "start": 59.53,
      "end": 62.01,
      "text": "Çok iyi geldi be."
    },
    {
      "start": 62.39,
      "end": 63.07,
      "text": "Ne iyi geldi?"
    },
    {
      "start": 63.99,
      "end": 69.23,
      "text": "Siz nereden geliyorsunuz?"
    },
    {
      "start": 69.67,
      "end": 71.27,
      "text": "Ya geçen gün..."
    },
    {
      "start": 71.27,
      "end": 73.51,
      "text": "...Elemen'in teki size mesele olmuş ya..."
    },
    {
      "start": 73.51,
      "end": 74.79,
      "text": "...o meseleyi çözdük işte."
    },
    {
      "start": 75.33,
      "end": 76.15,
      "text": "Çözdük derken?"
    }
  ],
