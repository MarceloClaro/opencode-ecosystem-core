  "segments": [
    {
      "start": 5.81,
      "end": 6.53,
      "text": "Yaman."
    },
    {
      "start": 6.71,
      "end": 6.87,
      "text": "Ne?"
    },
    {
      "start": 7.43,
      "end": 8.91,
      "text": "Bir baksana kapıya."
    },
    {
      "start": 9.01,
      "end": 10.31,
      "text": "Tamam tamam tamam geldim."
    },
    {
      "start": 26.05,
      "end": 26.61,
      "text": "Asi."
    },
    {
      "start": 27.51,
      "end": 28.27,
      "text": "Asi ne oluyor?"
    },
    {
      "start": 29.37,
      "end": 29.85,
      "text": "Kim geldi?"
    },
    {
      "start": 31.23,
      "end": 31.91,
      "text": "Beyler."
    },
    {
      "start": 32.45,
      "end": 32.95,
      "text": "Kim geldi oğlum?"
    },
    {
      "start": 34.71,
      "end": 35.35,
      "text": "Selam."
    },
    {
      "start": 39.35,
      "end": 42.13,
      "text": "Habersiz geldim ama şoförden aldım adresini."
    },
    {
      "start": 46.53,
      "end": 46.97,
      "text": "Hayırdır?"
    },
    {
      "start": 48.19,
      "end": 49.11,
      "text": "Çok kibarsın yine."
    },
    {
      "start": 50.13,
      "end": 50.93,
      "text": "Sevginin yok mu?"
    },
    {
      "start": 51.19,
      "end": 51.85,
      "text": "Tek mi geldin?"
    },
    {
      "start": 53.33,
      "end": 54.41,
      "text": "Allah'ız benim sevgilim değil."
    },
    {
      "start": 54.41,
      "end": 57.42,
      "text": "Bize ne?"
    },
    {
      "start": 57.42,
      "end": 59.12,
      "text": "Sevgilim dedin ya az önce."
    },
    {
      "start": 59.74,
      "end": 61.42,
      "text": "Haberi var mı diyorum geldiğinden."
    },
    {
      "start": 61.86,
      "end": 63.82,
      "text": "Ben kimseden izin almıyorum bir yere giderken."
    },
    {
      "start": 64.02,
      "end": 64.6,
      "text": "Sordun mu?"
    },
    {
      "start": 64.88,
      "end": 65.5,
      "text": "Sordun evet."
    },
    {
      "start": 65.82,
      "end": 66.66,
      "text": "Haberi var mı dedin ya."
    },
    {
      "start": 66.74,
      "end": 68.18,
      "text": "İşte haberi var mı diye sordum."
    },
    {
      "start": 68.48,
      "end": 69.72,
      "text": "İzin alıyor musun diye sormadım."
    },
    {
      "start": 69.78,
      "end": 70.14,
      "text": "Asi."
    },
    {
      "start": 70.3,
      "end": 70.46,
      "text": "Ne?"
    },
    {
      "start": 71.32,
      "end": 72.48,
      "text": "Evet buyur."
    }
  ],
