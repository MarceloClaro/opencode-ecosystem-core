  "source_sha256": "87f1f05073ee2edbfb3c511967478ad8a5f05d46b1d42dab6b1a51d276ac6bff",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 2.16,
      "end": 3.6,
      "text": "O senin işin damat."
    },
    {
      "start": 4.48,
      "end": 5.22,
      "text": "Biz doktoruz."
    },
    {
      "start": 6.14,
      "end": 7.46,
      "text": "Sen ise idareci."
    },
    {
      "start": 9.65,
      "end": 10.23,
      "text": "Damat."
    },
    {
      "start": 11.85,
      "end": 14.61,
      "text": "Sana sadece kızımı değil soyadımı da verdim."
    },
    {
      "start": 16.35,
      "end": 18.39,
      "text": "Oğlumu bir çırpıda silip attım."
    },
    {
      "start": 19.19,
      "end": 21.57,
      "text": "Sana koskoca bir imparatorluk emanet ettim."
    },
    {
      "start": 21.57,
      "end": 27.91,
      "text": "Eğer bu emanete sahip çıkmazsan verdiklerimi tek tek geri almasını da çok iyi bilirim."
    },
    {
      "start": 31.17,
      "end": 32.13,
      "text": "Henüz ölmedim çok şükür."
    },
    {
      "start": 62.43,
      "end": 65.03,
      "text": "Ya kızım tek beygirli motor bu kadar gidiyor."
    },
    {
      "start": 65.03,
      "end": 66.23,
      "text": "Allah Allah bizimki de can be."
    },
    {
      "start": 66.31,
      "end": 67.19,
      "text": "Geldim geldim hadi."
    },
    {
      "start": 67.59,
      "end": 69.39,
      "text": "Oğlum arabaya bak lan bu neymiş böyle."
    },
    {
      "start": 72.3,
      "end": 72.68,
      "text": "Buyurun."
    },
    {
      "start": 73.0,
      "end": 73.52,
      "text": "Uyurduk."
    },
    {
      "start": 73.92,
      "end": 75.54,
      "text": "Yüce resmi aynı çarşamba günü gençler."
    },
    {
      "start": 75.68,
      "end": 77.46,
      "text": "Ama bizim günümüz bugün be abicim."
    },
    {
      "start": 77.6,
      "end": 79.12,
      "text": "Bizi istemeye devam edin yani."
    }
  ],
