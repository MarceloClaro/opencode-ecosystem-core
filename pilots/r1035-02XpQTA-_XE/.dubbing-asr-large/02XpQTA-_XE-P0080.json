  "source_sha256": "6ec603d2a26b41f720144441ceced45c11eb22bed4b112f9841863b747e08907",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 5.26,
      "end": 7.22,
      "text": "Umut 15-16 yaşında."
    },
    {
      "start": 8.22,
      "end": 10.5,
      "text": "Küçükken yediği bir dayak sonucunda..."
    },
    {
      "start": 10.5,
      "end": 11.9,
      "text": "...perç olmuş."
    },
    {
      "start": 12.04,
      "end": 13.66,
      "text": "Belden aşağısı perç bu çocuğun."
    },
    {
      "start": 14.96,
      "end": 15.48,
      "text": "Pardon."
    },
    {
      "start": 17.32,
      "end": 19.1,
      "text": "Sokak çocuğu olduğu için..."
    },
    {
      "start": 19.1,
      "end": 20.54,
      "text": "...tabii doktora da görünememiş."
    },
    {
      "start": 20.9,
      "end": 21.3,
      "text": "Bakın."
    },
    {
      "start": 25.04,
      "end": 26.0,
      "text": "Devam edin lütfen."
    },
    {
      "start": 26.14,
      "end": 26.96,
      "text": "Ben burada yokmuşum gibi."
    },
    {
      "start": 30.6,
      "end": 32.44,
      "text": "Şöyle aslında..."
    },
    {
      "start": 32.44,
      "end": 34.94,
      "text": "...çocuk birkaç defa hastanemize gelmiş."
    },
    {
      "start": 35.12,
      "end": 37.24,
      "text": "Fakat yapacak bir şey olmadığını söyleyerek..."
    },
    {
      "start": 37.24,
      "end": 38.68,
      "text": "...çocuğu geri yollamışız maalesef."
    },
    {
      "start": 38.68,
      "end": 40.36,
      "text": "Ben tüm bunların aksine..."
    },
    {
      "start": 40.36,
      "end": 42.62,
      "text": "...elimizden ne geliyorsa yapmak istiyorum."
    },
    {
      "start": 42.96,
      "end": 44.36,
      "text": "Hep beraber oturalım, inceleyelim."
    },
    {
      "start": 45.26,
      "end": 46.74,
      "text": "Umut için Umut var mı bir bakalım."
    },
    {
      "start": 47.1,
      "end": 47.74,
      "text": "Ne diyorsunuz?"
    },
    {
      "start": 47.86,
      "end": 49.84,
      "text": "Önce bir detaylı tetkikler yapmak lazım tabii."
    },
    {
      "start": 49.96,
      "end": 52.28,
      "text": "Ne gibi hocam? Tomografi, MR gibi mi?"
    },
    {
      "start": 52.62,
      "end": 53.06,
      "text": "Tabii tabii."
    },
    {
      "start": 53.72,
      "end": 56.66,
      "text": "Şimdi travmatik omurga hastalığı sonucu felç kalmış hastalarda..."
    },
    {
      "start": 56.66,
      "end": 58.54,
      "text": "...malum önce omurga ve omurikteki..."
    },
    {
      "start": 58.54,
      "end": 60.2,
      "text": "...sinir köklerindeki hasarı tespit etmek lazım."
    },
    {
      "start": 60.92,
      "end": 62.18,
      "text": "Kök yüce tedavisi denenebilir."
    },
    {
      "start": 62.44,
      "end": 63.14,
      "text": "Şüphesiz evet."
    },
    {
      "start": 63.6,
      "end": 65.68,
      "text": "Kayıp yüksekse sinir aktarım ameliyatı denenebilir."
    },
    {
      "start": 65.68,
      "end": 67.46,
      "text": "Bu yeni bir tedavi yöntemi mi hocam?"
    },
    {
      "start": 67.58,
      "end": 68.26,
      "text": "İlk kez duyuyorum."
    },
    {
      "start": 68.26,
      "end": 69.86,
      "text": "Yurt dışında sonuçlar alındı."
    },
    {
      "start": 70.04,
      "end": 70.5,
      "text": "Ha öyle mi?"
    }
  ],
