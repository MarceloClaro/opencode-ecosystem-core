      "text": "Yedim bitirdin ya."
    },
    {
      "start": 45.56,
      "end": 47.64,
      "text": "Kendini de aileni de yedim bitirdin."
    },
    {
      "start": 48.42,
      "end": 49.24,
      "text": "Değiyor mu Nesli?"
    },
    {
      "start": 49.44,
      "end": 49.98,
      "text": "Değiyor mu?"
    },
    {
      "start": 50.06,
      "end": 53.86,
      "text": "Yani anne babasının bile umursamadığı sokak çocukları bunlar."
    },
    {
      "start": 56.48,
      "end": 57.68,
      "text": "Sokak çocuğu mu dedin sen?"
    },
    {
      "start": 58.2,
      "end": 59.0,
      "text": "Biz ne yapıyoruz?"
    },
    {
      "start": 59.16,
      "end": 59.94,
      "text": "Biz ne yapıyoruz?"
    },
    {
      "start": 60.34,
      "end": 61.54,
      "text": "Şebnem, Şebnem."
    },
    {
      "start": 61.78,
      "end": 62.72,
      "text": "Bak biz yazdık bunu."
    },
    {
      "start": 63.1,
      "end": 64.66,
      "text": "Sokak çocuğu diye bir şey yoktur."
    },
    {
      "start": 65.04,
      "end": 67.34,
      "text": "Sokaklar çocuk doğurmaz diye biz dedik."
    },
    {
      "start": 68.6,
      "end": 72.42,
      "text": "Keşke yıllardır hiç kaçırmadan katıldığın vakıf toplantılarında..."
    },
    {
      "start": 72.42,
      "end": 74.22,
      "text": "...ne giyeceğine kafa yordun kadar..."
    },
    {
      "start": 74.22,
      "end": 75.9,
      "text": "...ne yaptığımızda da kafa yorsan biraz."
    },
    {
      "start": 76.08,
      "end": 78.34,
      "text": "Keşke sen de kendine kızgınlığının faturasını..."
    },
    {
      "start": 78.9,
      "end": 84.06,
      "text": "...ailene, çocuklarına, arkadaşlarına kesmekten vazgeçebilseydin ha arkadaşım."
