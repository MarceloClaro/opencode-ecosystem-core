  "key": "04749c4a610d31439bac4b6a8c6d05db3c9474a04e69cb5a1ed9ca84c5bb33da",
  "source_sha256": "5da45b6a70bf5116d5fac117b630c470e3c69ccee7648de1f10641f523a551cb",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 1.94,
      "text": "Çok yakında koşacaksın zaten bunlarla."
    },
    {
      "start": 2.58,
      "end": 3.1,
      "text": "İnşallah."
    },
    {
      "start": 4.3,
      "end": 5.2,
      "text": "İyi Umut."
    },
    {
      "start": 5.48,
      "end": 6.98,
      "text": "Hadi kalk bir koşu yetişelim madem."
    },
    {
      "start": 7.06,
      "end": 8.1,
      "text": "Geç kalıyoruz valla ya."
    },
    {
      "start": 8.44,
      "end": 9.78,
      "text": "Şaka oğlum şaka."
    },
    {
      "start": 12.08,
      "end": 14.02,
      "text": "Bunlar da şakadan hiç anlamıyorlar ha."
    },
    {
      "start": 14.74,
      "end": 15.98,
      "text": "Sen beni anlıyorsun ama değil mi?"
    },
    {
      "start": 16.42,
      "end": 17.36,
      "text": "Aslanım benim be."
    },
    {
      "start": 19.32,
      "end": 20.7,
      "text": "Sen hiç somurtma ha."
    },
    {
      "start": 21.24,
      "end": 22.72,
      "text": "Sen hep gül güzel kardeşim benim."
    },
    {
      "start": 23.44,
      "end": 24.22,
      "text": "Oh aslanım benim."
    },
    {
      "start": 24.22,
      "end": 25.08,
      "text": "Zevzek bu çocuk ya."
    },
    {
      "start": 25.26,
      "end": 26.76,
      "text": "Yemin ediyorum bu çocuk zevzek ya."
    },
    {
      "start": 26.76,
      "end": 26.78,
      "text": "Gerek."
    },
    {
      "start": 28.14,
      "end": 28.8,
      "text": "Valla saf."
    },
    {
      "start": 31.14,
      "end": 31.52,
      "text": "Lan."
    },
    {
      "start": 32.36,
      "end": 34.6,
      "text": "Cüzdanı da bırakmış oğlum bu bunun içinde."
    },
    {
      "start": 34.86,
      "end": 35.14,
      "text": "Allah."
    },
    {
      "start": 35.86,
      "end": 38.66,
      "text": "Ne kadar güzel vergine uyandık arkadaş biz."
    },
    {
      "start": 38.9,
      "end": 39.6,
      "text": "Kaç para var?"
    },
    {
      "start": 40.14,
      "end": 41.08,
      "text": "Ne yapacaksın kaç para var?"
    },
    {
      "start": 41.22,
      "end": 42.56,
      "text": "Ne yapacağım ya sordum Allah Allah."
    },
    {
      "start": 42.58,
      "end": 44.34,
      "text": "Bir dakika abicim bir dakika."
    },
    {
      "start": 44.52,
      "end": 45.92,
      "text": "Abi bir dakika bir sakin ol ya."
    },
    {
      "start": 46.0,
      "end": 48.24,
      "text": "Bir dur bakalım bir sağlamasını yapalım önce bir dur."
    },
    {
      "start": 48.68,
      "end": 51.52,
      "text": "Sen bu veledi kurtarmasaydın bıçağı takmamışlar mıydı buna?"
    },
    {
      "start": 51.58,
      "end": 52.26,
      "text": "Hiç şans yoktu."
    },
    {
      "start": 52.76,
      "end": 53.72,
      "text": "Aynen öyle."
    },
    {
      "start": 54.22,
      "end": 55.36,
      "text": "Etti mi sana varan bir."
    },
    {
      "start": 56.26,
      "end": 57.32,
      "text": "Canını kurtardın yani."
    },
    {
      "start": 57.32,
      "end": 58.26,
      "text": "İpten aldın sen bu."
    },
    {
      "start": 58.78,
      "end": 60.16,
      "text": "Bir dakika abicim bir dakika."
    },
    {
      "start": 60.36,
      "end": 61.42,
      "text": "Arabasını ne yapmışlardı?"
    },
    {
      "start": 61.42,
      "end": 62.58,
      "text": "Araklamamışlar mıydı?"
    },
    {
      "start": 62.84,
      "end": 64.24,
      "text": "Çoktan parçalamışlardı bile."
    },
    {
      "start": 64.52,
      "end": 64.92,
      "text": "Hah."
    },
    {
      "start": 65.18,
      "end": 67.44,
      "text": "Etti mi sana varan iki malını da kurtardın."
    },
    {
      "start": 67.74,
      "end": 69.52,
      "text": "Kıza ne yapmışlardı abi en ihtimalle?"
    },
    {
      "start": 69.52,
      "end": 69.6,
      "text": "Ne?"
    }
  ],
