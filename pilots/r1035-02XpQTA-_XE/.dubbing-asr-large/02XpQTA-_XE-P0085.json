      "text": "Memnun oldum Yabani."
    },
    {
      "start": 17.61,
      "end": 19.25,
      "text": "Ne oluyor şu an ben alman adım yani."
    },
    {
      "start": 19.69,
      "end": 21.61,
      "text": "Herkese benden çay geliyor Asi."
    },
    {
      "start": 21.79,
      "end": 22.35,
      "text": "Benden de."
    },
    {
      "start": 23.59,
      "end": 24.19,
      "text": "Asi."
    },
    {
      "start": 24.51,
      "end": 24.73,
      "text": "Ne?"
    },
    {
      "start": 25.27,
      "end": 27.39,
      "text": "Ya ben bu gözle mi kalkayım koyayım yazık değil mi bana?"
    },
    {
      "start": 27.69,
      "end": 28.47,
      "text": "Ben de kalkamıyorum."
    },
    {
      "start": 31.62,
      "end": 32.3,
      "text": "Hadi canım benim."
