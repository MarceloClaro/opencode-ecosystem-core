  "key": "f0ca06d1173d83c3189ba1e69ef32e5f1560621dfbc7fa4645f3184e0965ffe3",
  "source_sha256": "388638f191870245e664147c1dc6621530f772e369dbe515a867b80538d59478",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 5.87,
      "end": 7.55,
      "text": "Hayır ben anlamadım şimdi yani."
    },
    {
      "start": 7.63,
      "end": 8.47,
      "text": "Bu cesur niye gelmedi?"
    },
    {
      "start": 8.59,
      "end": 9.83,
      "text": "Aklım almıyor benim bunu Asi."
    },
    {
      "start": 10.25,
      "end": 11.73,
      "text": "Ya üşütmüş çocuk."
    },
    {
      "start": 12.13,
      "end": 13.57,
      "text": "Dünden beri keyfi yoktu zaten."
    },
    {
      "start": 13.85,
      "end": 15.07,
      "text": "Yatacak, dinlenecek, hasta."
    },
    {
      "start": 16.35,
      "end": 18.45,
      "text": "Ayrıca bu mu şimdi bizim derdimiz yani?"
    },
    {
      "start": 19.59,
      "end": 21.19,
      "text": "Bakalım kadın ne diyecek hem?"
    },
    {
      "start": 21.73,
      "end": 22.35,
      "text": "Ne olacak?"
    },
    {
      "start": 22.53,
      "end": 23.69,
      "text": "Ne çıkacak sonuçlardan?"
    },
    {
      "start": 23.91,
      "end": 24.43,
      "text": "Allah Allah."
    },
    {
      "start": 25.27,
      "end": 25.97,
      "text": "Bir dakika bir dakika."
    },
    {
      "start": 26.63,
      "end": 27.79,
      "text": "Ya senin bir şüphen mi var hala?"
    },
    {
      "start": 27.87,
      "end": 30.15,
      "text": "Bu çocuk buraya sandalyeyle girecek, yürüyerek çıkacak."
    },
    {
      "start": 30.27,
      "end": 30.97,
      "text": "Ne? Değil mi lan?"
    },
    {
      "start": 31.13,
      "end": 31.45,
      "text": "Aydın."
    },
    {
      "start": 32.33,
      "end": 34.05,
      "text": "Keşke o kadar kolay olsa o işler."
    },
    {
      "start": 35.87,
      "end": 36.63,
      "text": "Sen kimsin?"
    },
    {
      "start": 37.43,
      "end": 37.85,
      "text": "Hayırdır?"
    },
    {
      "start": 40.4,
      "end": 41.86,
      "text": "İncelemek ister misin? Okuman var mı?"
    },
    {
      "start": 43.24,
      "end": 44.12,
      "text": "Ne ki bu ya?"
    },
    {
      "start": 46.88,
      "end": 49.3,
      "text": "Arkadaşının hastaneme olan maliyeti."
    },
    {
      "start": 50.14,
      "end": 51.62,
      "text": "Ortalama 170 bin dolar."
    },
    {
      "start": 53.1,
      "end": 54.7,
      "text": "Sizde bildiğim kadarıyla bin dolar vardı."
    },
    {
      "start": 54.7,
      "end": 56.4,
      "text": "Eğer hala kaldıysa."
    },
    {
      "start": 57.26,
      "end": 57.84,
      "text": "Üstün olacak."
    },
    {
      "start": 62.48,
      "end": 64.74,
      "text": "Kimse bize para falan demedi değil mi?"
    },
    {
      "start": 65.96,
      "end": 66.64,
      "text": "Şey."
    },
    {
      "start": 67.62,
      "end": 68.56,
      "text": "Siz bir çekilir misiniz?"
    },
    {
      "start": 68.68,
      "end": 70.4,
      "text": "Biz doktor hanımın kendisiyle konuşalım."
    },
    {
      "start": 70.62,
      "end": 72.04,
      "text": "O doktor hanım dediğim benim karım."
    },
    {
      "start": 73.46,
      "end": 73.96,
      "text": "Ne?"
    },
    {
      "start": 73.96,
      "end": 74.56,
      "text": "Aferin, hoş geldin."
    },
    {
      "start": 74.62,
      "end": 75.12,
      "text": "Merhaba."
    },
    {
      "start": 75.12,
      "end": 75.62,
      "text": "Ben İsa."
    },
    {
      "start": 75.9,
      "end": 77.4,
      "text": "Yani bu da ilk kez ben durdum."
    },
    {
      "start": 77.4,
      "end": 78.6,
      "text": "Ne dediğini biliyorum."
    },
    {
      "start": 78.6,
      "end": 79.74,
      "text": "Herkeste."
    },
    {
      "start": 79.74,
      "end": 80.38,
      "text": "Ben ben."
    },
    {
      "start": 80.38,
      "end": 80.88,
      "text": "Herkeste."
    },
    {
      "start": 80.88,
      "end": 83.02,
      "text": "Sen ne kadar hırsızsın ya?"
    },
    {
      "start": 85.02,
      "end": 86.76,
      "text": "Ben hiç bir karımım mı yaşıyorum?"
    },
    {
      "start": 88.24,
      "end": 89.78,
      "text": "Sen ne kadar da muzafer mi yaşıyorsun?"
    },
    {
      "start": 89.78,
      "end": 90.64,
      "text": "Aslında devam et."
    },
    {
      "start": 90.64,
      "end": 91.84,
      "text": "Senden daha iyi bir işim oldum."
    },
    {
      "start": 92.46,
      "end": 93.02,
      "text": "Senden daha iyi bir işim oldu."
    },
    {
      "start": 93.02,
      "end": 93.52,
      "text": "Efendim?"
    },
    {
      "start": 93.52,
      "end": 94.02,
      "text": "Hayır."
    },
    {
      "start": 94.02,
      "end": 94.52,
      "text": "Ne iyi?"
    },
    {
      "start": 94.52,
      "end": 95.1,
      "text": "Senden daha iyi bir işim oldu."
    },
    {
      "start": 95.1,
      "end": 95.6,
      "text": "Tamam."
    },
    {
      "start": 95.6,
      "end": 96.1,
      "text": "Evet."
    },
    {
      "start": 96.1,
      "end": 97.02,
      "text": "Ben flikanyatı yapıyorum."
    },
    {
      "start": 97.02,
      "end": 98.18,
      "text": "Ben çok azınlık oldum."
    },
    {
      "start": 98.18,
      "end": 98.68,
      "text": "Geri bir şey yapıyorum."
    },
    {
      "start": 98.68,
      "end": 99.18,
      "text": "Nasıl?"
    },
    {
      "start": 99.18,
      "end": 100.06,
      "text": "Ben kasamdan içeceğim."
    },
    {
      "start": 100.06,
      "end": 100.68,
      "text": "Ne?"
    },
    {
      "start": 100.68,
      "end": 101.32,
      "text": "Bu bir şey mi?"
    }
  ],
