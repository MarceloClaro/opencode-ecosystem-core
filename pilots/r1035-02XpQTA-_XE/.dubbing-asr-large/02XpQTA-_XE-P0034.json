  "source_sha256": "71b142988484f985d2c6de68aaf522a155e35a4c2d03a0148034b7016f29f82c",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.72,
      "end": 6.28,
      "text": "Kim yaptı kızım bunu sana?"
    },
    {
      "start": 8.49,
      "end": 10.51,
      "text": "Bak, bizimle her şeyi paylaşabilirsin."
    },
    {
      "start": 10.61,
      "end": 11.47,
      "text": "Korkmana hiç gerek yok."
    },
    {
      "start": 11.85,
      "end": 12.25,
      "text": "Tamam mı?"
    },
    {
      "start": 12.61,
      "end": 13.03,
      "text": "İnşallah."
    },
    {
      "start": 14.35,
      "end": 14.93,
      "text": "Rüzgar mı?"
    },
    {
      "start": 15.53,
      "end": 22.95,
      "text": "Ay yok artık ya, daha neler."
    },
    {
      "start": 23.41,
      "end": 25.07,
      "text": "İyice kafayı yediniz ama artık siz."
    },
    {
      "start": 25.47,
      "end": 26.65,
      "text": "Ufacık çarpsan mor arıyor."
    },
    {
      "start": 27.59,
      "end": 28.83,
      "text": "Tenim hassas herhalde, bilmiyorum."
    },
    {
      "start": 29.19,
      "end": 31.07,
      "text": "Yani fark etmiyorum bile. Bir bakıyorum böyle."
    },
    {
      "start": 32.07,
      "end": 33.61,
      "text": "Şiddet falan gördüğüm yok yani."
    },
    {
      "start": 33.81,
      "end": 34.21,
      "text": "Relaks."
    },
    {
      "start": 34.71,
      "end": 35.93,
      "text": "Ne kadar zamandır oluyor bu?"
    },
    {
      "start": 36.27,
      "end": 37.61,
      "text": "Kendimi bildim bile anneciğim."
    },
    {
      "start": 37.61,
      "end": 38.83,
      "text": "Neden bana söylemiyorsun?"
    },
    {
      "start": 38.83,
      "end": 38.95,
      "text": "Sordum."
    },
    {
      "start": 39.99,
      "end": 41.41,
      "text": "Sormadığın için olabilir mi mesela?"
    },
    {
      "start": 43.33,
      "end": 44.61,
      "text": "Nasılsınız, iyi misiniz?"
    },
    {
      "start": 44.77,
      "end": 45.75,
      "text": "Harma bir ihtiyacınız."
    },
    {
      "start": 46.45,
      "end": 46.89,
      "text": "Ama yok."
    },
    {
      "start": 48.23,
      "end": 51.31,
      "text": "Çünkü sen nasıl olduğumuzla değil, ne yaptığımızla ilgilendiğin için."
    },
    {
      "start": 54.96,
      "end": 55.32,
      "text": "Bitti."
    },
    {
      "start": 55.8,
      "end": 56.08,
      "text": "Güzel."
    },
    {
      "start": 59.54,
      "end": 60.7,
      "text": "Arabanı garaja çektirdim."
    },
    {
      "start": 61.44,
      "end": 63.1,
      "text": "Bundan sonra şoförle gidiyorsun okula."
    },
    {
      "start": 63.66,
      "end": 71.1,
      "text": "Bir şey yap artık yoksa kendimi keseceğim."
    }
  ],
