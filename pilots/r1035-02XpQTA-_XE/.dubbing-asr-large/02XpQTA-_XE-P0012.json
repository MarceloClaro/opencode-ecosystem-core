  "segments": [
    {
      "start": 24.37,
      "end": 24.81,
      "text": "Efendim?"
    },
    {
      "start": 25.13,
      "end": 26.05,
      "text": "Artık ne içtiyseniz."
    },
    {
      "start": 26.41,
      "end": 29.21,
      "text": "Bir de püskürtüyorsunuz üstünüze başınıza şampanyaları."
    },
    {
      "start": 29.71,
      "end": 32.17,
      "text": "Ve bir yerden sonra o pahalı parfümleriniz de kurtarmıyor tabii sizi."
    },
    {
      "start": 32.55,
      "end": 35.07,
      "text": "Tabii yoksa sen mis gibi kokuyorsun Nurmesley'in gereği."
    },
    {
      "start": 35.83,
      "end": 36.01,
      "text": "Ne?"
    },
    {
      "start": 37.23,
      "end": 38.67,
      "text": "Çöp topluyorsun yani."
    },
    {
      "start": 40.03,
      "end": 40.99,
      "text": "Çöp değil o."
    },
    {
      "start": 41.29,
      "end": 41.85,
      "text": "Geri dönüşüm."
    },
    {
      "start": 42.35,
      "end": 43.55,
      "text": "Acaba duydun mu hiç hayatında?"
    },
    {
      "start": 43.89,
      "end": 45.73,
      "text": "Nereden geliyor bu özgüven anlamadım ki."
    },
    {
      "start": 51.76,
      "end": 52.7,
      "text": "Başlasan mı biraz?"
    },
    {
      "start": 55.66,
      "end": 57.48,
      "text": "Konur sağdan diyordu nereye gidiyorsun ya?"
    },
    {
      "start": 58.6,
      "end": 60.04,
      "text": "Ya nereye götürüyorsun sen bizi?"
    },
    {
      "start": 61.02,
      "end": 61.82,
      "text": "Durdur arabayı."
    },
    {
      "start": 61.82,
      "end": 63.18,
      "text": "Arabayı durdur."
    },
    {
      "start": 63.74,
      "end": 64.56,
      "text": "Durdur ineceğim."
    },
    {
      "start": 64.92,
      "end": 71.75,
      "text": "Kaçırıyorlar."
    }
  ],
