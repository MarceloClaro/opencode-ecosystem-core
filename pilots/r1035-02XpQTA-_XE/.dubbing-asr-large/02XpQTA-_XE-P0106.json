      "text": "Baba!"
    },
    {
      "start": 24.56,
      "end": 26.56,
      "text": "Ne yapıyorsun?"
    },
    {
      "start": 26.56,
      "end": 28.56,
      "text": "Anne, ne işin var?"
    },
    {
      "start": 28.56,
      "end": 30.56,
