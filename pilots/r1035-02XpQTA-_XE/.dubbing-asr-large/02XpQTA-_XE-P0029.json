  "source_sha256": "4a3c6b95967b31352f7500e9188d751e962da7fc611c52f730f34deb52edec79",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 10.13,
      "end": 11.39,
      "text": "Kim yaptı lan bana bunu?"
    },
    {
      "start": 11.87,
      "end": 13.37,
      "text": "Ya var ya az bile yapmış."
    },
    {
      "start": 13.59,
      "end": 14.97,
      "text": "Ağzını burnunu dağıtsaymış."
    },
    {
      "start": 15.09,
      "end": 16.55,
      "text": "Keşke de kemiklerini kırsaymış."
    },
    {
      "start": 20.77,
      "end": 21.19,
      "text": "Kim?"
    },
    {
      "start": 21.97,
      "end": 23.57,
      "text": "Ara Rüya'yı o anlatsın."
    },
    {
      "start": 25.31,
      "end": 26.73,
      "text": "Rüya telefonun nerede benim?"
    },
    {
      "start": 28.15,
      "end": 29.83,
      "text": "Var ya hiç boşuna arama."
    },
    {
      "start": 29.97,
      "end": 31.73,
      "text": "Varsa bir olup kaybettin sen öndün gece."
    },
    {
      "start": 31.81,
      "end": 33.35,
      "text": "Rüya artık ölsem bakmaz senin yüzüne."
    },
    {
      "start": 33.37,
      "end": 34.01,
      "text": "Bir kes sesini."
    },
    {
      "start": 34.23,
      "end": 36.05,
      "text": "Anlat ne oldu dün akşam hiçbir şey hatırlamıyorum zaten."
    },
    {
      "start": 36.37,
      "end": 37.75,
      "text": "Kendini kaybetmişsin bu defa."
    },
    {
      "start": 37.87,
      "end": 39.69,
      "text": "Çırılçıplak yol ortası soyunmuşsun."
    },
    {
      "start": 39.69,
      "end": 43.27,
      "text": "Kızı da abuk sabuk bir yerde bırakıp manyak manyak hareketler yapmışsın."
    },
    {
      "start": 43.27,
      "end": 45.51,
      "text": "Kız ne yapacağını şaşırmış ya ödü kopmuş."
    },
    {
      "start": 46.79,
      "end": 47.07,
      "text": "Eee?"
    },
    {
      "start": 47.31,
      "end": 48.17,
      "text": "Ne eesi be?"
    },
    {
      "start": 48.31,
      "end": 50.07,
      "text": "Sonra ne olmuş Çağla sonra ne olmuş?"
    },
    {
      "start": 50.59,
      "end": 53.09,
      "text": "Sonrası elemanın biri paketleyip seni eve getirdi canım."
    },
    {
      "start": 53.85,
      "end": 54.51,
      "text": "Bir dakika bir dakika."
    },
    {
      "start": 54.97,
      "end": 55.55,
      "text": "Kimmiş o eleman?"
    },
    {
      "start": 56.05,
      "end": 56.91,
      "text": "O halde dönmüş mü beni?"
    },
    {
      "start": 57.37,
      "end": 58.69,
      "text": "Ya konu bu mu ya?"
    },
    {
      "start": 59.15,
      "end": 61.97,
      "text": "Kızım kim bana el kaldırabilir üstelik Rüya yanımdayken?"
    },
    {
      "start": 62.69,
      "end": 63.83,
      "text": "Ne kullandın sen dün gece ne kullandın?"
    },
    {
      "start": 63.83,
      "end": 65.19,
      "text": "Ya sana ne sana ne?"
    },
    {
      "start": 65.73,
      "end": 66.59,
      "text": "Sen soruma cevap ver."
    },
    {
      "start": 66.79,
      "end": 67.77,
      "text": "Aynen bana ne değil mi?"
    },
    {
      "start": 67.77,
      "end": 70.19,
      "text": "Bence de bana ne ama sayende bana ne olmuyor işte."
    },
    {
      "start": 70.39,
      "end": 72.95,
      "text": "Annem senin yüzünden beni doyuşturup citesine götürecek."
    },
    {
      "start": 73.15,
      "end": 73.25,
      "text": "Ne?"
    },
    {
      "start": 73.97,
      "end": 77.47,
      "text": "Ya var ya keşke annemin karnındayken yeseydim seni."
    },
    {
      "start": 77.65,
      "end": 80.59,
      "text": "Keşke boğsaydım da kordonun boynuna dolasaydım keşke."
    },
    {
      "start": 80.59,
      "end": 80.89,
      "text": "Kız!"
    },
    {
      "start": 80.89,
      "end": 81.35,
      "text": "Kız!"
    }
  ],
