  "key": "97cadd8cf89c3258f105b41d68eead320e68c36bb657aa21bd0de0552a54950e",
  "source_sha256": "595009128d805a556db05823bd4035182614c4630d2482873cd8762191833ee8",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.37,
      "end": 1.81,
      "text": "Arabada unuttum galiba."
    },
    {
      "start": 2.25,
      "end": 4.09,
      "text": "Cüzdanı vereceksin ya iste gitmişken."
    },
    {
      "start": 4.61,
      "end": 5.45,
      "text": "Çok yakışıyor sana."
    },
    {
      "start": 6.71,
      "end": 7.47,
      "text": "Eyvallah."
    },
    {
      "start": 9.43,
      "end": 11.75,
      "text": "Lan valla keyfim beyde yok ha."
    },
    {
      "start": 11.85,
      "end": 13.45,
      "text": "Az kalk da biz oturak lan yorulduk."
    },
    {
      "start": 14.83,
      "end": 15.25,
      "text": "Gel gel."
    },
    {
      "start": 15.43,
      "end": 15.73,
      "text": "Gel otur."
    },
    {
      "start": 16.25,
      "end": 16.81,
      "text": "Bana bak."
    },
    {
      "start": 17.15,
      "end": 20.01,
      "text": "Beni kucağına oturtacak adam daha anasının kanından doğmadı aslan."
    },
    {
      "start": 21.11,
      "end": 22.39,
      "text": "Oğlum gülme sen de şuna ya."
    },
    {
      "start": 22.53,
      "end": 24.47,
      "text": "Bak sen gülüyorsun diye böyle şımarıyor bu ha."
    },
    {
      "start": 24.63,
      "end": 27.35,
      "text": "Ya bu garip bugün gülmesin de ne zaman gülsün be oğlum."
    },
    {
      "start": 27.83,
      "end": 28.63,
      "text": "Bana bak."
    },
    {
      "start": 28.63,
      "end": 30.93,
      "text": "Bu mucize doktor seni ayağa kaldıracak ya."
    },
    {
      "start": 31.29,
      "end": 31.99,
      "text": "Hadi inşallah."
    },
    {
      "start": 32.63,
      "end": 35.29,
      "text": "Ondan sonra ben seni hayatta oturtmam haberin olsun."
    },
    {
      "start": 35.47,
      "end": 37.65,
      "text": "Bütün getir götür işlerini sen yapacaksın bundan sonra."
    },
    {
      "start": 37.91,
      "end": 39.87,
      "text": "Ona göre bunca zaman yattın asayi lan."
    },
    {
      "start": 41.59,
      "end": 43.11,
      "text": "Ne gülüyorsun oğlum ciddiyim lan."
    },
    {
      "start": 43.43,
      "end": 44.35,
      "text": "Valla yorulduk ha."
    },
    {
      "start": 44.99,
      "end": 45.39,
      "text": "Git lan."
    },
    {
      "start": 46.09,
      "end": 46.75,
      "text": "Gittin lan o zaman."
    },
    {
      "start": 47.35,
      "end": 49.33,
      "text": "E iyi ben eve gidiyorum o zaman yatarım azıcık."
    },
    {
      "start": 49.49,
      "end": 51.05,
      "text": "İyi hadi defol durdun kabahat."
    },
    {
      "start": 51.05,
      "end": 54.33,
      "text": "Bak kalbimi kırıyorsunuz ama sonra atarım kendimi şu yola."
    },
    {
      "start": 54.43,
      "end": 56.35,
      "text": "Kıyarım canıma çok ağlarsınız arkamdan."
    },
    {
      "start": 56.41,
      "end": 58.31,
      "text": "Bir üzülürüm bir üzülürüm var ya."
    },
    {
      "start": 58.63,
      "end": 61.27,
      "text": "İyi eyvallah o zaman hakkınızı helal edin."
    },
    {
      "start": 61.45,
      "end": 62.57,
      "text": "Cesur ne yapıyorsun oğlum Cesur?"
    },
    {
      "start": 66.09,
      "end": 67.71,
      "text": "Abi ne yapıyorsun sen ya?"
    },
    {
      "start": 69.27,
      "end": 70.45,
      "text": "Ya yine mi bu ya?"
    },
    {
      "start": 71.33,
      "end": 71.59,
      "text": "Kim?"
    },
    {
      "start": 71.85,
      "end": 73.23,
      "text": "Seni paketleyen eleman işte."
    }
  ],
