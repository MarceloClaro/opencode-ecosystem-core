  "key": "7ebfc94f74a0743e649ed34a5007f08fd434193e6e5d4d2d8540bfa8bfb96282",
  "source_sha256": "dc87d68d353355ce22be742d865d8d5211ee8ce34d03806c978e38ba33f85754",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 6.1,
      "end": 7.66,
      "text": "Neslihan sakin olur musun?"
    },
    {
      "start": 8.0,
      "end": 9.38,
      "text": "Çocukların üzerine fazla gidiyorsun."
    },
    {
      "start": 10.18,
      "end": 12.1,
      "text": "Sana kalsa her gün tatileyebilirim."
    },
    {
      "start": 12.46,
      "end": 14.38,
      "text": "Görüyorsun değil mi eğlence anlayışlarınız?"
    },
    {
      "start": 14.62,
      "end": 15.98,
      "text": "Gençler eğlensinler."
    },
    {
      "start": 16.24,
      "end": 17.28,
      "text": "Bak sana izin verme dedim."
    },
    {
      "start": 18.08,
      "end": 20.06,
      "text": "Ya çocuk içkiyi fazla kaçırmış o kadar."
    },
    {
      "start": 20.5,
      "end": 21.42,
      "text": "Bir serserin lafıyla."
    },
    {
      "start": 21.86,
      "end": 23.8,
      "text": "Göz bebekleri yine deliğe kadardı."
    },
    {
      "start": 24.36,
      "end": 25.8,
      "text": "Ağzı uyuşturucu almış."
    },
    {
      "start": 25.98,
      "end": 26.9,
      "text": "Sesini yükseltme."
    },
    {
      "start": 27.46,
      "end": 28.94,
      "text": "Burası bizim hastanemiz farkında mısın?"
    },
    {
      "start": 29.3,
      "end": 31.82,
      "text": "Kendi hastanemize kendi çocuklarımıza uyuşturucu testi yapamayız."
    },
    {
      "start": 32.08,
      "end": 33.02,
      "text": "Duyulursa büyük skandal."
    },
    {
      "start": 33.32,
      "end": 35.42,
      "text": "Duyulmadığı sürece hiçbir sıkıntı yok yani değil mi?"
    },
    {
      "start": 35.42,
      "end": 37.44,
      "text": "Çocukların sessizce kendilerini ölürsünler."
    },
    {
      "start": 37.62,
      "end": 38.42,
      "text": "Hiçbir şeyi anlamıyor."
    },
    {
      "start": 38.56,
      "end": 39.56,
      "text": "Ben bunu mu diyorum Neslihan?"
    },
    {
      "start": 39.78,
      "end": 41.32,
      "text": "Neyi diyorsun?"
    },
    {
      "start": 44.69,
      "end": 45.51,
      "text": "Babacığım."
    },
    {
      "start": 47.64,
      "end": 48.68,
      "text": "Efendim sizi hiç beklemiyorduk."
    },
    {
      "start": 48.76,
      "end": 49.36,
      "text": "Sürpriz oldu."
    },
    {
      "start": 49.74,
      "end": 50.16,
      "text": "Hayırdır?"
    },
    {
      "start": 51.62,
      "end": 54.38,
      "text": "Şu mucize doktoru bir de ben dinleyeyim dedim."
    },
    {
      "start": 55.18,
      "end": 56.06,
      "text": "Ne anlatıyormuş."
    },
    {
      "start": 56.86,
      "end": 58.06,
      "text": "Maharetleri neymiş."
    },
    {
      "start": 58.48,
      "end": 59.7,
      "text": "Bir de biz öğrenelim dedik."
    },
    {
      "start": 60.78,
      "end": 61.5,
      "text": "Estağfurullah efendim."
    },
    {
      "start": 61.6,
      "end": 63.16,
      "text": "Size kim ne öğretebilir ki?"
    },
    {
      "start": 64.68,
      "end": 65.4,
      "text": "Hayırdır?"
    },
    {
      "start": 66.18,
      "end": 68.54,
      "text": "Sabahleyin erkenden kaçırır gibi çıkardın."
    },
    {
      "start": 68.62,
      "end": 68.72,
      "text": "Çocuğu."
    },
    {
      "start": 68.74,
      "end": 69.52,
      "text": "Çocukları evden."
    },
    {
      "start": 70.66,
      "end": 71.96,
      "text": "Bu yüzden mi hasta mı oldular?"
    },
    {
      "start": 73.12,
      "end": 73.56,
      "text": "Yok."
    }
  ],
