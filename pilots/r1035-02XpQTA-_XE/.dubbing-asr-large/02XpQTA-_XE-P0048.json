  "key": "7ed947213dba10f20b4451c4708d73fc410b31d572e1d876508e1bf1c2a06b14",
  "source_sha256": "9663a36a43e37567ea2fda30569db550149a800b37de38001b95a4ae08abe8b5",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 0.14,
      "text": "Yani."
    },
    {
      "start": 1.34,
      "end": 2.1,
      "text": "Eyvallah."
    },
    {
      "start": 3.14,
      "end": 6.52,
      "text": "Kolay gelsin."
    },
    {
      "start": 7.1,
      "end": 7.44,
      "text": "Sağ olun."
    },
    {
      "start": 8.2,
      "end": 10.18,
      "text": "Bizim çocukların tahliye sonuçları çıktı mı?"
    },
    {
      "start": 10.76,
      "end": 12.06,
      "text": "Efendim numuneler henüz geldi."
    },
    {
      "start": 14.22,
      "end": 15.34,
      "text": "Size zahmet."
    },
    {
      "start": 15.82,
      "end": 18.42,
      "text": "Sonuçlar çıkar çıkmaz doğrudan bana getirin."
    },
    {
      "start": 18.52,
      "end": 19.92,
      "text": "Sonra da sistemden derhal sevin."
    },
    {
      "start": 20.54,
      "end": 23.2,
      "text": "Ancak Eşref Bey'in kesin talimatı var."
    },
    {
      "start": 23.34,
      "end": 24.66,
      "text": "Yani bizzat onu kendisine verdik."
    },
    {
      "start": 24.68,
      "end": 26.14,
      "text": "Çocukların babası Eşref Bey değil."
    },
    {
      "start": 26.5,
      "end": 28.74,
      "text": "Benim. Ayrıca bu hastaneyi ben yönetiyorum."
    },
    {
      "start": 29.06,
      "end": 30.3,
      "text": "Eşref Bey değil. Değil mi?"
    },
    {
      "start": 30.3,
      "end": 34.7,
      "text": "Efendim numunelerin sonuçları sadece bana getiriyorsun."
    },
    {
      "start": 36.66,
      "end": 37.32,
      "text": "Kolay gelsin."
    },
    {
      "start": 41.02,
      "end": 42.7,
      "text": "Ücretsiz muayene için çarşamba günleri."
    },
    {
      "start": 42.82,
      "end": 44.4,
      "text": "Tamam. Sünmesin abinin mevzu."
    },
    {
      "start": 45.18,
      "end": 47.36,
      "text": "Ya biz şu mucize doktora..."
    },
    {
      "start": 47.36,
      "end": 47.88,
      "text": "Neydi adı?"
    },
    {
      "start": 48.58,
      "end": 50.36,
      "text": "Michael bir şeydi. Amerikalı doktor."
    },
    {
      "start": 50.46,
      "end": 52.64,
      "text": "Bugün hasta bakımı için gelecekti. Onun için geldik."
    },
    {
      "start": 53.0,
      "end": 54.1,
      "text": "Üzgünüm. Hasta alamıyoruz."
    },
    {
      "start": 54.28,
      "end": 55.08,
      "text": "Hayırdır? Sebep?"
    },
    {
      "start": 55.46,
      "end": 56.64,
      "text": "Ya bir dakika dur. Sakin ol."
    },
    {
      "start": 57.42,
      "end": 58.84,
      "text": "Bizim muayene ücretimiz tam."
    },
    {
      "start": 58.96,
      "end": 60.28,
      "text": "Bize zaten bin dolar demişlerdi."
    },
    {
      "start": 60.28,
      "end": 62.02,
      "text": "Biz de tam getirdik. Yarın sayabilirsiniz."
    },
    {
      "start": 62.34,
      "end": 63.34,
      "text": "Randevular aylar önce."
    },
    {
      "start": 63.4,
      "end": 66.14,
      "text": "Tamam şöyle yapalım. Siz bizi süreye ekleyin."
    },
    {
      "start": 66.22,
      "end": 67.56,
      "text": "Mutlaka bugün gelmeyen olur."
    },
    {
      "start": 67.82,
      "end": 69.54,
      "text": "Biz bekleriz. Gerekirse en son gireriz."
    },
    {
      "start": 69.66,
      "end": 70.2,
      "text": "Sıkıntı yok."
    },
    {
      "start": 70.28,
      "end": 70.76,
      "text": "Mümkün değil."
    }
  ],
