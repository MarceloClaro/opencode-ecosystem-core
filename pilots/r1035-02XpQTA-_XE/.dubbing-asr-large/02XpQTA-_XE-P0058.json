  "key": "76cb56d98995bc6077adc6dcb0479cac6e4e51924a8c184acd59e3770299b0fe",
  "source_sha256": "0d8271f51d12217b2386363522c338abeccb09bed696a90cbe7a8f3d99674aeb",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 0.82,
      "text": "Ben neyim?"
    },
    {
      "start": 1.46,
      "end": 4.02,
      "text": "Sokak Çocukları Koruma Vakfı Başkanıyım değil mi?"
    },
    {
      "start": 4.28,
      "end": 8.22,
      "text": "Ve ben bizim hastanemizde bu çocuklara umut tacirliği yapıyormuşum."
    },
    {
      "start": 8.24,
      "end": 9.78,
      "text": "Ben umut tacirliği falan yapmıyorum."
    },
    {
      "start": 9.9,
      "end": 12.28,
      "text": "Eğer satmaya çalıştığım bir umut varsa..."
    },
    {
      "start": 12.28,
      "end": 13.98,
      "text": "...o çocuklar benim müşterim değil. Tamam mı?"
    },
    {
      "start": 14.48,
      "end": 15.32,
      "text": "Vakıf dedin açtık."
    },
    {
      "start": 15.6,
      "end": 17.12,
      "text": "Ücretsiz muayene diyorsun, yapıyoruz."
    },
    {
      "start": 17.68,
      "end": 20.28,
      "text": "Eee? O çocuk da bir zahmet gelecek poliklinle..."
    },
    {
      "start": 20.28,
      "end": 23.22,
      "text": "...girecek arkadaşlarıyla sıraya, olacak muayenesine..."
    },
    {
      "start": 23.22,
      "end": 24.32,
      "text": "...ilacı varsa alıp gidecek."
    },
    {
      "start": 24.74,
      "end": 25.4,
      "text": "Bu kadar basit."
    },
    {
      "start": 25.98,
      "end": 27.14,
      "text": "Boyunu açan hayaller kurmayacak."
    },
    {
      "start": 27.14,
      "end": 28.78,
      "text": "Öyle mucize peşinde falan koşmayacak."
    },
    {
      "start": 28.78,
      "end": 31.14,
      "text": "Tabii. O çocukların mucize için..."
    },
    {
      "start": 31.14,
      "end": 32.76,
      "text": "...umut etme hakları bile yok öyle değil mi?"
    },
    {
      "start": 32.82,
      "end": 33.46,
      "text": "Yapma."
    },
    {
      "start": 33.52,
      "end": 34.08,
      "text": "Ne yapma?"
    },
    {
      "start": 38.92,
      "end": 41.54,
      "text": "O çocuklardan biri bizim çocuğumuz olabilirdi."
    },
    {
      "start": 42.18,
      "end": 42.74,
      "text": "Ama değil."
    },
    {
      "start": 43.96,
      "end": 45.68,
      "text": "Beş kuruş almadan tedavi etti."
    },
    {
      "start": 46.7,
      "end": 47.7,
      "text": "Bütün kaynaklarını..."
    },
    {
      "start": 47.7,
      "end": 49.98,
      "text": "...varınıyormuş sevgini, ilgini, vaktini..."
    },
    {
      "start": 49.98,
      "end": 52.16,
      "text": "...ailen yerine harcadığın o çocuklar..."
    },
    {
      "start": 52.16,
      "end": 53.98,
      "text": "...senin çocuğun değil, benim de değil."
    },
    {
      "start": 54.7,
      "end": 54.98,
      "text": "Yeter!"
    },
    {
      "start": 59.11,
      "end": 59.41,
      "text": "Bak."
    },
    {
      "start": 59.41,
      "end": 62.31,
      "text": "Ben bu tiyatrodan iyice sıkıldım."
    },
    {
      "start": 62.77,
      "end": 63.19,
      "text": "Tamam mı?"
    },
    {
      "start": 63.19,
      "end": 65.55,
      "text": "Bu bitmek bilmeyen vicdanın..."
    },
    {
      "start": 65.55,
      "end": 67.65,
      "text": "...zabından beni de çocuklarımı da azat et."
    },
    {
      "start": 68.71,
      "end": 69.87,
      "text": "Yalvarıyorum sana."
    }
  ],
