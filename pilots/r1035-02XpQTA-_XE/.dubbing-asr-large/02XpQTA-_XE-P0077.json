  "language_probability": 1,
  "segments": [
    {
      "start": 0.75,
      "end": 3.41,
      "text": "Yine harika bir sabaha uyanmışız bakıyorum."
    },
    {
      "start": 3.63,
      "end": 4.85,
      "text": "Yüzünüzde güller açıyor."
    },
    {
      "start": 5.25,
      "end": 6.09,
      "text": "Annem sağ olsun."
    },
    {
      "start": 7.41,
      "end": 9.65,
      "text": "Dün gece sayesinde bayağı eğlendik."
    },
    {
      "start": 9.71,
      "end": 10.57,
      "text": "İzledim izledim."
    },
    {
      "start": 10.77,
      "end": 11.63,
      "text": "İnternete düşmüş."
    },
    {
      "start": 12.11,
      "end": 13.59,
      "text": "Ama güzel kafaydı sanki."
    },
    {
      "start": 13.73,
      "end": 14.87,
      "text": "Ben beğendim açıkçası."
    },
    {
      "start": 15.63,
      "end": 16.55,
      "text": "Ses sonuçları çıkmış."
    },
    {
      "start": 21.75,
      "end": 22.21,
      "text": "Ece'nin."
    },
    {
      "start": 24.22,
      "end": 25.48,
      "text": "Ablacığım abicim."
    },
    {
      "start": 25.66,
      "end": 28.02,
      "text": "Beni bu kadar düşündüğünüzü bilmiyordum valla."
    },
    {
      "start": 28.58,
      "end": 29.66,
      "text": "Sağ olun var olun."
    },
    {
      "start": 30.0,
      "end": 31.12,
      "text": "Sonuçlar gayet iyi."
    },
    {
      "start": 31.44,
      "end": 32.64,
      "text": "Daha da iyi olacak tamam mı?"
    },
    {
      "start": 32.64,
      "end": 33.94,
      "text": "Hadi gözümüz aydın o zaman."
    },
    {
      "start": 34.12,
      "end": 35.06,
      "text": "Ben çıkıyorum gel."
    },
    {
      "start": 35.06,
      "end": 40.58,
      "text": "Bugün abinizin doğum günü."
    },
    {
      "start": 44.03,
      "end": 45.03,
      "text": "Yaşıyor muymuş hala?"
    },
    {
      "start": 50.13,
      "end": 52.37,
      "text": "Bari bu sefer doğum gününe gelecek mi kendisi?"
    },
    {
      "start": 53.49,
      "end": 54.93,
      "text": "Siz akşam evde olun."
    },
    {
      "start": 55.95,
      "end": 56.51,
      "text": "Geç kalmayın."
    },
    {
      "start": 57.91,
      "end": 59.17,
      "text": "Ben Demirbaş evdeyim."
    },
    {
      "start": 59.35,
      "end": 59.85,
      "text": "Beklerim."
    },
    {
      "start": 60.35,
      "end": 64.59,
      "text": "Başlayacağım."
    }
  ],
