  "source_sha256": "39e7dd58f267d143cf668595250f0efed2edb7e36f15279e851613f072e04809",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 1.18,
      "text": "Tamam var ya."
    },
    {
      "start": 2.18,
      "end": 2.98,
      "text": "Tamam tamam."
    },
    {
      "start": 3.1,
      "end": 4.26,
      "text": "İkisine de yeter belki."
    },
    {
      "start": 4.68,
      "end": 5.86,
      "text": "Bir dakika hangi ikisine?"
    },
    {
      "start": 6.26,
      "end": 7.12,
      "text": "Yatakla şopem mi?"
    },
    {
      "start": 7.28,
      "end": 8.66,
      "text": "Çamaşır makinesiyle şopene."
    },
    {
      "start": 8.88,
      "end": 10.66,
      "text": "Ya bu yatak listeden niye çıkıyor ya?"
    },
    {
      "start": 10.74,
      "end": 11.7,
      "text": "Ben bunu anlamadım oğlum."
    },
    {
      "start": 11.8,
      "end": 12.92,
      "text": "Sen de bir destek atsana lan."
    },
    {
      "start": 13.12,
      "end": 13.94,
      "text": "Lan sen bilmiyorsun."
    },
    {
      "start": 14.06,
      "end": 15.16,
      "text": "Düne kadar yerde yatıyorduk."
    },
    {
      "start": 15.22,
      "end": 16.24,
      "text": "Neyin orta pedik yatağı?"
    },
    {
      "start": 16.66,
      "end": 18.64,
      "text": "Tamam bölüşelim abi o zaman parayı."
    },
    {
      "start": 18.98,
      "end": 20.24,
      "text": "Kim ne ettiriyorsa yani."
    },
    {
      "start": 20.4,
      "end": 21.04,
      "text": "Bence de."
    },
    {
      "start": 21.4,
      "end": 22.06,
      "text": "E televizyon?"
    },
    {
      "start": 23.76,
      "end": 24.28,
      "text": "Televizyon?"
    },
    {
      "start": 24.94,
      "end": 25.36,
      "text": "Ya ne?"
    },
    {
      "start": 25.62,
      "end": 25.9,
      "text": "Ver lan."
    },
    {
      "start": 26.26,
      "end": 26.52,
      "text": "Yok."
    },
    {
      "start": 26.66,
      "end": 27.12,
      "text": "Ver ver ver."
    },
    {
      "start": 27.12,
      "end": 29.08,
      "text": "Oğlum bir dakika ya ne oluyor be?"
    },
    {
      "start": 29.2,
      "end": 29.98,
      "text": "Konu kapandı."
    },
    {
      "start": 30.46,
      "end": 31.04,
      "text": "E ama muhafaza."
    },
    {
      "start": 31.04,
      "end": 31.48,
      "text": "Haydi."
    },
    {
      "start": 32.14,
      "end": 33.56,
      "text": "Ya oynasaydık bari be."
    },
    {
      "start": 35.32,
      "end": 36.44,
      "text": "Ne sırıtıyorsun lan?"
    }
  ],
