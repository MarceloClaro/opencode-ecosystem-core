  "language_probability": 1,
  "segments": [
    {
      "start": 3.47,
      "end": 4.39,
      "text": "Hadi devam et."
    },
    {
      "start": 4.91,
      "end": 12.35,
      "text": "Aferin benim abime."
    },
    {
      "start": 14.37,
      "end": 15.33,
      "text": "Aferin abime."
    },
    {
      "start": 16.13,
      "end": 16.93,
      "text": "Ne oldu abim?"
    },
    {
      "start": 17.25,
      "end": 19.23,
      "text": "Verdin cüzdanını ne oldu abim?"
    },
    {
      "start": 19.29,
      "end": 20.81,
      "text": "Daha mı delikanlı adam oldun?"
    },
    {
      "start": 20.89,
      "end": 22.35,
      "text": "Daha mı erkek oldun şimdi ne oldu?"
    },
    {
      "start": 22.43,
      "end": 23.47,
      "text": "Ne biçim konuşuyorsun oğlum sen?"
    },
    {
      "start": 23.51,
      "end": 26.63,
      "text": "O biçim konuşuyorum abi çatır çatır yiyecektik o paraları biz."
    },
    {
      "start": 26.99,
      "end": 29.63,
      "text": "El alemi pas keseceğim diye al elde var sıfır gene."
    },
    {
      "start": 29.69,
      "end": 30.85,
      "text": "Oğlum para senin mi benim mi lan?"
    },
    {
      "start": 31.03,
      "end": 31.93,
      "text": "Nasıl yiyecektin o parayı?"
    },
    {
      "start": 32.33,
      "end": 33.31,
      "text": "Nasıl geçecektin boğazından?"
    },
    {
      "start": 33.31,
      "end": 35.67,
      "text": "Ya yemişim seni fakire ama gururlu edebiyatım."
    },
    {
      "start": 35.69,
      "end": 36.29,
      "text": "Seni var ya."
    },
    {
      "start": 36.65,
      "end": 36.97,
      "text": "Hıday!"
    },
    {
      "start": 40.24,
      "end": 41.12,
      "text": "Hıday ya!"
    },
    {
      "start": 42.18,
      "end": 44.74,
      "text": "Bugün güya benim en mutlu günüm güya ya."
    },
    {
      "start": 45.42,
      "end": 46.14,
      "text": "Eman abi."
    },
    {
      "start": 46.58,
      "end": 48.7,
      "text": "Ya niye kavga ediyorsunuz ya niye kavga ediyorsunuz?"
    },
    {
      "start": 49.42,
      "end": 51.24,
      "text": "Bugün mi abi bugün mü seçtiniz ya?"
    },
    {
      "start": 51.68,
      "end": 51.9,
      "text": "Ya."
    },
    {
      "start": 53.04,
      "end": 55.6,
      "text": "Ya yok oğlum sen ne bakıyorsun bize ya?"
    },
    {
      "start": 55.62,
      "end": 57.74,
      "text": "Ya oğlum ne olacak lan bizim kavgamızdan?"
    },
    {
      "start": 57.86,
      "end": 59.04,
      "text": "Kardeşiz lan biz kardeş."
    },
    {
      "start": 59.56,
      "end": 61.08,
      "text": "Asi sen ne diyordun biz kavga edince?"
    },
    {
      "start": 61.18,
      "end": 62.16,
      "text": "Kardeş kardeş bir şey yapıyordun."
    },
    {
      "start": 62.16,
      "end": 66.02,
      "text": "Kardeş kardeşi bıçaklamış sonra dönmüş yine kucaklamış."
    },
    {
      "start": 66.04,
      "end": 66.6,
      "text": "Ha aynen."
    },
    {
      "start": 69.7,
      "end": 70.52,
      "text": "Tamam barışın o zaman."
    },
    {
      "start": 70.68,
      "end": 70.84,
      "text": "Tamam."
    }
  ],
