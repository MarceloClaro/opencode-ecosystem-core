  "key": "15af9ac5da9e7db65674a101b86f6f7b96219e591651d4df12f1a5b30d52af55",
  "source_sha256": "a2412c78876d9de50d9338d2f97bceaead2d35a532d711aea7d3f30f4085de66",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.14,
      "end": 4.02,
      "text": "Ya nereden baksan dev hizmet yaptın oğlum sen."
    },
    {
      "start": 4.5,
      "end": 7.94,
      "text": "Bu paraları kuruşu kuruşuna hak ettik biz güzel kardeşim."
    },
    {
      "start": 8.08,
      "end": 9.36,
      "text": "Tamam sen hak ettin yani."
    },
    {
      "start": 9.48,
      "end": 9.7,
      "text": "Evet."
    },
    {
      "start": 11.12,
      "end": 13.64,
      "text": "O yüzden anası bin doları gözünü kırpmadan attı önüme."
    },
    {
      "start": 14.78,
      "end": 18.58,
      "text": "Yani biz emeğimizin karşılığını aldık mı aldık."
    },
    {
      "start": 19.54,
      "end": 22.4,
      "text": "Umut'un muayene ücretini bulduk mu bulduk."
    },
    {
      "start": 28.94,
      "end": 29.84,
      "text": "Biz hırsız değiliz oğlum."
    },
    {
      "start": 32.15,
      "end": 34.51,
      "text": "Aynen abi aynen biz hırsız değiliz."
    },
    {
      "start": 34.51,
      "end": 36.61,
      "text": "Biz safız abi biz iflah olmaz."
    },
    {
      "start": 36.61,
      "end": 38.71,
      "text": "Biz zekalılarız güzel abicim aynen."
    },
    {
      "start": 38.93,
      "end": 39.33,
      "text": "Sesur."
    },
    {
      "start": 40.43,
      "end": 40.67,
      "text": "Ne?"
    },
    {
      "start": 41.81,
      "end": 43.91,
      "text": "Ya oğlum taksi parası için aldım onu."
    },
    {
      "start": 44.03,
      "end": 45.93,
      "text": "Vallahi taksi parası için aldım ya."
    },
    {
      "start": 46.29,
      "end": 48.67,
      "text": "Ne yapacağız sırtımızda mı taşıyacağız bunu ya bunca yol."
    },
    {
      "start": 49.43,
      "end": 50.77,
      "text": "Sen az değilsin oğlum."
    },
    {
      "start": 55.44,
      "end": 55.96,
      "text": "Halledeceğiz."
    },
    {
      "start": 59.7,
      "end": 60.52,
      "text": "Yaşasın Allah."
    },
    {
      "start": 70.04,
      "end": 70.76,
      "text": "Allah Allah."
    }
  ],
