    {
      "start": 25.55,
      "end": 26.85,
      "text": "Evin ailen falan yok mu?"
    },
    {
      "start": 30.26,
      "end": 31.0,
      "text": "Yoksa sen sokak..."
    },
    {
      "start": 31.0,
      "end": 31.98,
      "text": "Ben artık gidebilir miyim?"
    },
    {
      "start": 34.49,
      "end": 36.91,
      "text": "Oğlum ve arkadaşını çok zor bir durumdan kurtarmışsın."
    },
    {
      "start": 38.79,
      "end": 40.67,
      "text": "Ben de senin için bir şeyler yapmak istiyorum."
    },
    {
      "start": 46.99,
      "end": 48.03,
      "text": "Neye ihtiyacın varsa."
    },
    {
      "start": 56.47,
      "end": 58.41,
      "text": "Okuman yazman yoksa vakıf başkanıyım ben."
    },
    {
      "start": 59.23,
      "end": 60.51,
      "text": "Sokak çocuklarını koruma vakti."
    },
    {
      "start": 60.53,
      "end": 62.11,
      "text": "Kimi kimden koruyorsunuz tam olarak?"
    },
    {
      "start": 64.98,
      "end": 66.0,
      "text": "Bizi sokaklardan mı?"
    },
    {
      "start": 67.76,
      "end": 69.28,
      "text": "Yoksa sokakları bizden mi?"
    }
  ],
