  "source_sha256": "aa03aab058f8f7c69df7e21392b396eb402ed1c9ad30a3a01b472a8f52183e93",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 16.37,
      "end": 17.37,
      "text": "Asi."
    },
    {
      "start": 18.17,
      "end": 21.13,
      "text": "Şunun sandalyesini Bit pazarında okutsak yemin ediyorum..."
    },
    {
      "start": 21.21,
      "end": 23.93,
      "text": "...hem çamaşır makinesine getiririm ben hem de yatağa."
    },
    {
      "start": 24.01,
      "end": 25.89,
      "text": "Çok doğru bir şey söyledin. İn lan aşağıya."
    },
    {
      "start": 25.97,
      "end": 27.17,
      "text": "Ya in lan aşağıya."
    },
    {
      "start": 27.25,
      "end": 28.13,
      "text": "İnan lan."
    },
    {
      "start": 28.21,
      "end": 29.65,
      "text": "Ne biçim tutun ya."
    },
    {
      "start": 29.73,
      "end": 31.49,
      "text": "Aa sürme lan. Sürme lan."
    },
    {
      "start": 31.57,
      "end": 32.61,
      "text": "Lan bırak, sürme."
    },
    {
      "start": 32.69,
      "end": 33.85,
      "text": "Ben ne yapayım?"
    },
    {
      "start": 33.93,
      "end": 36.13,
      "text": "Gıdıkla, gıdıkla bunu. Gıdıkla."
    },
    {
      "start": 37.01,
      "end": 38.09,
      "text": "Ya bırak, bırak."
    },
    {
      "start": 38.17,
      "end": 39.69,
      "text": "Abi bırak. Ne be sallanayım?"
    },
    {
      "start": 39.77,
      "end": 40.97,
      "text": "Ne be sallanayım?"
    },
    {
      "start": 41.05,
      "end": 42.45,
      "text": "Ya bırak."
    },
    {
      "start": 42.53,
      "end": 43.93,
      "text": "Aa yakaladım."
    },
    {
      "start": 43.93,
      "end": 45.93,
      "text": "Bıtır satsam belli. Sat, sat, sat."
    },
    {
      "start": 46.01,
      "end": 47.13,
      "text": "Abla ne olur bırak."
    },
    {
      "start": 47.21,
      "end": 49.05,
      "text": "Ya biz gidiyoruz."
    },
    {
      "start": 49.13,
      "end": 51.05,
      "text": "Ya abla ne olur bırak abla."
    },
    {
      "start": 51.13,
      "end": 52.73,
      "text": "Ablası ya. Kıyamam ben buna."
    },
    {
      "start": 52.81,
      "end": 54.17,
      "text": "Getir şunun emziğini. Al iyice."
    },
    {
      "start": 54.25,
      "end": 56.81,
      "text": "Oy kıyamam ama umurumda değil."
    },
    {
      "start": 56.89,
      "end": 57.77,
      "text": "Hadi ben gittim."
    },
    {
      "start": 57.85,
      "end": 60.21,
      "text": "Ya Asi abla ne olur bırak abla. Ne olur ya."
    },
    {
      "start": 60.29,
      "end": 61.57,
      "text": "Lan bırak."
    },
    {
      "start": 61.65,
      "end": 63.29,
      "text": "Hoş bulduk."
    },
    {
      "start": 63.37,
      "end": 65.77,
      "text": "Sen hayırdır lan? Yolunu mu kaybettin gene?"
    },
    {
      "start": 66.77,
      "end": 68.57,
      "text": "Oğlum bir hoş geldin demek yok mu ya?"
    },
    {
      "start": 68.65,
      "end": 70.21,
      "text": "Her zaman bekleriz diyordu."
    },
    {
      "start": 71.25,
      "end": 73.53,
      "text": "İlle bir dayanı yiyeceğim diyorsun yani."
    }
  ],
