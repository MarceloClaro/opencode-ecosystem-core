  "segments": [
    {
      "start": 36.69,
      "end": 38.69,
      "text": "Nasılsın Mr. Mikkel?"
    },
    {
      "start": 38.69,
      "end": 40.69,
      "text": "Nasılsın?"
    },
    {
      "start": 40.69,
      "end": 42.69,
      "text": "İyiyim, teşekkürler."
    },
    {
      "start": 42.69,
      "end": 44.69,
      "text": "İzlediğiniz için teşekkürler."
    },
    {
      "start": 44.69,
      "end": 46.69,
      "text": "İzlediğiniz için teşekkürler."
    },
    {
      "start": 46.69,
      "end": 50.69,
      "text": "Arkadaşlar, konferans başlamak üzere sadece tek bir soru alabiliriz."
    },
    {
      "start": 50.69,
      "end": 52.69,
      "text": "Mucize doktoru diyorlar kendisine."
    },
    {
      "start": 52.69,
      "end": 58.69,
      "text": "Astronomik muayene ücretlerine rağmen randevularının aylar öncesinden dolu olduğunu öğrendik."
    },
    {
      "start": 58.69,
      "end": 60.69,
      "text": "Yalnız bu bir soru değil, soru alalım."
    },
    {
      "start": 60.69,
      "end": 62.69,
      "text": "Gerçekten mucizeler yalancı biliyor musunuz efendim?"
    },
    {
      "start": 62.69,
      "end": 66.69,
      "text": "Bu çok çok ünlü bir dünyanın doktoru."
    },
    {
      "start": 66.69,
      "end": 68.69,
      "text": "Kendisinin bütün randevuları dolu arkadaşlar."
    },
    {
      "start": 68.69,
      "end": 70.69,
      "text": "Sağ olsun bizim ricamızı kırmadı."
    },
    {
      "start": 70.69,
      "end": 72.69,
      "text": "Geldi."
    },
    {
      "start": 72.69,
      "end": 74.69,
      "text": "Sağ ol, sağ ol."
    },
    {
      "start": 74.69,
      "end": 76.69,
      "text": "Anne."
    }
  ],
