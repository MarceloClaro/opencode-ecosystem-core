  "source_sha256": "5e4241efdf3fadb1fb411fea226c66376f3a54fe1e2e8c15014e5a4d4663e1bf",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 1.44,
      "text": "Bana da cesur demesinler."
    },
    {
      "start": 1.58,
      "end": 3.56,
      "text": "Yaman, bu yarışı o çocuğu öldürür."
    },
    {
      "start": 3.58,
      "end": 5.32,
      "text": "Ona gerek kalmayacak sen merak etme."
    },
    {
      "start": 5.4,
      "end": 7.38,
      "text": "O çocuğa bir şey olursa..."
    },
    {
      "start": 7.38,
      "end": 9.08,
      "text": "...annesi umutlu tedavi etmez."
    },
    {
      "start": 14.82,
      "end": 15.78,
      "text": "Ya kadın yardım et."
    },
    {
      "start": 20.34,
      "end": 22.8,
      "text": "Biz yıl vardır bunun için uğraşmıyor muyuz?"
    },
    {
      "start": 23.22,
      "end": 24.6,
      "text": "Tek hayalimiz bu değil miydi?"
    },
    {
      "start": 24.64,
      "end": 25.56,
      "text": "Bu çocuğun yürümesi."
    },
    {
      "start": 26.7,
      "end": 29.28,
      "text": "Bak bu bizim ilk ve son şansımız."
    },
    {
      "start": 29.38,
      "end": 30.7,
      "text": "Bunu iyi değerlendireceksin."
    },
    {
      "start": 31.86,
      "end": 33.3,
      "text": "Yaman diyorsa ne olur?"
    },
    {
      "start": 33.92,
      "end": 34.48,
      "text": "Ne olur?"
    },
    {
      "start": 35.12,
      "end": 36.0,
      "text": "Durur mu yerinde?"
    },
    {
      "start": 36.0,
      "end": 38.22,
      "text": "Gider öldürür çocuğu."
    },
    {
      "start": 38.22,
      "end": 40.64,
      "text": "Kim çocuğuna zarar veren birine yardım eder?"
    },
    {
      "start": 41.06,
      "end": 41.62,
      "text": "Söylesene."
    },
    {
      "start": 42.14,
      "end": 43.34,
      "text": "Ben bunu nasıl yutayım?"
    },
    {
      "start": 44.1,
      "end": 45.64,
      "text": "Nasıl yutayım ben bunu?"
    },
    {
      "start": 45.94,
      "end": 47.4,
      "text": "Herifler ordu gibi geldiler."
    },
    {
      "start": 47.5,
      "end": 48.76,
      "text": "Bir tane adama saldırıyorlar."
    },
    {
      "start": 49.12,
      "end": 51.66,
      "text": "Hak mı lan? Ben bunu nasıl yutayım?"
    },
    {
      "start": 52.64,
      "end": 53.32,
      "text": "Yutacaksın."
    },
    {
      "start": 64.48,
      "end": 66.64,
      "text": "Umut için, son umudumuz için..."
    },
    {
      "start": 66.64,
      "end": 67.24,
      "text": "...bunu da yutacaksın."
    }
  ],
