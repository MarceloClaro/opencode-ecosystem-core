    {
      "start": 2.9,
      "end": 4.12,
      "text": "Sevda ne yapma?"
    },
    {
      "start": 4.22,
      "end": 5.88,
      "text": "Her şeyin var her şeyin."
    },
    {
      "start": 6.76,
      "end": 8.92,
      "text": "Zengin bir baban, anlayışlı bir kocan."
    },
    {
      "start": 9.16,
      "end": 10.88,
      "text": "Dünya güzeli üç tane çocuk."
    },
    {
      "start": 10.94,
      "end": 11.28,
      "text": "Dört."
    },
    {
      "start": 12.78,
      "end": 14.42,
      "text": "Dört çocuğu var benim."
    },
    {
      "start": 14.8,
      "end": 17.34,
      "text": "Ama sen sahip olduğun şeyler yerine..."
    },
    {
      "start": 17.34,
      "end": 19.24,
      "text": "...sahip olamadığın tek şeye odaklanma."
    },
    {
      "start": 19.32,
      "end": 20.48,
      "text": "Hayatı kendine zehre taş."
    },
    {
      "start": 21.08,
      "end": 22.4,
      "text": "Aynen böyle devam et."
    },
    {
      "start": 22.54,
      "end": 23.74,
      "text": "Aynen böyle arkadaşım."
    },
    {
      "start": 45.59,
      "end": 45.89,
      "text": "Rüya."
    },
    {
      "start": 47.01,
      "end": 47.65,
      "text": "Rüya."
    },
    {
      "start": 49.19,
      "end": 51.09,
      "text": "Sabahtan beri arıyorum mesaj atıyorum."
    },
    {
      "start": 51.09,
      "end": 51.87,
      "text": "Niye cevaplamıyorsun?"
    },
    {
      "start": 51.87,
      "end": 55.33,
      "text": "Rüya."
    },
    {
      "start": 61.16,
      "end": 62.46,
      "text": "Ne oluyor Rüya ne oluyor?"
    },
    {
      "start": 63.5,
      "end": 64.1,
      "text": "Yok bir şey."
    },
    {
      "start": 65.42,
      "end": 66.1,
      "text": "Ne olabilir ki?"
