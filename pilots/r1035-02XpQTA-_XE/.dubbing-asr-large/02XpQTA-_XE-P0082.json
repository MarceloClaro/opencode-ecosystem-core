      "text": "Çocukların tahliye sonuçlarını babana vermişler."
    },
    {
      "start": 9.36,
      "end": 11.92,
      "text": "Umarım bu defa annelerinin izahını yapabilirsin."
    },
    {
      "start": 14.04,
      "end": 16.06,
      "text": "Gerçi o seni her zamanki gibi affeder."
    },
    {
      "start": 19.33,
      "end": 21.13,
      "text": "Senin yaptığın hataların bedelini ise..."
    },
    {
      "start": 22.07,
      "end": 23.37,
      "text": "...yine biz ederiz."
    },
    {
      "start": 23.81,
      "end": 33.31,
      "text": "Ben ve çocuklar."
    },
    {
      "start": 41.46,
      "end": 42.94,
      "text": "Ali gelmeyecek o doğum gününe."
    },
    {
      "start": 45.15,
      "end": 47.13,
      "text": "Ali eve dönmeyecek."
    },
    {
      "start": 51.99,
      "end": 53.73,
      "text": "Boşuna insanlar ayağa dikme olmalı."
    }
