  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 5.2,
      "text": "Bak güzel kardeşim benim şimdi birkaç saat öncesine kadar benim bu parayı bulmam da mümkün değildi ama bak buldum."
    },
    {
      "start": 5.36,
      "end": 7.2,
      "text": "Arkadaşım mümkün değil diyorum sana."
    },
    {
      "start": 7.34,
      "end": 9.18,
      "text": "Lan ne mümkün değil lan ne mümkün değil."
    },
    {
      "start": 9.28,
      "end": 10.98,
      "text": "Parası ile değil mi oğlum ne mümkün değil."
    },
    {
      "start": 11.02,
      "end": 13.38,
      "text": "Bak biz muayene olmadan hiçbir yere gitmeyeceğiz ha tamam mı?"
    },
    {
      "start": 13.64,
      "end": 15.36,
      "text": "Ben bu parayı bulduysam sen de bir yolu bulacaksın lan."
    },
    {
      "start": 15.68,
      "end": 16.26,
      "text": "Bak kardeşim."
    },
    {
      "start": 16.36,
      "end": 17.88,
      "text": "Bak kardeşim bak kardeşim yok benim."
    },
    {
      "start": 17.96,
      "end": 18.7,
      "text": "Doktor doktor."
    },
    {
      "start": 20.02,
      "end": 23.61,
      "text": "Bak bir kardeşimi getirdik."
    },
    {
      "start": 24.09,
      "end": 25.19,
      "text": "Hasta hasta."
    },
    {
      "start": 25.55,
      "end": 27.19,
      "text": "Bir dakika bir dakika bir dakika."
    },
    {
      "start": 27.19,
      "end": 28.77,
      "text": "Hay ben it is umut."
    },
    {
      "start": 29.07,
      "end": 29.57,
      "text": "Ne olacak?"
    },
    {
      "start": 29.89,
      "end": 30.43,
      "text": "Ne olacak?"
    },
    {
      "start": 30.43,
      "end": 31.89,
      "text": "Bir sürü yargıç olabilir mi?"
    }
  ],
