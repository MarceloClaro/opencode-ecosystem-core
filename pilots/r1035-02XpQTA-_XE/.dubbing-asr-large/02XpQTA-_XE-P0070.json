  "source_sha256": "8943bfeba8ae81faa0d79421c14c1c5f2e4ff2e3600f07283d3115a18d28ec5d",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.3,
      "end": 3.76,
      "text": "Oğlum siz var ya adamın hevesini kursağında bırakırsınız he."
    },
    {
      "start": 4.68,
      "end": 6.2,
      "text": "Ya tamam söz."
    },
    {
      "start": 6.6,
      "end": 9.22,
      "text": "Ben size çamaşır makinesi de alacağım yatak da alacağım."
    },
    {
      "start": 9.66,
      "end": 11.96,
      "text": "Siz benim ne zaman bir söz verip de tutmadığımı gördünüz ya."
    },
    {
      "start": 12.38,
      "end": 13.4,
      "text": "Söz diyorum söz."
    },
    {
      "start": 13.98,
      "end": 14.66,
      "text": "Yemek."
    },
    {
      "start": 17.12,
      "end": 21.03,
      "text": "Yakışıklım bana bak."
    },
    {
      "start": 23.83,
      "end": 25.69,
      "text": "Ben şu televizyonu var ya şuraya çakayım."
    },
    {
      "start": 26.11,
      "end": 27.37,
      "text": "En çok bu ikisi sevinecek."
    },
    {
      "start": 27.79,
      "end": 29.53,
      "text": "Sen takma kafana ama bunları tamam mı?"
    },
    {
      "start": 30.05,
      "end": 30.37,
      "text": "Söz mü?"
    },
    {
      "start": 33.9,
      "end": 39.91,
      "text": "Asiye hanımın meşhur yemeklerinden bir tanesiyle."
    },
    {
      "start": 39.91,
      "end": 40.73,
      "text": "Havis gibi koktu."
    },
    {
      "start": 43.05,
      "end": 46.04,
      "text": "Bana bak bir şey diyeceğim sana."
    },
    {
      "start": 46.72,
      "end": 48.8,
      "text": "Bizim şu Ayra amcanın çanak çatıdaydı değil mi?"
    },
    {
      "start": 49.46,
      "end": 51.4,
      "text": "Ben bir koşu gideyim bakayım geleyim tamam mı?"
    },
    {
      "start": 51.46,
      "end": 51.64,
      "text": "Tamam."
    },
    {
      "start": 54.8,
      "end": 57.02,
      "text": "Umut'um yakışıklım."
    },
    {
      "start": 57.54,
      "end": 58.28,
      "text": "Bak bana bak."
    },
    {
      "start": 58.82,
      "end": 59.78,
      "text": "Gül oğlum gül biraz."
    },
    {
      "start": 60.98,
      "end": 62.86,
      "text": "Aslanım benim geliyorum hemen he."
    }
  ],
