  "segments": [
    {
      "start": 0.72,
      "end": 2.38,
      "text": "Beni neden cezalandırıyorsun?"
    },
    {
      "start": 3.72,
      "end": 6.94,
      "text": "Neden beni ezmek, üzerine basmak için fırsat kolluyor görmüyor musun?"
    },
    {
      "start": 7.84,
      "end": 10.98,
      "text": "Ve sen her seferinde ısrarla o adama karşı beni mahcup ediyorsun."
    },
    {
      "start": 12.38,
      "end": 14.18,
      "text": "Yaptığın her hatanın faturası bana da kesiliyor."
    },
    {
      "start": 14.68,
      "end": 17.12,
      "text": "Senin hata yapma lüksün yok."
    },
    {
      "start": 20.98,
      "end": 24.4,
      "text": "Daha seni savunacağım, tutunacağım tek bir dal olsun ver artık."
    },
    {
      "start": 38.25,
      "end": 41.31,
      "text": "Canım kızım sen de bana yalan söylemiyorsun değil mi?"
    },
    {
      "start": 65.45,
      "end": 70.06,
      "text": "Baba ilk fesuphanedin bir daha olmayacak."
    },
    {
      "start": 70.06,
      "end": 73.54,
      "text": "Tamam geç arabaya."
    }
  ],
