    {
      "start": 31.5,
      "end": 34.52,
      "text": "Gelmişsiniz siz. Hastane mi basıyorsunuz? Bu ne rezilik böyle?"
    },
    {
      "start": 35.04,
      "end": 37.93,
      "text": "Konuşsana çocuğum konuşsana."
    },
    {
      "start": 38.89,
      "end": 40.97,
      "text": "Ne istiyorsunuz siz? Derdiniz ne sizin?"
    },
    {
      "start": 45.5,
      "end": 47.02,
      "text": "Kardeşim ayağa kalksın istiyoruz."
    },
    {
      "start": 54.82,
      "end": 55.52,
      "text": "Bak şu çocuğa."
    },
    {
      "start": 57.3,
      "end": 57.7,
      "text": "Bak."
    },
    {
      "start": 66.73,
      "end": 67.95,
      "text": "Hala gülümsüyor gördün mü?"
    },
    {
      "start": 70.19,
      "end": 71.57,
      "text": "Çok mu memnun halinden sence?"
    },
    {
      "start": 72.73,
      "end": 73.55,
      "text": "Çok mu mutlu?"
    }
