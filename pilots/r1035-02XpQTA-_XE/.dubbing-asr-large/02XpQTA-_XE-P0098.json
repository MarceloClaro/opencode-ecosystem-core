  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 4.24,
      "end": 5.1,
      "text": "Hadi bakalım."
    },
    {
      "start": 6.18,
      "end": 6.94,
      "text": "Önce dilekler."
    },
    {
      "start": 7.8,
      "end": 11.2,
      "text": "Umarım bir dahaki doğum gününe gelip kendisi yüpler."
    },
    {
      "start": 15.7,
      "end": 17.44,
      "text": "Yaşıyorsa dönsün gelsin artık."
    },
    {
      "start": 20.4,
      "end": 22.18,
      "text": "Öldüyse de cesedini bulalım artık."
    },
    {
      "start": 24.96,
      "end": 25.54,
      "text": "Mümkünse."
    },
    {
      "start": 26.14,
      "end": 26.72,
      "text": "Allah'a ıslan."
    },
    {
      "start": 33.28,
      "end": 34.08,
      "text": "Efendim dede."
    },
    {
      "start": 36.65,
      "end": 37.59,
      "text": "Ali yok, Allah'a ıslan burada."
    },
    {
      "start": 37.85,
      "end": 38.93,
      "text": "Evet buyur dinliyorum."
    },
    {
      "start": 44.76,
      "end": 46.4,
      "text": "Ya Ali yok, Ali yok artık."
    },
    {
      "start": 48.2,
      "end": 49.5,
      "text": "Biz varız, ben varım."
    },
    {
      "start": 53.31,
      "end": 57.09,
      "text": "Elinde tek erkek torun ben kaldığım için gerçekten çok üzgünüm."
    },
    {
      "start": 57.09,
      "end": 60.52,
      "text": "Sana benzemediğim için."
    },
    {
      "start": 61.6,
      "end": 65.62,
      "text": "Bir torunda aradığın her neyse bende olmadığı için gerçekten çok üzgünüm ama..."
    },
    {
      "start": 65.62,
      "end": 66.48,
      "text": "...elinizde kalan bu."
    },
    {
      "start": 67.22,
      "end": 68.02,
      "text": "Yani malzeme bu."
    },
    {
      "start": 71.5,
      "end": 72.24,
      "text": "Ya bir şey soracağım."
    },
    {
      "start": 73.24,
      "end": 74.56,
      "text": "Sen benim doğum günümü hatırlıyormuşsun."
    }
  ],
