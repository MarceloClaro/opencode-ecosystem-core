  "segments": [
    {
      "start": 0.72,
      "end": 4.08,
      "text": "Dedim ya oğlum senin zorun ne?"
    },
    {
      "start": 5.48,
      "end": 8.32,
      "text": "Dedi ki dede kuşun yuvasını dağıttılar."
    },
    {
      "start": 9.92,
      "end": 11.66,
      "text": "Yavru kuşun birini kedi katlı yedi."
    },
    {
      "start": 12.5,
      "end": 14.04,
      "text": "Diğerini de annesi terk etti gitti."
    },
    {
      "start": 17.14,
      "end": 21.98,
      "text": "Dedim oğlum sen bir kuşun canı için kendi canından mı geçtin?"
    },
    {
      "start": 21.98,
      "end": 46.66,
      "text": "Bir de sıkılmadın mı bunları dinlemekten kaç lira anlatıyorum sana bu hikayeyi."
    },
    {
      "start": 46.78,
      "end": 47.94,
      "text": "Devam edin lütfen."
    },
    {
      "start": 54.3,
      "end": 56.98,
      "text": "Aldık işte eve getirdik kuşu ve terner çağırdık."
    },
    {
      "start": 56.98,
      "end": 63.02,
      "text": "Kendi elleriyle baktı sonra saldı gökyüzüne gitti."
    },
    {
      "start": 64.74,
      "end": 65.78,
      "text": "Beş yaşındaydı daha."
    },
    {
      "start": 68.2,
      "end": 71.8,
      "text": "Öyle merhametliydi bu öyle vicdan sahibi."
    },
    {
      "start": 72.62,
      "end": 74.26,
      "text": "Bildiğin gözü kara."
    }
  ],
