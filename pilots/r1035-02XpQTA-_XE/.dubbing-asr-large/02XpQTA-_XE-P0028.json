  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.08,
      "end": 4.68,
      "text": "Vay Salim abim."
    },
    {
      "start": 4.68,
      "end": 5.4,
      "text": "Oh."
    },
    {
      "start": 7.36,
      "end": 8.88,
      "text": "Eyvallah."
    },
    {
      "start": 10.34,
      "end": 12.04,
      "text": "Ne bu ya?"
    },
    {
      "start": 13.16,
      "end": 14.82,
      "text": "Bunu bana versene."
    },
    {
      "start": 15.5,
      "end": 16.22,
      "text": "Umut hadi."
    },
    {
      "start": 16.4,
      "end": 17.68,
      "text": "Ben bineyim."
    },
    {
      "start": 17.82,
      "end": 18.68,
      "text": "İn aşağı."
    },
    {
      "start": 20.64,
      "end": 23.1,
      "text": "Sen ne yapacaksın tekerlikli sandalyeyi?"
    },
    {
      "start": 23.64,
      "end": 24.16,
      "text": "Lazım."
    },
    {
      "start": 24.74,
      "end": 25.26,
      "text": "Ne lazım?"
    },
    {
      "start": 25.74,
      "end": 26.76,
      "text": "Uçak motoru takacağım."
    },
    {
      "start": 27.66,
      "end": 30.74,
      "text": "Abim sana araç ne gerekse uçuyorsun ya zaten."
    },
    {
      "start": 30.74,
      "end": 31.78,
      "text": "Nasıl uçuyor?"
    },
    {
      "start": 31.9,
      "end": 32.88,
      "text": "Baya pırr diye."
    },
    {
      "start": 33.76,
      "end": 34.62,
      "text": "Hadi lan versene."
    },
    {
      "start": 34.82,
      "end": 36.12,
      "text": "Hadi geç kaldık ya."
    },
    {
      "start": 36.86,
      "end": 39.84,
      "text": "O zaman senin de."
    },
    {
      "start": 40.26,
      "end": 40.72,
      "text": "Çalışma."
    },
    {
      "start": 42.9,
      "end": 43.94,
      "text": "Umut abi."
    },
    {
      "start": 45.52,
      "end": 46.2,
      "text": "Kalk."
    },
    {
      "start": 50.77,
      "end": 51.79,
      "text": "Bir duş al."
    },
    {
      "start": 52.39,
      "end": 53.21,
      "text": "Ne oluyor ya?"
    },
    {
      "start": 53.45,
      "end": 53.97,
      "text": "Kes sesini."
    },
    {
      "start": 54.37,
      "end": 55.55,
      "text": "Sesini bile duymak istemiyorum."
    },
    {
      "start": 56.07,
      "end": 57.13,
      "text": "İkiniz de aşağıda bekliyorum."
    },
    {
      "start": 57.37,
      "end": 59.31,
      "text": "Anne ben neden geliyorum pardon da?"
    },
    {
      "start": 59.31,
      "end": 61.03,
      "text": "Aşağıda bekliyorum dedim."
    },
    {
      "start": 61.87,
      "end": 62.59,
      "text": "Ya anne."
    },
    {
      "start": 63.11,
      "end": 66.07,
      "text": "Nereye gidiyoruz ya sabah sabah?"
    },
    {
      "start": 68.47,
      "end": 69.43,
      "text": "Hem bu."
    },
    {
      "start": 70.45,
      "end": 71.63,
      "text": "Odanın hali ne lan böyle?"
    },
    {
      "start": 71.63,
      "end": 71.71,
      "text": "Ne?"
    }
  ],
