  "language_probability": 1,
  "segments": [
    {
      "start": 1.04,
      "end": 4.04,
      "text": "Ya da annem hatırlıyor mu? Anne sen hatırlıyor musun benim doğum günümü?"
    },
    {
      "start": 8.85,
      "end": 12.37,
      "text": "Babam hatırlatmasa hanginiz biliyor ya?"
    },
    {
      "start": 13.71,
      "end": 15.37,
      "text": "Ya da hangimizin değeri var gözünüzde?"
    },
    {
      "start": 21.85,
      "end": 22.87,
      "text": "Üçümüzü topladınız."
    },
    {
      "start": 23.97,
      "end": 24.85,
      "text": "Bir hale etmedik be."
    },
    {
      "start": 38.33,
      "end": 39.83,
      "text": "Ama benden bu kadar. Tamam mı?"
    },
    {
      "start": 41.11,
      "end": 43.43,
      "text": "Benim artık bu saçmalığa tahammülüm yok."
    },
    {
      "start": 44.81,
      "end": 46.23,
      "text": "Ya yüzünü bile hatırlamadım."
    },
    {
      "start": 46.75,
      "end": 49.39,
      "text": "Ölü bir abinin hayaletiyle yaşamak istemiyorum ben artık."
    },
    {
      "start": 49.53,
      "end": 53.28,
      "text": "Abin ölmedi. Kaçırıldı."
    },
    {
      "start": 53.28,
      "end": 58.72,
      "text": "Sahip çıksaydın o zaman kıymetli oğluna."
    },
    {
      "start": 58.92,
      "end": 61.12,
      "text": "Falaz odana çık."
    }
  ],
