  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 2.38,
      "text": "Gayet iyiler çocuklar gayet iyi."
    },
    {
      "start": 4.35,
      "end": 5.15,
      "text": "Öpeyim mi dadı?"
    },
    {
      "start": 9.46,
      "end": 10.8,
      "text": "Ben de öpeyim de diyeceğim."
    },
    {
      "start": 18.9,
      "end": 20.66,
      "text": "Serserinin biri önünü kesmiş."
    },
    {
      "start": 20.96,
      "end": 21.8,
      "text": "Güzdanını istemiş."
    },
    {
      "start": 23.5,
      "end": 25.98,
      "text": "Yani Allah'a zira tabii karşı çıkınca işte olan olmuş."
    },
    {
      "start": 26.14,
      "end": 27.28,
      "text": "Biz de pansumanı getirdik."
    },
    {
      "start": 33.02,
      "end": 33.76,
      "text": "Geçmiş olsun."
    },
    {
      "start": 34.32,
      "end": 34.92,
      "text": "Sağ ol dede."
    },
    {
      "start": 38.5,
      "end": 39.98,
      "text": "Kan tatili için sebep peki?"
    },
    {
      "start": 39.98,
      "end": 42.76,
      "text": "O şey tamamen rutin."
    },
    {
      "start": 44.0,
      "end": 45.64,
      "text": "Uzun zamandır ihmal etmiştik."
    },
    {
      "start": 46.06,
      "end": 46.74,
      "text": "İyi etmişsiniz."
    },
    {
      "start": 46.74,
      "end": 50.02,
      "text": "Annelik babalık ihmale gelmez."
    },
    {
      "start": 50.98,
      "end": 52.38,
      "text": "Sonuçları ağır olur sonra."
    },
    {
      "start": 59.57,
      "end": 60.49,
      "text": "Ben hallederim baba."
    },
    {
      "start": 68.43,
      "end": 70.17,
      "text": "Adanziye her şeylerine bakılsın."
    },
    {
      "start": 70.73,
      "end": 72.67,
      "text": "Sonuçları da direkt bana gönderin."
    },
    {
      "start": 72.95,
      "end": 73.43,
      "text": "Hemen efendim."
    }
  ],
