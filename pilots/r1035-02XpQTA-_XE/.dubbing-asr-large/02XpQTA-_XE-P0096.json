  "segments": [
    {
      "start": 6.96,
      "end": 8.18,
      "text": "Susuz kalmışsın."
    },
    {
      "start": 9.1,
      "end": 9.88,
      "text": "Su içilecek."
    },
    {
      "start": 13.05,
      "end": 14.33,
      "text": "Sen de güneşe çık azıcık."
    },
    {
      "start": 17.92,
      "end": 20.32,
      "text": "Neslihan, D vitamini takviyesi yapın."
    },
    {
      "start": 20.4,
      "end": 21.14,
      "text": "Sen takip et."
    },
    {
      "start": 21.48,
      "end": 22.0,
      "text": "Tabii baba."
    },
    {
      "start": 23.14,
      "end": 23.5,
      "text": "Dede?"
    },
    {
      "start": 24.24,
      "end": 25.54,
      "text": "Dede senin gülü."
    },
    {
      "start": 26.92,
      "end": 32.55,
      "text": "Bak şimdi sen benden böyle."
    },
    {
      "start": 34.41,
      "end": 35.25,
      "text": "Ne oldu saçlar?"
    },
    {
      "start": 35.37,
      "end": 37.13,
      "text": "Teşekkür ederim babacığım."
    },
    {
      "start": 53.14,
      "end": 54.78,
      "text": "Gerçek sonuçları dedene göndertmedim."
    },
    {
      "start": 55.88,
      "end": 56.8,
      "text": "Yüreğine inmesin diye."
    },
    {
      "start": 57.56,
      "end": 59.6,
      "text": "Yarından itibaren uçturucu tedavisine başlıyorsun."
    },
    {
      "start": 59.6,
      "end": 65.57,
      "text": "Senin tahlillerin temiz çıktı."
    },
    {
      "start": 66.89,
      "end": 68.83,
      "text": "Ama Rüzgar'ı polise şikayet ettim."
    },
    {
      "start": 69.25,
      "end": 70.47,
      "text": "Sen de gidip ifade vereceksin."
    }
  ],
