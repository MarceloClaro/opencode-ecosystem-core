  "segments": [
    {
      "start": 0.0,
      "end": 3.56,
      "text": "Şu öbür kız var ya, bir kere ya, bir kere bile off çekmedi."
    },
    {
      "start": 3.98,
      "end": 6.64,
      "text": "Bebek gibi yedirdi içirdi, her şeyi yaptı Umut için."
    },
    {
      "start": 8.1,
      "end": 9.54,
      "text": "Ya biz çok bir şey istemiyoruz."
    },
    {
      "start": 10.1,
      "end": 11.6,
      "text": "Gerçekten çok bir şey istemiyoruz."
    },
    {
      "start": 12.12,
      "end": 14.24,
      "text": "Bir Umut ya, sadece bir Umut."
    },
    {
      "start": 32.79,
      "end": 33.87,
      "text": "Tek kuruşuna dokunmadım."
    },
    {
      "start": 35.05,
      "end": 36.29,
      "text": "Belli ki sen çok önemli bir hırsın."
    },
    {
      "start": 42.94,
      "end": 44.72,
      "text": "Bak, yalvarıyorum sana."
    },
    {
      "start": 45.44,
      "end": 47.44,
      "text": "Git, kimle konuşacaksan konuş."
    },
    {
      "start": 48.74,
      "end": 51.58,
      "text": "O doktor eğer gerçekten bir mucize yaratabiliyorsa..."
    },
    {
      "start": 51.58,
      "end": 54.6,
      "text": "...Umut'u da muayene edecek."
    },
    {
      "start": 55.12,
      "end": 56.08,
      "text": "Etmek zorunda."
    },
    {
      "start": 65.39,
      "end": 67.67,
      "text": "Ya mucizeler sadece sizin hakkınız değil ya."
    }
  ],
