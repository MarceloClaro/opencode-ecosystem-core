  "source_sha256": "be6dcb1fc3cbd19d3dfa9cd581368fad09475e70823f39bd6ce83d49e3e831ca",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.88,
      "end": 2.46,
      "text": "Ben de öyle tahmin etmiştim."
    },
    {
      "start": 5.84,
      "end": 7.0,
      "text": "Ne yapıyoruz biz Allah aşkına?"
    },
    {
      "start": 7.12,
      "end": 7.68,
      "text": "Biz de nedir?"
    },
    {
      "start": 9.46,
      "end": 11.08,
      "text": "Dün gece bu çocuk..."
    },
    {
      "start": 11.08,
      "end": 12.54,
      "text": "...oğlum çok kötü bir durumdaydı."
    },
    {
      "start": 14.04,
      "end": 14.9,
      "text": "Onu eve getirdi."
    },
    {
      "start": 15.94,
      "end": 16.94,
      "text": "Sağ salim olarak."
    },
    {
      "start": 17.42,
      "end": 18.78,
      "text": "Ve ben teşekkür bile etmedim."
    },
    {
      "start": 21.05,
      "end": 21.79,
      "text": "Sen ettin mi oğlum?"
    },
    {
      "start": 25.16,
      "end": 31.18,
      "text": "Çağla, Rüyam..."
    },
    {
      "start": 31.18,
      "end": 32.74,
      "text": "...etmediniz. Ben de etmedim."
    },
    {
      "start": 37.1,
      "end": 37.82,
      "text": "Ama..."
    },
    {
      "start": 37.82,
      "end": 38.96,
      "text": "...ama para teklif ettim."
    },
    {
      "start": 39.74,
      "end": 40.94,
      "text": "Rüyanımı rahatlatmak için."
    },
    {
      "start": 42.06,
      "end": 43.64,
      "text": "Çünkü bir an önce..."
    },
    {
      "start": 43.64,
      "end": 45.32,
      "text": "...verdiği hizmetin karşılığını verip..."
    },
    {
      "start": 45.32,
      "end": 46.92,
      "text": "...evimden göndermek derdindeydim."
    },
    {
      "start": 49.45,
      "end": 51.35,
      "text": "Çocuklarımı ondan uzak tutmak istedim."
    },
    {
      "start": 53.51,
      "end": 54.53,
      "text": "Tıpkı onun dediği gibi."
    },
    {
      "start": 55.35,
      "end": 57.27,
      "text": "Onu sokaklardan değil..."
    },
    {
      "start": 58.21,
      "end": 59.27,
      "text": "...kendimi..."
    },
    {
      "start": 60.35,
      "end": 61.31,
      "text": "...çocuklarımı..."
    },
    {
      "start": 61.31,
      "end": 62.45,
      "text": "...ondan korumak istedim."
    },
    {
      "start": 63.27,
      "end": 64.49,
      "text": "Oysa bize yardım etmişti."
    },
    {
      "start": 71.1,
      "end": 73.22,
      "text": "Bir gerçeği kabul etmek zorundayız galiba artık."
    },
    {
      "start": 75.1,
      "end": 82.62,
      "text": "Altyazı M.K."
    }
  ],
