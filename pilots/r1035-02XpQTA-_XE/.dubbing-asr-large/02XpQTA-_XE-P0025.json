  "language_probability": 1,
  "segments": [
    {
      "start": 12.02,
      "end": 14.26,
      "text": "Baktım bu dolap beygiri gibi dönüyor böyle."
    },
    {
      "start": 14.68,
      "end": 17.68,
      "text": "Artık ne zıkkımın dibini içtiysem uçmuş zekalı."
    },
    {
      "start": 18.72,
      "end": 22.46,
      "text": "Bıraksaydın orada olduğu gibi bizim yamyamlar dondu da çekip alsalardı altından."
    },
    {
      "start": 22.58,
      "end": 24.82,
      "text": "Lan oğlum kızın aklı gitti zaten yazık."
    },
    {
      "start": 25.04,
      "end": 26.02,
      "text": "Ay aman ne yazık."
    },
    {
      "start": 26.32,
      "end": 28.98,
      "text": "Takar kafamı kadar pırlanta yapar mı ana unutur gider."
    },
    {
      "start": 29.44,
      "end": 31.22,
      "text": "Ayrıca çok dağın barışmışlardır bile."
    },
    {
      "start": 32.98,
      "end": 34.1,
      "text": "Orası onun bileceği iş."
    },
    {
      "start": 34.38,
      "end": 35.36,
      "text": "Yani bizlik bir şey yok."
    },
    {
      "start": 36.5,
      "end": 37.48,
      "text": "Baksanıza bana be."
    },
    {
      "start": 38.54,
      "end": 39.54,
      "text": "Nasıl yakıştı mı?"
    },
    {
      "start": 39.54,
      "end": 41.46,
      "text": "Oğlum benzedin mi o zengin bebelerine?"
    },
    {
      "start": 41.66,
      "end": 44.64,
      "text": "Çok iyi oldun özellikle çorapların cuk yani."
    },
    {
      "start": 44.8,
      "end": 45.76,
      "text": "Bundan sonra böyle devam."
    },
    {
      "start": 46.2,
      "end": 47.68,
      "text": "Kızım kim görecek bir çorabı ya?"
    },
    {
      "start": 47.68,
      "end": 47.88,
      "text": "Bir şey."
    },
    {
      "start": 48.24,
      "end": 52.0,
      "text": "Abi ayakkabılar benim olsun."
    },
    {
      "start": 52.24,
      "end": 54.6,
      "text": "Oğlum sen önce bir hayırlısıyla ayağının üstüne bas da."
    },
    {
      "start": 57.81,
      "end": 59.09,
      "text": "Ya sen nasıl konuşuyorsun ya?"
    },
    {
      "start": 59.45,
      "end": 61.27,
      "text": "Sen Allah Allah bir sus."
    },
    {
      "start": 61.37,
      "end": 63.53,
      "text": "Ne var ya ne yapacak ayağına süs diye mi giyecek?"
    },
    {
      "start": 64.07,
      "end": 66.51,
      "text": "Oğlum senin o dilini düğmeyip gırtlağına sokmak lazım ha."
    },
    {
      "start": 66.83,
      "end": 67.29,
      "text": "Ver lan şunu."
    },
    {
      "start": 68.63,
      "end": 68.81,
      "text": "Ver."
    },
    {
      "start": 70.01,
      "end": 70.37,
      "text": "Ver."
    },
    {
      "start": 70.37,
      "end": 70.75,
      "text": "Al."
    },
    {
      "start": 71.97,
      "end": 73.85,
      "text": "Güle güle giy tamam mı?"
    }
  ],
