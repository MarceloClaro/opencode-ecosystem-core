  "source_sha256": "75ecbf2d0b8770b8bc77cf55b8af1ef01e4d23d7c09ff09c3ab8d1952adfaf08",
  "model": "large-v3",
  "language": "tr",
  "language_probability": 1,
  "segments": [
    {
      "start": 0.02,
      "end": 2.34,
      "text": "Bakışları sanki şeymişim gibi."
    },
    {
      "start": 2.46,
      "end": 3.28,
      "text": "Yabani misin gibi?"
    },
    {
      "start": 3.8,
      "end": 7.31,
      "text": "Sen hep böyle misin?"
    },
    {
      "start": 8.15,
      "end": 9.79,
      "text": "Nasıl mıyım? Yabani misin?"
    },
    {
      "start": 10.63,
      "end": 13.39,
      "text": "Anlaşıldı. Sanırım sen bu kelimeyi daha yeni öğrendin."
    },
    {
      "start": 13.47,
      "end": 17.67,
      "text": "Böyle cümle içerisinde kullanarak pratik falan yapmaya çalışıyorsun ama..."
    },
    {
      "start": 17.67,
      "end": 21.77,
      "text": "İşte cümleler basit. Hep iki kelime. Biraz geliştirmen lazım."
    },
    {
      "start": 23.77,
      "end": 25.97,
      "text": "Öyle mi? Tamam."
    },
    {
      "start": 27.43,
      "end": 29.77,
      "text": "Bir yabani bir yabaniye gel beraber yabanileşelim demiş."
    },
    {
      "start": 29.77,
      "end": 33.39,
      "text": "Yabani yabanileştirip de mi saklasak yabanileştirmeyip de mi saklasak?"
    },
    {
      "start": 34.81,
      "end": 36.33,
      "text": "Kitapların hepsi senin değil mi?"
    },
    {
      "start": 37.97,
      "end": 42.9,
      "text": "Bizim. Benim diye bir şey yok bizim hayatımızda."
    },
    {
      "start": 43.86,
      "end": 46.02,
      "text": "Benim olan her şey bizim. Onların olandı."
    },
    {
      "start": 47.16,
      "end": 49.7,
      "text": "Ama onlar çok muyanladığın kadarıyla."
    },
    {
      "start": 59.31,
      "end": 61.15,
      "text": "Ben o gece için teşekkür ederim."
    },
    {
      "start": 64.29,
      "end": 65.43,
      "text": "Esas ben teşekkür ederim."
    },
    {
      "start": 67.7,
      "end": 68.18,
      "text": "Niçin?"
    },
    {
      "start": 70.24,
      "end": 70.82,
      "text": "Ceket için."
    }
  ],
