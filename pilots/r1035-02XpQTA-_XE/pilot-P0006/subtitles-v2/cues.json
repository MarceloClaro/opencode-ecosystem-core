  "alignment": "line_level_from_tts_manifest",
  "audio_bound": false,
  "cues": [
    {
      "speaker": "char_male_a",
      "start": 0.44,
      "end": 1.295,
      "text": "Inacreditável.",
      "words": [],
      "cps": 16.37
    },
    {
      "speaker": "char_cagla",
      "start": 8.33,
      "end": 10.068,
      "text": "Não faça isso.",
      "words": [],
      "cps": 8.06
    },
    {
      "speaker": "char_male_a",
      "start": 10.49,
      "end": 13.49,
      "text": "Não se estresse tanto, calma.",
      "words": [],
      "cps": 9.67
    },
    {
      "speaker": "char_male_a",
      "start": 13.51,
      "end": 17.63,
      "text": "Aprenda a se divertir; se não der, ao\nmenos demonstre.",
      "words": [],
      "cps": 13.11
    },
    {
      "speaker": "char_cagla",
      "start": 19.09,
      "end": 21.41,
      "text": "Você está me machucando.",
      "words": [],
      "cps": 10.34
    },
    {
      "speaker": "char_male_a",
      "start": 21.43,
      "end": 25.774,
      "text": "Çağla, vá se tratar. Você é insuportável.",
      "words": [],
      "cps": 9.44
    },
    {
      "speaker": "char_cagla",
      "start": 31.42,
      "end": 33.187,
      "text": "Rüya, como você está?",
      "words": [],
      "cps": 11.88
    },
    {
      "speaker": "char_ruya",
      "start": 33.38,
      "end": 34.36,
      "text": "Bem, e você?",
      "words": [],
      "cps": 12.24
    },
    {
      "speaker": "char_cagla",
      "start": 34.38,
      "end": 35.44,
      "text": "Bem. E aí?",
      "words": [],
      "cps": 9.43
    },
    {
      "speaker": "char_ruya",
      "start": 35.46,
      "end": 37.04,
      "text": "Está indo bem.",
      "words": [],
      "cps": 8.86
    },
    {
      "speaker": "char_cagla",
      "start": 37.06,
      "end": 37.82,
      "text": "E você?",
      "words": [],
      "cps": 9.21
    },
    {
      "speaker": "char_ruya",
      "start": 37.84,
      "end": 39.08,
      "text": "O mesmo.",
      "words": [],
      "cps": 6.45
    },
    {
      "speaker": "char_cagla",
      "start": 39.1,
      "end": 40.628,
      "text": "Rüya, vamos embora.",
      "words": [],
      "cps": 12.43
    },
    {
      "speaker": "char_ruya",
      "start": 42.22,
      "end": 42.695,
      "text": "Por quê?",
      "words": [],
      "cps": 16.84
    },
    {
      "speaker": "char_cagla",
      "start": 43.24,
      "end": 45.5,
      "text": "Por quê? Por quê? Por quê?",
      "words": [],
      "cps": 11.5
    },
    {
      "speaker": "char_ruya",
      "start": 45.52,
      "end": 48.13,
      "text": "Estou entediada. Vamos.",
      "words": [],
      "cps": 8.81
    },
    {
      "speaker": "char_cagla",
      "start": 49.5,
      "end": 52.459,
      "text": "Também cansei de você, amiga.",
      "words": [],
      "cps": 9.8
    },
    {
      "speaker": "char_mother",
      "start": 56.65,
      "end": 57.85,
      "text": "Alô, Çağla.",
      "words": [],
      "cps": 9.17
    },
    {
      "speaker": "char_mother",
      "start": 57.87,
      "end": 58.572,
      "text": "Por que não atende?",
      "words": [],
      "cps": 27.07
    },
    {
      "speaker": "char_mother",
      "start": 59.57,
      "end": 61.93,
      "text": "Ligo há horas, quase enlouqueci.",
      "words": [],
      "cps": 13.56
    },
    {
      "speaker": "char_cagla",
      "start": 61.95,
      "end": 63.995,
      "text": "Nada, mãe. Está tudo bem.",
      "words": [],
      "cps": 12.22
    },
    {
      "speaker": "char_mother",
      "start": 64.17,
      "end": 65.024,
      "text": "Alaz?",
      "words": [],
      "cps": 5.85
    },
    {
      "speaker": "char_cagla",
      "start": 65.29,
      "end": 68.117,
      "text": "Alaz está bem. De bom humor.",
      "words": [],
      "cps": 9.9
    },
    {
      "speaker": "char_mother",
      "start": 68.21,
      "end": 69.801,
      "text": "Sua voz está estranha.",
      "words": [],
      "cps": 13.83
    },
    {
      "speaker": "char_mother",
      "start": 70.05,
      "end": 70.673,
      "text": "Algo errado?",
      "words": [],
      "cps": 19.26
    },
    {
      "speaker": "char_cagla",
      "start": 71.13,
      "end": 74.44,
      "text": "Mãe, nada. Só estamos nos divertindo.",
      "words": [],
      "cps": 11.18
    }
  ],
