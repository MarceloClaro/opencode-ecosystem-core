  "audio_bound": false,
  "cues": [
    {
      "speaker": "char_male_a",
      "start": 0.44,
      "end": 2.497,
      "text": "Inacreditável.",
      "words": [],
      "cps": 6.81
    },
    {
      "speaker": "char_cagla",
      "start": 8.33,
      "end": 9.985,
      "text": "Não faça isso.",
      "words": [],
      "cps": 8.46
    },
    {
      "speaker": "char_male_a",
      "start": 10.49,
      "end": 12.181,
      "text": "Não se estresse tanto, fica calma.",
      "words": [],
      "cps": 20.11
    },
    {
      "speaker": "char_male_a",
      "start": 13.51,
      "end": 18.335,
      "text": "Aprenda a se divertir; se não der, ao menos\ndemonstre.",
      "words": [],
      "cps": 11.19
    },
    {
      "speaker": "char_cagla",
      "start": 19.09,
      "end": 21.41,
      "text": "Você está me machucando.",
      "words": [],
      "cps": 10.34
    },
    {
      "speaker": "char_male_a",
      "start": 21.43,
      "end": 24.978,
      "text": "Çağla, vá se tratar. Você é insuportável.",
      "words": [],
      "cps": 11.56
    },
    {
      "speaker": "char_cagla",
      "start": 31.42,
      "end": 33.36,
      "text": "Rüya, como você está?",
      "words": [],
      "cps": 10.82
    },
    {
      "speaker": "char_ruya",
      "start": 33.38,
      "end": 34.36,
      "text": "Bem, e você?",
      "words": [],
      "cps": 12.24
    },
    {
      "speaker": "char_cagla",
      "start": 34.38,
      "end": 35.035,
      "text": "Tudo bem.",
      "words": [],
      "cps": 13.74
    },
    {
      "speaker": "char_ruya",
      "start": 35.46,
      "end": 36.298,
      "text": "Está indo bem.",
      "words": [],
      "cps": 16.71
    },
    {
      "speaker": "char_cagla",
      "start": 37.06,
      "end": 37.671,
      "text": "E você?",
      "words": [],
      "cps": 11.46
    },
    {
      "speaker": "char_ruya",
      "start": 37.84,
      "end": 38.439,
      "text": "Igual.",
      "words": [],
      "cps": 10.02
    },
    {
      "speaker": "char_cagla",
      "start": 39.1,
      "end": 41.097,
      "text": "Rüya, vamos embora.",
      "words": [],
      "cps": 9.51
    },
    {
      "speaker": "char_ruya",
      "start": 42.22,
      "end": 42.995,
      "text": "Por quê?",
      "words": [],
      "cps": 10.32
    },
    {
      "speaker": "char_cagla",
      "start": 43.24,
      "end": 44.859,
      "text": "Por quê? Por quê?",
      "words": [],
      "cps": 10.5
    },
    {
      "speaker": "char_ruya",
      "start": 45.52,
      "end": 48.727,
      "text": "Estou entediada. Vamos.",
      "words": [],
      "cps": 7.17
    },
    {
      "speaker": "char_cagla",
      "start": 49.5,
      "end": 51.579,
      "text": "Também cansei de você, amiga.",
      "words": [],
      "cps": 13.95
    },
    {
      "speaker": "char_mother",
      "start": 56.65,
      "end": 59.338,
      "text": "Alô, Çağla? Por que não atende?",
      "words": [],
      "cps": 11.53
    },
    {
      "speaker": "char_mother",
      "start": 59.57,
      "end": 61.786,
      "text": "Horas ligando, quase enlouqueci.",
      "words": [],
      "cps": 14.44
    },
    {
      "speaker": "char_cagla",
      "start": 61.95,
      "end": 63.942,
      "text": "Não é nada, mãe. Está tudo bem.",
      "words": [],
      "cps": 15.56
    },
    {
      "speaker": "char_mother",
      "start": 64.17,
      "end": 64.843,
      "text": "Alaz?",
      "words": [],
      "cps": 7.43
    },
    {
      "speaker": "char_cagla",
      "start": 65.29,
      "end": 68.19,
      "text": "Alaz está bem. De bom humor.",
      "words": [],
      "cps": 9.66
    },
    {
      "speaker": "char_mother",
      "start": 68.21,
      "end": 69.91,
      "text": "Sua voz está estranha.",
      "words": [],
      "cps": 12.94
    },
    {
      "speaker": "char_mother",
      "start": 70.05,
      "end": 71.01,
      "text": "Aconteceu algo?",
      "words": [],
      "cps": 15.63
    },
    {
      "speaker": "char_cagla",
      "start": 71.13,
      "end": 74.44,
      "text": "Mãe, nada. A gente se diverte.",
      "words": [],
      "cps": 9.06
    }
  ],
