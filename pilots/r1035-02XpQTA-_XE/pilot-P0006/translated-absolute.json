  "units": [
    {
      "id": "U0001",
      "start": 373.96,
      "end": 374.88,
      "source_text": "İnanılmazsın ya.",
      "translated_text": "Você é incrível."
    },
    {
      "id": "U0002",
      "start": 381.85,
      "end": 383.03,
      "source_text": "Yapma böyle ya.",
      "translated_text": "Não faça assim."
    },
    {
      "id": "U0003",
      "start": 384.01,
      "end": 386.35,
      "source_text": "Kızım bir gelme ortam bir sakin ol.",
      "translated_text": "Minha filha, fique tranquila."
    },
    {
      "id": "U0004",
      "start": 387.03,
      "end": 390.93,
      "source_text": "Yani inanmıyor öğrense ne biraz beceremiyorsan da taklit et bari.",
      "translated_text": "Então, se você não acredita, aprenda o que você não consegue, imite."
    },
    {
      "id": "U0005",
      "start": 392.61,
      "end": 393.89,
      "source_text": "Canımı acıtıyorsun.",
      "translated_text": "Você está me machucando."
    },
    {
      "id": "U0006",
      "start": 394.95,
      "end": 398.07,
      "source_text": "Çağla git öte de ağla vallahi çekilmiyorsun ya.",
      "translated_text": "Vá com o tempo e não vai chorar com Deus."
    },
    {
      "id": "U0007",
      "start": 404.94,
      "end": 406.6,
      "source_text": "Rüya, ne haber nasılsın?",
      "translated_text": "Sonho, qual é a sua notícia?"
    },
    {
      "id": "U0008",
      "start": 406.9,
      "end": 407.76,
      "source_text": "İyiyim senden ne haber?",
      "translated_text": "Que notícia tenho de você?"
    },
    {
      "id": "U0009",
      "start": 407.9,
      "end": 408.74,
      "source_text": "İyiyim ben de nasıl gidiyor?",
      "translated_text": "Eu estou bem, e como eu vou?"
    },
    {
      "id": "U0010",
      "start": 408.98,
      "end": 410.06,
      "source_text": "Vallahi güzel gidiyor.",
      "translated_text": "Deus está indo bem."
    },
    {
      "id": "U0011",
      "start": 410.58,
      "end": 411.22,
      "source_text": "Sen nasıl gidiyor?",
      "translated_text": "Como você vai?"
    },
    {
      "id": "U0012",
      "start": 411.36,
      "end": 411.92,
      "source_text": "Olur ne olsa.",
      "translated_text": "Qualquer que seja."
    },
    {
      "id": "U0013",
      "start": 412.62,
      "end": 414.52,
      "source_text": "Rüya, alayım benim.",
      "translated_text": "Eu sonho, eu sonho."
    },
    {
      "id": "U0014",
      "start": 415.74,
      "end": 416.62,
      "source_text": "Sebeb kızım.",
      "translated_text": "A razão é minha filha."
    },
    {
      "id": "U0015",
      "start": 416.76,
      "end": 418.3,
      "source_text": "Sebeb, sebeb, sebeb.",
      "translated_text": "A razão, a razão e a razão."
    },
    {
      "id": "U0016",
      "start": 419.04,
      "end": 420.0,
      "source_text": "Sıkıldım hadi.",
      "translated_text": "Fiquei entediado."
    },
    {
      "id": "U0017",
      "start": 423.02,
      "end": 424.78,
      "source_text": "Ben de senden sıkıldım arkadaşım.",
      "translated_text": "Eu também estou cansado de você, amigo."
    },
    {
      "id": "U0018",
      "start": 430.17,
      "end": 431.39,
      "source_text": "Alo, Çağla.",
      "translated_text": "Olá o tempo."
    },
    {
      "id": "U0019",
      "start": 431.39,
      "end": 432.89,
      "source_text": "Niye telefondan bakmıyorsun?",
      "translated_text": "Por que você não olha pelo telefone?"
    },
    {
      "id": "U0020",
      "start": 433.09,
      "end": 434.69,
      "source_text": "Saatler de sizi arıyorum aklımı kaçıracağım.",
      "translated_text": "Estou procurando por horas e vou perder a mente."
    },
    {
      "id": "U0021",
      "start": 435.47,
      "end": 437.19,
      "source_text": "Yok bir şey anne her şey yolunda.",
      "translated_text": "Não há nada, mãe, tudo está bem."
    },
    {
      "id": "U0022",
      "start": 437.69,
      "end": 437.97,
      "source_text": "Alaz.",
      "translated_text": "O ALAZ."
    },
    {
      "id": "U0023",
      "start": 438.81,
      "end": 440.77,
      "source_text": "Alaz iyi, keyfik alet yerinde.",
      "translated_text": "O almoço é bom, no local da ferramenta kefik."
    },
    {
      "id": "U0024",
      "start": 441.73,
      "end": 443.09,
      "source_text": "Senin sesim tuhaf geliyor.",
      "translated_text": "Sua voz parece estranha."
    },
    {
      "id": "U0025",
      "start": 443.57,
      "end": 444.09,
      "source_text": "Bir şey mi oldu?",
      "translated_text": "Alguma coisa aconteceu?"
    },
    {
      "id": "U0026",
      "start": 444.65,
      "end": 447.31,
      "source_text": "Anne ne olabilir ki en fazla eğleniyoruz işte sadece.",
      "translated_text": "Mas o que é mais divertido, é o que é mais divertido."
    }
  ],
