{
  "name": "remotion-quantum-pilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "remotion render QuantumPilot out/remotion-pilot.mp4 --codec=h264",
    "render:intro": "remotion render Intro out/intro.mp4 --codec=h264",
    "render:outro": "remotion render Outro out/outro.mp4 --codec=h264",
    "render:slides": "remotion render SlideSequence out/slide-sequence.mp4 --codec=h264",
    "render:intro16": "remotion render DidacticIntro16 out/didactic-intro-16.mp4 --codec=h264",
    "render:intro9": "remotion render DidacticIntro9 out/didactic-intro-9.mp4 --codec=h264",
    "render:outro16": "remotion render DidacticOutro16 out/didactic-outro-16.mp4 --codec=h264",
    "render:outro9": "remotion render DidacticOutro9 out/didactic-outro-9.mp4 --codec=h264",
    "render:darkslides": "remotion render DarkSlideSequence out/slide-sequence-dark.mp4 --codec=h264",
    "render:middle16": "remotion render DidacticMiddle16 out/didactic-middle-16.mp4 --codec=h264",
    "render:middle9": "remotion render DidacticMiddle9 out/didactic-middle-9.mp4 --codec=h264"
  },
  "dependencies": {
    "@remotion/cli": "latest",
    "react": "latest",
    "react-dom": "latest",
    "remotion": "latest"
  }
}
